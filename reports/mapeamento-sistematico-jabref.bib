  month               = {April},
  note                = {Cited by: 0},
  pages               = {1-6},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Intell. Syst. Comput. Networks, ICISCN},
  abstract            = {Agricultural advisory systems in developing economies are constrained by multilingual diversity, limited digital literacy, unreliable information sources, and the absence of integrated market intelligence. To overcome these challenges, this paper proposes AgriVerse-AI, a multimodal intelligent agricultural decision-support framework that unifies multilingual speech processing, semantic document retrieval, transformerbased reasoning [20], and neural time-series forecasting [4] into a single deployable architecture. The system indexes 135 verified agricultural documents into 24,434 semantic embeddings using a 384-dimensional all-MiniLM-L6-v2 sentence-transformer representation [16], enabling document-grounded inference through a Retrieval-Augmented Generation (RAG) pipeline [2] integrated with the LLaMA-3-70B-8192 large language model [17]. A Whisper-large-v2 ASR module provides voice interaction across six Indian languages (Tamil, Hindi, English, Malayalam, Telugu, and Kannada). For predictive market intelligence, a two-layer LSTM network trained on three years of weekly APMC tomato price data achieves RMSE of Rs. 148.6/quintal and MAE of Rs. 112.3/quintal over a $\mathbf{3 0}$-day horizon, outperforming ARIMA baselines by 41 %. Evaluation on 120 real-world farmer queries yields Precision@ $5=0.88$, Recall@ $5=0.84$, WER $=8.7 \%$, and a hallucination reduction from 23% to 9%, confirming the practical viability of the proposed framework for rural agricultural advisory deployment.  © 2026 IEEE.},
  affiliations        = {Karpagam College Of Engineering, Dept. Of Artificial Intelligence And Data Science, Tamil Nadu, Coimbatore, India},
  author_keywords     = {LSTM Price Forecasting; Multilingual Speech Processing; Multimodal Decision Support; Precision Agriculture; Retrieval-Augmented Generation; Semantic Retrieval; Transformer-Based Language Models},
  doi                 = {10.1109/ICISCN67954.2026.11566598},
  isbn                = {979-833158871-7},
  journal             = {2026 2nd International Conference on Intelligent Systems and Computational Networks, ICISCN 2026},
  keywords            = {Agricultural economics; Agriculture; Artificial intelligence; Commerce; Computational linguistics; Information retrieval; Information retrieval systems; Natural language processing systems; Network layers; Search engines; Semantics; Smart agriculture; Speech communication; Speech processing; Decision supports; Language model; LSTM price forecasting; Multi-modal; Multilingual speech processing; Multimodal decision support; Precision Agriculture; Price forecasting; Retrieval-augmented generation; Semantic retrieval; Transformer-based language model; Decision support systems},
  language            = {English},
