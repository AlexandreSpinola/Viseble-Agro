@InProceedings{Julianto2026,
  author    = {Julianto, Eric and Ardiyansa, Safrizal Ardana and Alhusari, Dian},
  booktitle = {2026 International Conference on Smart Computing, IoT, and Machine Learning (SIML)},
  title     = {GA-Driven Recurrent Modeling for Indonesian Banking Stocks Forecasting: LSTM and Bi-LSTM with Explainable AI and Statistical Validation},
  year      = {2026},
  month     = {June},
  pages     = {1-6},
  abstract  = {This paper studies daily closing-price forecasting for major Indonesian banking stocks using recurrent sequence models, macroeconomic regressors, and statistical validation. The implemented ablation compares LSTM and BiLSTM under two feature settings (Without_Macro and With_Macro) and two optimization modes (default vs. budgeted tuning via Genetic Algorithm), resulting in eight experimental cases per bank. To improve rigor, we run repeated multi-seed evaluations (five seeds) across seven banks and report RMSE, MAE, MAPE, and MSE. We further apply Wilcoxon signed-rank and DM tests to verify whether performance gains are robust rather than stochastic artifacts. Empirically, BiLSTM-based configurations dominate most banks, with best-case RMSE improvements over the baseline ranging from 4.91% to 35.66% for six out of seven banks. DM-test results indicate significant forecast-error reduction in those banks, while Wilcoxon significance is limited by the small number of seeds. The study provides a reproducible benchmark and a statistically grounded foundation for testing whether macroeconomic feature engineering consistently improves forecasting.},
  doi       = {10.1109/SIML69834.2026.11621262},
  keywords  = {Modeling;Banking;Pricing;Forecasting;Bidirectional long short term memory;Long short term memory;Seeds (agriculture);Testing;Timing;Gallium;stock forecasting;LSTM;BiLSTM;macroeconomic features;genetic algorithm;Wilcoxon test;DM test},
}

