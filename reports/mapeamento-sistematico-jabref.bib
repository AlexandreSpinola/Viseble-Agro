@Conference{Jelassi2025,
  author              = {Jelassi, Zied and Hamdi, Haykel},
  booktitle           = {2025 IEEE Afro-Mediterranean Conference on Artificial Intelligence (AMCAI)},
  title               = {Forecast-Driven Portfolio Optimization: A Machine Learning GJR-GARCH-Copula Framework for High-Frequency Mean-CVaR Portfolios},
  year                = {2025},
  month               = {Oct},
  note                = {Cited by: 0},
  pages               = {1-8},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  volume              = {CFP25TZ1-ART},
  abbrev_source_title = {Proc. - IEEE Afro-Mediterr. Conf. Artif. Intell., AMCAI},
  abstract            = {This study proposes a comprehensive framework for high-frequency asset price prediction and portfolio optimization, integrating machine learning techniques with econometric models to enhance risk-adjusted returns. The study develops and compares forecasting models, including Long Short-Term Memory (LSTM) networks and Random Forests, for five assets: the S&P 500 index, Gold, Brent, the Bloomberg Commodity Index, and Bitcoin. The forecasts are coupled with volatility modeling via GJR-GARCH to account for asymmetric shocks and dependence structures estimated through Student-t copulas. These components are then integrated into a Mean-Conditional Value-at-Risk (CVaR) optimization framework, which generates portfolios tailored to varying risk appetites. The findings of the study demonstrate that forecasts enhanced by machine learning techniques significantly surpass those derived from historical data-based optimization, particularly in volatile regimes. This is evidenced by the superior risk-adjusted returns achieved by portfolios guided by LSTM and RF models. The findings of this study call into question traditional asset allocation paradigms, highlighting the critical role of dynamic dependence modeling and forward-looking volatility adjustments in modern portfolio management. © 2025 IEEE.},
  affiliations        = {Univ. Manouba, ESCT, LAREQUAD, Manouba, Tunisia},
  author_keywords     = {Copula; Machine Learning; Mean-CVaR; Portfolio Optimization; Price Forecasting},
  doi                 = {10.1109/AMCAI66110.2025.11474322},
  isbn                = {979-833150132-7},
  journal             = {Proceedings - 2025 2nd IEEE Afro-Mediterranean Conference on Artificial Intelligence, AMCAI 2025},
  keywords            = {Economic analysis; Electronic trading; Financial markets; Forecasting; Investments; Learning algorithms; Long short-term memory; Prediction models; Statistics; Value engineering; Conditional Value-at-Risk; Copula; High frequency HF; Machine learning techniques; Machine-learning; Mean-conditional value-at-risk; Portfolio optimization; Price forecasting; Risk-adjusted; Short term memory; Learning systems},
  language            = {English},
