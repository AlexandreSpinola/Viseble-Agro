  year                   = {2026},
  month                  = {July},
  note                   = {Cited by: 0},
  pages                  = {1-9},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {Proc. Int. Conf. Electron., Comput. Artif. Intell., ECAI},
  abstract               = {Ceylon cinnamon is one of Sri Lanka's most significant agricultural exports and plays a major role in the country's economy [1], [5], [6]. However, smallholder cinnamon farmers face challenges related to yield prediction, nutrient management, pest and disease identification, and market price uncertainty. This paper presents CinoGrow, an integrated mobile-based Decision Support System designed specifically for cinnamon cultivation. The system incorporates four machine learning modules: yield prediction using YOLOv5 [25] and XGBoost [21], nutrient deficiency detection using DINOv3-based image classification, pest and disease detection using a Roboflow object detection model, and price forecasting using ARIMA[22] time-series modeling. The system supports multilingual interfaces and provides limited offline functionality through edge-deployable models. Field evaluation with 90 farmers across Galle and Matara districts demonstrated a task completion rate of 93.3% and an average user satisfaction score of 4.4/5. Results indicate that CinoGrow can support improved decision-making and resource utilization in cinnamon farming environments. © 2026 IEEE.},
  affiliations           = {Sri Lanka Institute of Information Technology (SLIIT), Faculty of Computing, Malabe, Sri Lanka},
  author_keywords        = {Cinnamon Farming; Decision Support System; Machine Learning; Pest Detection; Precision Agriculture; Yield Prediction},
  correspondence_address = {N.G.U.D. Jayawardana; Sri Lanka Institute of Information Technology (SLIIT), Faculty of Computing, Malabe, Sri Lanka; email: udaridevindi@gmail.com},
  doi                    = {10.1109/ECAI69016.2026.11613746},
  groups                 = {Previsão + Otimização},
  isbn                   = {979-833155818-5},
  issn                   = {2688-0253},
  journal                = {Proceedings of the 18th International Conference on Electronics, Computers and Artificial Intelligence, ECAI 2026},
  keywords               = {Agricultural economics; Agricultural machinery; Cultivation; Decision making; Information use; Learning systems; Machine learning; Nutrients; Pesticides; Precision agriculture; Agricultural exports; Cinnamon farming; Decision supports; Integrated machines; Machine-learning; Pest detection; Precision Agriculture; Sri Lanka; Support systems; Yield prediction; Decision support systems},
