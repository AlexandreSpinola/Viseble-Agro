@Conference{Aloka2026,
  author                 = {Aloka, A.M.R.V. and Jayalath, M.D.T.L. and Liyanage, S.S. and Mahadurage, R.N. and Krishara, Jenny and Dunuwila, Osuri},
  booktitle              = {2026 IEEE International Conference on Automatic Control and Intelligent Systems (I2CACIS)},
