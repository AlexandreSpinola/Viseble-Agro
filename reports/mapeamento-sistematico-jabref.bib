@Conference{Tan2024,
  author                 = {Tan, Zhizhong and Hu, Min and Liu, Bin and Yin, Guosheng},
  booktitle              = {2024 IEEE International Conference on Data Mining (ICDM)},
  title                  = {Futures Quantitative Investment With Heterogeneous Continual Graph Neural Network},
  year                   = {2024},
  editor                 = {Baralis E. and Zhang K. and Damiani E. and Debbah M. and Kalnis P. and Wu X.},
  month                  = {Dec},
  note                   = {Cited by: 3},
  pages                  = {851 - 856},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {Proc. IEEE Int. Conf. Data Min. ICDM},
  abstract               = {It is challenging to predict futures prices with traditional econometric models as it necessitates a comprehensive consideration of both historical observations and correlations among various futures. Spatial-temporal graph neural networks (STGNNs) offer a promising approach for modeling such complex spatio-temporal data. Nevertheless, the direct application of STGNNs to high-frequency futures data remains a challenge, as traders must account for both short- and long-term characteristics when making decisions. To capture these distinct timeframes, we leverage additional label information by devising four heterogeneous tasks: price regression, price gap regression, price moving average regression, and change-point detection. To make full use of these labels, we train the model in a continual manner. Traditional continual GNNs define the gradient of losses as parameter importance to overcome the catastrophic forgetting (CF) issue, while this is unsuitable for our heterogeneous tasks with losses in distinct spaces. Therefore, we propose to calculate the parameter importance with mutual information between the original observations and the extracted features. The empirical results based on 49 varieties of commodity futures demonstrate that our model achieves superior performance compared to the leading approaches, highlighting the effectiveness of our approach in modeling the intricate dynamics of the futures market. © 2024 IEEE.},
  affiliations           = {School of Computer Science and Engineering, Macau University of Science and Technolog, China; School of Finance, Southwestern University of Finance and Economics, China; Center of Statistical Research, School of Statistics, Southwestern University of Finance and Economics, China; School of Computing and Data Science, The University of Hong Kong, Hong Kong, Hong Kong},
  author_keywords        = {continual learning; futures price forecasting; graph neural network; spatio-temporal data},
  correspondence_address = {B. Liu; Center of Statistical Research, School of Statistics, Southwestern University of Finance and Economics, China; email: liubin@swufe.edu.cn},
  doi                    = {10.1109/ICDM59182.2024.00104},
  isbn                   = {979-833150668-1},
  issn                   = {23748486},
  journal                = {Proceedings - IEEE International Conference on Data Mining, ICDM},
  keywords               = {Inflation; Neural network models; Continual learning; Econometric modelling; Future price forecasting; Graph neural networks; High frequency HF; Historical observation; Price forecasting; Spatial temporals; Spatio-temporal data; Temporal graphs; Graph neural networks},
  language               = {English},
  publication_stage      = {Final},
  source                 = {Scopus},
  type                   = {Conference paper},
  url                    = {https://www.scopus.com/pages/publications/86000211886?origin=resultslist},
}

@Conference{Dhanasekaran2021,
  author              = {Dhanasekaran, K. and Ramprasath, M. and Sathiyamoorthi, V. and Poornima, N. and Jayaraj, Irrai Anbu},
  booktitle           = {2021 5th International Conference on Electronics, Communication and Aerospace Technology (ICECA)},
  title               = {Meta-Learning Based Adaptive Crop Price Prediction for Agriculture Application},
  year                = {2021},
  month               = {Dec},
  note                = {Cited by: 12},
  pages               = {396 - 402},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Proc. Int. Conf. Electron., Commun. Aerosp. Technol., ICECA},
  abstract            = {Dealing with unexpected changes in agricultural product prices that affect the farmers and the economic growth of a country is inevitable in the current day context. A unique approach is proposed for time-series prediction, which utilizes the power of crop price prediction and crop yield prediction of select crops to identify the relevant information with respect to the market prices, and crop yields. Many uncertain conditions such as climate changes, fluctuations in market, flooding, etc., cause problems to the agricultural process. In this work, the prices of selected essential crops analyzed for time-series prediction using meta-learning. The Self-Organized Map (S OM), LSTM (Long-Short Term Model), and this proposed Meta-Learning Based Adaptive Crop Price Prediction (MLACPP) was trained using crop price dataset, and crop yield dataset. Meta-learning function used in the approach utilizes the input, optimization-output, and task-related estimators for calculating meta-loss over multiple meta-network. The meta-learning with self-organizing capability learns a meta-network observing additional information from specialized support set. Moreover, this method deals with a task-oriented loss. Interestingly, it compares the current optimal-output of the optimization function g with the target-specific information. Experimental results show significant improvement in terms of prediction accuracy and cross-correlation entropy over the existing crop price prediction approaches. This research work provides the basis for making better decisions for price-fixing and crop yield maximization based on insights obtained from the dataset.  © 2021 IEEE.},
  affiliations        = {SRM Institute of Science and Technology, School of Computing, Faculty of Engineering and Technology, Department of Data Science and Business Systems, TN, Chennai, Chengalpattu, 603 203, India; Sona College of Technology, TN, Salem, India; CSL Australia Pty Ltd, Australia},
  author_keywords     = {Agriculture; Crop Price Prediction; Crop Yield Prediction; Deep Learning; Time-Series Prediction},
  doi                 = {10.1109/ICECA52323.2021.9675891},
  groups              = {Previsão + Otimização},
  isbn                = {978-166543524-6},
  journal             = {Proceedings of the 5th International Conference on Electronics, Communication and Aerospace Technology, ICECA 2021},
  keywords            = {Agricultural products; Climate change; Commerce; Costs; Forecasting; Long short-term memory; Time series; 'current; Agriculture applications; Crop price prediction; Crop yield; Crop yield prediction; Deep learning; Metalearning; Price prediction; Time series prediction; Yield prediction; Crops},
