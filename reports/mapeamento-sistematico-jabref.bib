@Conference{Divithotawela2025,
  author                 = {Divithotawela, A.M.D.D. and Udukumburage, Pathum},
  booktitle              = {2025 International Conference on Advances in Technology and Computing (ICATC)},
  title                  = {Random Forest Regression Approach for Balancing Vegetable Production and Price Forecasting in Sri Lanka},
  year                   = {2025},
  month                  = {Dec},
  note                   = {Cited by: 0},
  pages                  = {1-7},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {Int. Conf. Adv. Technol. Comput., ICATC},
  abstract               = {Sri Lanka's agriculture sector, a pillar of the national economy, is extremely vulnerable to price volatility in essential crops such as potatoes, particularly in major production and trading hubs like Welimada, Bandarawela, and Nuwara Eliya. This research project addresses this critical issue by developing a supervised machine learning framework that leverages Random Forest regression to forecast wholesale potato prices, integrating market-specific prices, climatic indicators, rainfall, and inflation to model complex non-linear interactions. The methodology involved comprehensive data preprocessing, meticulous hyperparameter tuning, and rigorous five-fold cross-validation, ensuring resilient generalization despite a limited historical data window. Model evaluation yielded strong results: R2 values were 0.470 for Welimada, 0.701 for Bandarawela, and 0.807 for Nuwara Eliya, with corresponding RMSE values of 35.87, 25.24, and 21.30, respectively. The entire workflow, from data ingestion, model training, and result analysis to application deployment, was implemented using Python's data science stack and presented via a Streamlit web application for real-time access. Unique to this project, the application not only forecasts prices but also provides market analytics tailored to stakeholders, including revenue estimation and oversupply risk detection per region, empowering informed decisions for farmers, traders, and policymakers. By offering transparent, actionable, and context-aware price insights, the system alleviates uncertainty, enhances market participation, and ultimately supports greater stability and sustainability in Sri Lankan agriculture. This solution, designed to be extensible, paves the way for broader crop integration, real-time analytics, and further reinforcement of food system resilience in the future. © 2025 IEEE.},
  affiliations           = {Faculty of Computing and Technology, Department of Computer Systems Engineering, Kelaniya, Sri Lanka},
  author_keywords        = {Agricultural Decision Support; Machine Learning; Price Forecasting; Random Forest Regression; Wholesale Vegetable Market},
  correspondence_address = {A.M.D.D. Divithotawela; Faculty of Computing and Technology, Department of Computer Systems Engineering, Kelaniya, Sri Lanka; email: damithdiv07@gmail.com},
