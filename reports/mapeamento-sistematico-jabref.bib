@InProceedings{Kumar2023a,
  author    = {Kumar, Chanugomula Shiva and Ponnala, Ramesh},
  booktitle = {2023 International Conference on Advances in Computation, Communication and Information Technology (ICAICCIT)},
  title     = {Leveraging Machine Learning Techniques to Estimate Airline Ticket Pricing},
  year      = {2023},
  month     = {Nov},
  pages     = {269-274},
  abstract  = {Frequent travelers often have the ability to predict the optimal time to purchase airline tickets in order to secure the best price. In order to maximize revenue, airlines frequently adjust their ticket pricing, which may result in higher prices during periods of high demand. To determine the airfare for a given route, data was collected over a specific period of time, which included various parameters such as flight schedules, airlines, and other relevant factors. Machine learning models were then employed to extract useful features from this data. Understanding the drivers of airfare price fluctuations is crucial in developing a mechanism that assists consumers and revenue management systems in making informed decisions about ticket purchases, considering the influence of various distinct factors on the cost of a plane ticket. The study aims to identify these key factors and their connection to price changes. By incorporating various powerful machine learning techniques such as Random Forest Regressor, Decision Tree Regressor, Linear Regression, and KNeighbors Regressor, Extra Trees Regressor, Bagging Regressor, this study aims to build a highly reliable and accurate flight fare prediction model that can efficiently handle diverse types of data, thus contributing to the advancement of more efficient and dependable airline ticket pricing systems.},
  doi       = {10.1109/ICAICCIT60255.2023.10465724},
  keywords  = {Schedules;Atmospheric modeling;Linear regression;Pricing;Predictive models;Feature extraction;Data models;Airline Fare;Machine Learning;Flight Price Prediction;Regressor’s},
}

@InProceedings{Ram2026,
  author    = {Ram, Valluri Keerthi and Rao, Kamma Ajay Nageswara and Abhay, Gokavarapu and Venkatesh, B. and R, Rashmi M. and Meera, K. N.},
  booktitle = {2026 International Conference on Computing Theory and Wireless Communications (ICCTWC)},
  title     = {Crypto Trading Platform Using Probability for Scalping and Compounding},
  year      = {2026},
  month     = {April},
  pages     = {1-7},
  abstract  = {In extremely volatile cryptocurrency exchanges, particularly with new tokens, conventional machine learning models tend to fail because of scarce historical data. Our proposed project is a probability-based crypto trading platform designed specifically for scalping and compounding strategies. Our system does not ignore platform fees, GST, and TDS like conventional models, providing a tax-aware and data-effective solution. The site takes advantage of statistical processes such as Chebyshev's Theorem, Bayesian Analysis, Monte Carlo Simulation, Stationarity Testing, and Random Walk Prediction via Geometric Brownian Motion (GBM). Light machine learning models augment these methods wherever possible. Users have the ability to choose time ranges (1 hour to 6 months), observe candlestickstyle charts, and be provided with predictive feedback on best buy/sell times. Through simulation of local minima and maxima paths and the use of probabilistic ensemble methods, the system suggests trades that maximize after-tax returns and provides a dynamic risk meter to inform user choice.},
  doi       = {10.1109/ICCTWC68241.2026.11583560},
  keywords  = {International trade;Modeling;Pricing;Machine learning;Cryptocurrency;Timing;Finance;Machining;Scalp;Optimization;Scalping;Compounding;Crypto Trading;Volatility;Probabilistic Models;Chebyshev Theorem;Monte Carlo Simulation;Geometric Brownian Motion (GBM);Bayesian Analysis;ARIMA;Local Minima and Maxima Prediction},
}

@InProceedings{Huang2008,
  author    = {Huang, Haoming and Pasquier, Michel and Chai Quek},
  booktitle = {2008 IEEE Congress on Evolutionary Computation (IEEE World Congress on Computational Intelligence)},
  title     = {Application of a hierarchical coevolutionary fuzzy system for financial prediction and trading},
  year      = {2008},
  month     = {June},
  pages     = {1252-1259},
  abstract  = {In this paper, the application of a hierarchical coevolutionary fuzzy system called HiCEFS for predicting financial time series is investigated. A novel financial trading system using the HiCEFS as a predictive model and employing a prudent trading strategy based on the price percentage oscillator (PPO) is proposed. In order to construct an accurate predictive model, a form of generic membership function named Irregular Shaped Membership Function (ISMF) is employed and a hierarchical coevolutionary genetic algorithm (HCGA) is adopted to automatically derive the ISMFs for each input variable in HiCEFS. With the accurate prediction from HiCEFS and a prudent trading strategy, the proposed financial trading system outperforms the simple buy-and-hold strategy, the trading system without prediction and the trading system with other predictive models (EFuNN, DENFIS and RSPOP) on real-world financial data.},
  doi       = {10.1109/CEC.2008.4630957},
  keywords  = {Evolutionary computation},
}

@Article{Lai2020,
  author   = {Lai, Zhao-Rong and Yang, Pei-Yi and Fang, Liangda and Wu, Xiaotian},
  journal  = {IEEE Transactions on Systems, Man, and Cybernetics: Systems},
  title    = {Reweighted Price Relative Tracking System for Automatic Portfolio Optimization},
  year     = {2020},
  issn     = {2168-2232},
  month    = {Nov},
  number   = {11},
  pages    = {4349-4361},
  volume   = {50},
  abstract = {In this paper, we propose a novel reweighted price relative tracking (RPRT) system for automatic portfolio optimization (APO). In the price prediction stage, it automatically assigns separate weights to the price relative predictions according to each asset's performance, and these weights will also be automatically updated. In the portfolio optimizing stage, a novel tracking system with a generalized increasing factor is proposed to maximize the future wealth of next period. Besides, an efficient algorithm is designed to solve the portfolio optimization objective, which is applicable to large-scale and time-limited situations. Extensive experiments on six benchmark datasets from real financial markets with diverse assets and different time spans are conducted. RPRT outperforms other state-of-the-art systems in cumulative wealth, mean excess return, annual percentage yield, and some typical risk metrics. Moreover, it can withstand considerable transaction costs and runs fast. It indicates that RPRT is an effective and efficient APO system.},
  doi      = {10.1109/TSMC.2018.2852651},
  keywords = {Portfolios;Optimization;Investment;Information science;Robustness;Machine learning;Cybernetics;Automatic portfolio optimization (APO);generalized increasing factor;reweighted price relative (RPR);tracking system},
}

@InProceedings{Govindasamy2024,
  author    = {Govindasamy, Chinnaraj and Dayana, T.R Nisha and Adkar, Siddhika Dilip and Prakash, D. Shyam and Gupta, A. Shilpa and Trivedi, Sanjeev Kumar},
  booktitle = {2024 International Conference on Intelligent Systems for Cybersecurity (ISCS)},
  title     = {Intelligent Energy Management Energy Storage Systems Using Machine Learning},
  year      = {2024},
  month     = {May},
  pages     = {1-5},
  abstract  = {A nevertheless-emerging generation called cloud computing permits customers to pay for services on a usage-based foundation. Internet-primarily based IT offerings are supplied through cloud computing, at the same time as virtualization enables the availability of PC sources. The muse of cloud computing is the information center, which is made up of networked computers, cables, electricity components, and different components that host and shop corporate records. With cloud facts centers, high overall performance has continually been the most critical concern, yet it compromises strength utilization. The key hassle is to lessen power consumption at the same time as preserving provider nice and performance a good way to stability device performance and strength intake. A detailed grasp of strength use styles within the cloud environment is needed for our suggested technique. We look at power consumption tendencies and reveal how, through the use of the right optimization standards based on our strength intake models, we can keep more strength in cloud records facilities. All through the prediction section, tablet optimization, which has a 97 percent accuracy rate, permits this era to provide extra correct future price forecasts.},
  doi       = {10.1109/ISCS61804.2024.10581115},
  keywords  = {Performance evaluation;Cloud computing;Power demand;Electricity;Stability criteria;Machine learning;Load management;Cloud computing;Machine Learning;Physical Machine;Power consumption prediction;Virtual Machine},
}

@Article{Patel2024,
  author   = {Patel, Manali and Jariwala, Krupa and Chattopadhyay, Chiranjoy},
  journal  = {IEEE Transactions on Artificial Intelligence},
  title    = {A Hybrid Relational Approach Toward Stock Price Prediction and Profitability},
  year     = {2024},
  issn     = {2691-4581},
  month    = {Nov},
  number   = {11},
  pages    = {5844-5854},
  volume   = {5},
  abstract = {An accurate estimation of future stock prices can help investors maximize their profits. The current advancements in the area of artificial intelligence (AI) have proven prevalent in the financial sector. Besides, stock market prediction is difficult owing to the considerable volatility and unpredictability induced by numerous factors. Recent approaches have considered fundamental, technical, or macroeconomic variables to find hidden complex patterns in financial data. At the macro level, there exists a spillover effect between stock pairs that can explain the variance present in the data and boost the prediction performance. To address this interconnectedness defined by intrasector stocks, we propose a hybrid relational approach to predict the future price of stocks in the American, Indian, and Korean economies. We collected market data of large-, mid-, and small-capitalization peer companies in the same industry as the target firm, considering them as relational features. To ensure efficient feature selection, we have utilized a data-driven approach, i.e., random forest feature permutation (RF2P), to remove noise and instability. A hybrid prediction module consisting of temporal convolution and linear model (TCLM) is proposed that considers irregularities and linear trend components of the financial data. We found that RF2P-TCLM gave the superior performance. To demonstrate the real-world applicability of our approach in terms of profitability, we created a trading method based on the predicted results. This technique generates a higher profit than the existing approaches.},
  doi      = {10.1109/TAI.2024.3408129},
  keywords = {Predictive models;Data models;Stock markets;Long short term memory;Feature extraction;Indexes;Bidirectional long short term memory;Feature optimization;hybrid model;relational modeling;stock prediction;trading strategy},
}

@InProceedings{Holland2008,
  author    = {Holland, Alan},
  booktitle = {2008 20th IEEE International Conference on Tools with Artificial Intelligence},
  title     = {A Decision Support Tool for Energy Storage Optimization},
  year      = {2008},
  month     = {Nov},
  pages     = {299-306},
  volume    = {2},
  abstract  = {We examine the problem faced by owners of gas storage contracts of how to manage the injection/withdrawal schedule of natural gas, given historical price behavior and a predictive model of future prices. We describe a hybrid price prediction model that combines a support vector machine technique with a stochastic model for short and long-term gas prices, respectively. We present a theoretical result regarding the complexity of the scheduling problem and propose a formulation for an integer program given capacity, injectability and deliverability constraints. We also outline how this was incorporated in a decision support tool that is used by energy traders at a gas utility company.},
  doi       = {10.1109/ICTAI.2008.66},
  issn      = {2375-0197},
  keywords  = {Energy storage;Predictive models;Weather forecasting;Natural gas;Stochastic processes;Contracts;Processor scheduling;Reservoirs;Ocean temperature;Buffer storage;machine learning;stochastic modelling;gas storage},
}

@InProceedings{S2025,
  author    = {S, Yuvaraj. and J, Chenni Kumaran. and K, Kajendran.},
  booktitle = {2025 International Conference on Intelligent Systems and Computational Networks (ICISCN)},
  title     = {Integrating ARIMA with Simple Moving Averages for Predictive Stock Price Modeling},
  year      = {2025},
  month     = {Jan},
  pages     = {1-6},
  abstract  = {Forecasting stock prices is crucial because even minor incremental improvements translate into significant advantages in their financial decisions. A novel method that combines ARIMA Models with Simple Moving Averages (SMAs)is proposed to enhance prediction accuracy. SMAs for 5 and 10 days were adopted as exogenous variables in the ARIMA structure, achieving a phenomenal accuracy of 99 percent. The performance of the model was analyzed using statistical measures such as the Mean Squared Error (MSE), Root Mean Squared Error (RMSE), Mean Absolute Error (MAE), and R-squared (R2). The prediction is reaffirmed as valid by obtaining lower RMSE values while concurrently having high R2 scores. Graphical tools include the plot of the scatter plot, the plot of residuals, and the histogram of error distribution for examining model efficiency. This joint ARIMA-SMA modeling approach is highly effective and potentially a powerful tool for financial analysts and decision-makers: predicting stock prices with 99% accuracy might well represent a new horizon toward which researchers can steer predictive modeling in stock market analysis.},
  doi       = {10.1109/ICISCN64258.2025.10934450},
  keywords  = {Analytical models;Histograms;Accuracy;Computational modeling;Measurement uncertainty;Predictive models;Forecasting;Stock markets;Intelligent systems;ARIMA;simple moving averages;stock price forecasting;predictive modeling;forecast accuracy;financial markets},
}

@InProceedings{Shynkevich2014,
  author    = {Shynkevich, Yauheniya and McGinnity, T. M. and Coleman, Sonya and Li, Yuhua and Belatreche, Ammar},
  booktitle = {2014 IEEE Conference on Computational Intelligence for Financial Engineering & Economics (CIFEr)},
  title     = {Forecasting stock price directional movements using technical indicators: Investigating window size effects on one-step-ahead forecasting},
  year      = {2014},
  month     = {March},
  pages     = {341-348},
  abstract  = {Accurate forecasting of directional changes in stock prices is important for algorithmic trading and investment management. Technical analysis has been successfully used in financial forecasting and recently researchers have explored the optimization of parameters for technical indicators. This study investigates the relationship between the window size used for calculating technical indicators and the accuracy of one-step-ahead (variable steps) forecasting. The directions of the future price movements are predicted using technical analysis and machine learning algorithms. Results show a correlation between window size and forecasting step size for the Support Vector Machines approach but not for the other approaches.},
  doi       = {10.1109/CIFEr.2014.6924093},
  issn      = {2380-8454},
  keywords  = {Forecasting;Support vector machines;Accuracy;Market research;Indexes;Time series analysis;Smoothing methods},
}

@InProceedings{Singh2023a,
  author    = {Singh, Harmanjeet and Malhotra, Manisha},
  booktitle = {2023 3rd International Conference on Technological Advancements in Computational Sciences (ICTACS)},
  title     = {A Novel Approach for Predict Stock Prices in Fusion of Investor's Sentiment and Stock Data},
  year      = {2023},
  month     = {Nov},
  pages     = {1163-1169},
  abstract  = {This study employs forecast stock market trends by integrating benchmark sentiment analysis and deep learning techniques. In periods of consistent growth within the stock market, technical analysis is the predominant method for making predictions. Technological prediction involves utilizing stock data obtained through web crawling from” EconomicTimes.com” This data is then used to predict a model, compared to the predictions generated by multiple other models. However, technological prophecy fails to align accurately with stock price trends during significant market volatility. Consequently, benchmark prediction emerges as the most reliable approach for forecasting. The utilization of benchmark prediction techniques enables the anticipation of stock market trends based on the dissemination of information by shareholders through social platforms, particularly in situations of urgency. The proposed approach for benchmark prediction involves extracting stock comments from a specified source and subsequently scrutinizing these comments to identify and filter out any instances of false news. Once the verification process has been conducted on the misinformation, the words that have been deemed to be accurate news undergo preprocessing. Once the authentic news comments have been transformed into textual segments, sentiment analysis is applied. The outcomes of the sentiment analysis are then utilized to generate indicators that reflect fluctuations in sentiment. Ultimately, the ascent and descent indicators are integrated with stock price data to construct a graphical representation, from which the forthcoming trajectory of stock prices is projected based on the curve's pattern. This paper addresses the limitation of the technical aspect in accurately predicting outcomes under exceptional circumstances and significantly enhances the accuracy of stock prediction in real-world scenarios.},
  doi       = {10.1109/ICTACS59847.2023.10389912},
  keywords  = {Deep learning;Industries;Sentiment analysis;Analytical models;Computational modeling;Predictive models;Benchmark testing;Forecast;Opinion Mining;Reliance Industries;Sentiment Analysis;Share Market},
}

@Article{Oprea2026,
  author   = {Oprea, Simona Vasilica and Bâra, Adela},
  journal  = {IEEE Access},
  title    = {How Are Trends in Explainable AI Redefining E-Commerce? From Opaque to Transparent Decisions Through Semantic Analysis},
  year     = {2026},
  issn     = {2169-3536},
  pages    = {31549-31566},
  volume   = {14},
  abstract = {Research interest in Explainable Artificial Intelligence (XAI) has surged since 2018, accelerating after 2020. Our research explores the role of XAI in e-commerce, emphasizing its ability to enhance transparency, interpretability and trust in AI-driven systems. To address the limited research on XAI in e-commerce, this paper conducts a bibliometric and semantic analysis of 8,845 publications from the Web of Science. It employs four advanced topic modeling techniques: Latent Dirichlet Allocation (LDA), BERT-LDA, BERT-Clustering and BERTopic. The research identifies XAI tools, popular XAI applications in e-commerce and emerging trends. The analysis also examines market type evolution and measures research momentum through the Compound Annual Growth Rate (CAGR). Keywords such as “Natural Language Processing”, “Neural Networks”, “Transformer Models” and “SHAP” exhibit the highest CAGR values, exceeding 80%. Using Hugging Face NER pipeline, we obtain that SHAP is the most frequently used tool with 2,182 mentions, followed by ICE, ALE and CEM. Extracting “market” from abstracts, the analysis reveals a significant shift in XAI research from traditional financial markets to emerging areas like energy, sustainability and environmental sciences. In e-commerce, fraud detection is the most prominent XAI application with nearly 40 mentions, followed by inventory management, price prediction, churn and demand forecasting with 15-20 mentions each. Topic 2 by BERTopic is closely related to e-commerce and focuses on the theme of recommender systems.},
  doi      = {10.1109/ACCESS.2026.3667555},
  keywords = {Explainable AI;Electronic commerce;Artificial intelligence;Bibliometrics;Biological system modeling;Market research;Systematic literature review;Smart agriculture;Optimization;Ethics;Compound annual growth rate;e-commerce;semantic;topic modeling;XAI},
}

@InProceedings{Shivalini2024,
  author    = {Shivalini, M. Satya and Gandra, Praveen Kumar and Alamuri, Suryanarayana and Gupta, Santoshi Sen and S, Prema},
  booktitle = {2024 4th International Conference on Innovative Sustainable Computational Technologies (CISCT)},
  title     = {Transforming Financial Market Prediction Through Generative AI-Powered Data Management},
  year      = {2024},
  month     = {Dec},
  pages     = {1-6},
  abstract  = {Predicting financial markets remains essential for decision-making in trading and investment. However, traditional models often fall short due to low-quality data, market volatility, and the complexity of global economic trends. Generative AI offers a transformative approach by improving data management processes, enhancing prediction accuracy, and overcoming the limitations of current forecasting models. This research explores the potential of Generative AI to enrich financial data through techniques like data augmentation, synthetic data generation, and anomaly detection. Specifically, the study investigates how integrating Generative AI into data preprocessing can enhance predictive modeling using Long Short-Term Memory (LSTM) networks for time series forecasting, particularly in stock prices. The research also explores feature engineering techniques such as moving averages, Relative Strength Index (RSI), and volatility metrics, which are crucial for capturing market trends. Generative Adversarial Networks (GANs) are employed to create additional realistic trading scenarios, boosting model robustness. Implemented using Python, the findings reveal that the combined LSTM and GAN model improved prediction accuracy over traditional methods, achieving an RMSE of 0.096 and R-squared ($\mathbf{R}^{\mathbf{2}}$) $\mathbf{0. 8 5}$ in stock price forecasts. The incorporation of synthetic data with traditional financial metrics leads to an improvement in the model's ability to predict short-term market trends. These findings suggest that the use of Generative AI can provide a more resilient and adaptive approach to financial market prediction, opening new avenues for research in the domain. Future research could focus on expanding the scope to include multi-market scenarios and incorporating real-time data streams.},
  doi       = {10.1109/CISCT62494.2024.11134255},
  keywords  = {Measurement;Generative AI;Biological system modeling;Predictive models;Market research;Generative adversarial networks;Data models;Forecasting;Long short term memory;Synthetic data;generative AI;financial market prediction;data augmentation;synthetic data;LSTM;GAN},
}

@InProceedings{Habbab2022,
  author    = {Habbab, Fatim Z. and Kampouridis, Michael},
  booktitle = {2022 IEEE Congress on Evolutionary Computation (CEC)},
  title     = {Optimizing Mixed-Asset Portfolios With Real Estate: Why Price Predictions?},
  year      = {2022},
  month     = {July},
  pages     = {1-8},
  abstract  = {The main purpose of portfolio optimization is to reduce the risk, and/or maximize the return of a group of investments. Most of the works that have been done on port-folio optimization are based on the Modern Portfolio Theory introduced by Markowitz in 1959. Some of them have employed price predictions to compute optimal asset weights. It has been demonstrated that using price predictions, instead of historical data, might improve portfolio performance under a risk-adjusted perspective. However, contributions in the field mainly focused on stocks, while little attention has been given on multi-asset portfolios including real estate. In this paper, we fill this gap by running a genetic algorithm on 456 portfolios to demonstrate the added value of including price predictions in our asset allocation problem. To investigate this, we compare the theoretical case of having a perfect foresight, where the predicted price $p_{t}$ is exactly the same as the expected price pt; under this case, the portfolio optimization task takes place in the test set (since we have assumed a perfect price prediction). We compare the results under perfect foresight with results derived from portfolio optimization that only took place in the training set, and the weights were then directly applied to the test set. Our goal is to demonstrate the theoretical advantages of using price predictions on mixed-asset portfolios that include real estate. Our results show that there can be significant improvements (up to 45 %) in sharpe ratio, rate of return, and risk, when using price predictions instead of a historical prices based portfolio.},
  doi       = {10.1109/CEC55065.2022.9870236},
  keywords  = {Training;Machine learning algorithms;Evolutionary computation;Resource management;Task analysis;Portfolios;Optimization;genetic algorithm;mixed-asset portfolio;perfect foresight;portfolio optimization;risk-adjusted return},
}

@InProceedings{Kavitha2025,
  author    = {Kavitha, K. and Sivapuram, Sirini and Tirumalasetty, Sai Vybhavi and Kummari, Vinod and Varada, Sai Nithin and Ravuri, Vinay},
  booktitle = {2025 6th International Conference on Inventive Research in Computing Applications (ICIRCA)},
  title     = {Stock Prices Using Arima and Sarima with Macroeconomic Indicators Predicting},
  year      = {2025},
  month     = {June},
  pages     = {1314-1319},
  abstract  = {Good financial decision-making depends on accurate stock price prediction; yet, market volatility driven by economics presents significant difficulties. Different macroeconomic factors including NASDAQ, S&P 500, Treasury Yield, USD/CNY currency pair can contribute to volatility in stock prices. To get beyond such erratic market conditions, investors require exact forecasting tools. The research uses ARIMA (AutoRegressive Integrated Moving Average) and SARIMA (Seasonal ARIMA) models using time series analysis to predict daily stock prices. The ability of ARIMA to recognize linear trends remains strong but SARIMA generates improved predictions because it integrates seasonal market fluctuations and cyclical patterns. External financial indicators incorporated into this approach enhance both short-term trend forecasting accuracy and provide investors actionable information for decision-making. Realworld financial data evaluation yielded improved performance from models which incorporated external macroeconomic indicators. A comparison between results showed that ARIMA performed successfully for short-term prediction whereas SARIMA didn't perform compared to ARIMA even it has demonstrate capability in seasonal variations detection. The research community continues to analyze computational complexity along with parameter optimization.},
  doi       = {10.1109/ICIRCA65293.2025.11089539},
  keywords  = {Analytical models;Accuracy;Biological system modeling;Computational modeling;Decision making;Time series analysis;Predictive models;Market research;Macroeconomics;Forecasting;Time Series Analysis;Market Volatility;Cyclical Patterns;Macroeconomic Indicators;Financial Decision-Making},
}

@Conference{Surenther2026,
  author              = {Surenther, I. and Sabhari Sriram, S. and Sasi Kumar, K. and Surya, M.},
  booktitle           = {2026 2nd International Conference on Intelligent Systems and Computational Networks (ICISCN)},
  title               = {AgriVerse-AI: End-to-End Multilingual Intelligent Assistant for Farmers},
