  booktitle = {2022 IEEE Conference on Telecommunications, Optics and Computer Science (TOCS)},
  title     = {Neural Network Simulation and LSTM-based Study of Expected Return},
  year      = {2022},
  month     = {Dec},
  pages     = {377-381},
  abstract  = {In order to make more accurate predictions about the gold and bitcoin markets so that investors can make the best decisions, we have designed an automated buy and sell trading model. With this model, investors can make buying and selling decisions based on price trends over a period of time, thus maximizing their returns. In this paper, we build a price prediction model based on LSTM network that can predict future prices based on prices over a period of time. The prediction results and confidence level of the network can provide accurate data for the following investment decisions. In this paper, we establish an investment decision model based on price prediction. A clear judgment of the price trend over a period of time in the future allocates the existing assets according to the level of increase or decrease. Our proposed model is capable of making price forecasts with high accuracy and maximizing investors' returns on the basis of the forecasts.},
  doi       = {10.1109/TOCS56154.2022.10016200},
  keywords  = {Training;Gold;Costs;Bitcoin;Predictive models;Feature extraction;Market research;LSTM network;price prediction;investment decision},
}

@InProceedings{LeNgoc2023,
  author    = {Le Ngoc, Thuan Nguyen and Lam, Dieu Tin and Hai Minh, Trang Nguyen and Doan, Thong Chanh and Nguyen, Nam Phuong and Nguyen, Hien Manh and Nguyen, Thanh Ngoc and Tran, Linh Duc and Tran, Nhat-Quang},
  booktitle = {2023 IEEE/ACIS 8th International Conference on Big Data, Cloud Computing, and Data Science (BCD)},
  title     = {Machine Learning for Agricultural Price Prediction: A Case of Coffee Commodity in Vietnam Market},
  year      = {2023},
  month     = {Dec},
  pages     = {38-41},
  abstract  = {Predicting agricultural commodity prices is crucial for farmers, governments, and related stakeholders to make important decisions about crop planning and food security. This is especially important in economies that rely greatly on agriculture, such as Vietnam and other developing countries, where the instability and inadequate predictability of agricultural commodity prices may lead to overproduction, "good season - devaluation" phenomenon, and significant economic losses. Aiming to address this issue, this paper presents the use of machine learning models to predict the price of coffee, a major agricultural commodity in Vietnam. Various machine learning techniques, namely LSTM (Long Short-Term Memory), ARIMA (Autoregressive Integrated Moving Average), SARIMA (Seasonal ARIMA), GRU (Gated Recurrent Unit), SVM (Support Vector Machine), and RF (Random Forest), are trained and evaluated using different data, including historical prices and additional data, such as fuel prices and weather data. The results of numerical experiments demonstrated that using additional data can significantly improve prediction performance.},
  doi       = {10.1109/BCD57833.2023.10466313},
  groups    = {Café, Previsão + Otimização},
  issn      = {2835-4419},
  keywords  = {Support vector machines;Radio frequency;Biological system modeling;Predictive models;Data models;Numerical models;Fuels;Price Prediction;ARIMA;SARIMA;LSTM;GRU;SVM;Random Forest},
}

@InProceedings{Thu2021,
  author    = {Thu, Huyen Giang Thi and Thanh, Thuy Nguyen and Quy, Tai Le},
  booktitle = {2021 IEEE International Conference on Big Data and Smart Computing (BigComp)},
  title     = {A Neighborhood Deep Neural Network Model using Sliding Window for Stock Price Prediction},
  year      = {2021},
  month     = {Jan},
  pages     = {69-74},
  abstract  = {Stock price prediction plays a crucial role in building a trading strategy for investors. The successful forecasting of stocks' future price will help the investors to increase their profit. However, it is difficult to predict exactly the trend of the stock market due to the complex relationship between stock prices and external factors such as news, global economy, public sentiments, and other sensitive financial information. Hence, historical prices are the main investigation data for researchers since collecting external factors is still a challenge. In this paper, we propose a novel method using the state-of-the-art deep neural network for time series prediction (long short-term memory - LSTM) along with deep concern in historical data of stocks and their nearest neighbors in terms of similarity. Experimental results on four active stocks in the United State and three stocks in the Vietnam stock market show that our model outperforms the competitive methods (vanilla LSTM, convolutional neural network - CNN, random forest, and linear regression).},
  doi       = {10.1109/BigComp51126.2021.00022},
  issn      = {2375-9356},
  keywords  = {Computational modeling;Neural networks;Time series analysis;Predictive models;Market research;Windows;Stock markets;deep neural network;LSTM;CNN;stock price prediction;nearest neighbors},
}

@InProceedings{Savadkoohian2025,
  author    = {Savadkoohian, Maryam and Javadian, Nikbakhsh},
  booktitle = {2025 11th International Conference on Signal Processing and Intelligent Systems (ICSPIS)},
  title     = {An Integrated Approach for Energy Price Forecasting and Optimal Portfolio Selection Using Artificial Neural Networks and Genetic Algorithm},
  year      = {2025},
  month     = {Dec},
  pages     = {264-271},
  abstract  = {Price volatility in competitive electricity markets makes optimal energy procurement a challenging task. This paper presents an integrated framework for energy price forecasting and optimal portfolio selection using multilayer artificial neural networks (ANNs) and a genetic algorithm (GA). Three separate ANNs are trained on ten years of normalized seasonal price data for power pools, energy exchanges, and bilateral contracts. The forecasting performance is evaluated using Mean Absolute Error (MAE) and Root Mean Squared Error (RMSE), where the model related to bilateral contracts demonstrates the highest accuracy. The predicted prices are then utilized as inputs for an optimization model consisting of twelve decision variables subject to practical constraints. A GA is applied to determine the optimal energy purchase portfolio. To validate the robustness of the proposed method, its performance is compared with that of the simulated annealing (SA) algorithm. The results show that the GA achieves better convergence behavior and provides a more cost-effective and stable portfolio. The findings confirm that the proposed ANN-GA framework is an effective decision-making tool for energy procurement under uncertainty.},
  doi       = {10.1109/ICSPIS68676.2025.11551656},
  keywords  = {Optimization;Pricing;Energy;Forecasting;Genetic algorithms;Modeling;Electricity;Power markets;Artificial neural networks;Portfolios;Artificial Neural Networks;Genetic Algorithm;Simulated Annealing;Energy Price Forecasting;Portfolio Optimization;Electricity Markets},
}

@InProceedings{KG2024,
  author    = {KG, Hitaish and KRISHNASWAMY, VANI and M, VISHNU and Mahima, B},
  booktitle = {2024 International Conference on Emerging Techniques in Computational Intelligence (ICETCI)},
  title     = {Navigating Financial Markets: Exploring Advanced Neural Networks for Stock Price Prediction},
  year      = {2024},
  month     = {Aug},
  pages     = {471-476},
  abstract  = {The stock market serves as a complex financial ecosystem, where diverse methodologies are employed to forecast price movements. This paper centers on the technical analysis of stock markets, exploring a range of models categorized into statistical, machine learning, and deep learning paradigms. Utilizing the Nifty BeES dataset, a pivotal ETF index fund in India, we conduct a comparative analysis of moving averages and LSTM models, evaluating their performance through metrics such as Mean Squared Error (MSE) and Mean Absolute Error (MAE). We then propose a Multilayer Perceptron (MLP) architecture which outperforms all other models in stock price prediction. Distinguished by its ability of time mixing and feature mixing attributes, the MLP demonstrates superior efficacy compared to conventional deep learning models. Looking ahead, we propose integrating sentiment analysis into our predictive framework to capture market sentiments and further enhance forecasting accuracy. This research underscores the significance of leveraging advanced methodologies to navigate the complexities of the stock market. By refining predictive models and incorporating market sentiments, we aim to equip investors with actionable insights for informed decision-making in dynamic financial landscapes.},
  doi       = {10.1109/ICETCI62771.2024.10704121},
  keywords  = {Deep learning;Analytical models;Sentiment analysis;Navigation;Biological system modeling;Refining;Neural networks;Predictive models;Multilayer perceptrons;Stock markets;stock market prediction;time series forecasting;neural network;multi-layer perceptron;Nifty Bees},
}

@InProceedings{A2025,
  author    = {A, Danieal and R, Infant Raj and Kumar, K. Vijaya},
  booktitle = {2025 Tenth International Conference on Science Technology Engineering and Mathematics (ICONSTEM)},
  title     = {Dynamic Price Intelligence System (DPIS): A Multi-Factor Regulator for Global Commodities and Products},
  year      = {2025},
  month     = {Nov},
  pages     = {1-9},
  abstract  = {This paper introduces the Dynamic Price Intelligence System (DPIS), a powerful web-based solution that is capable of eliminating the issue of price asymmetry, opaque valuation of business-to-business (B2B) and business-to-consumer (B2C) supply chains. One problem with sellers is that they also cannot set the best prices because they lack information on dynamic competition, brand equity and verifiable product quality grading. DPIS offers an online platform where sellers are free to list and price any product or commodity on their own and the buyer negotiates directly. It runs on a complex Hybrid Machine Learning (a combination of Convolutional Neural Network (CNN) and GraphSAGEbased Graph Neural Network (GNN), to blend together key non-temporal factors, including quality rating, brand value and place-based market sentiment, with conventional time-oriented data. Developed on React, Node.js, and MongoDB, DPIS provides real-time dynamic price adjustments, transactional and system security, and information-informed decision support to control revenues to their maximum level.},
  doi       = {10.1109/ICONSTEM65670.2025.11374630},
  issn      = {2996-2986},
  keywords  = {Accuracy;Weapons;Soft sensors;Supply chains;Machine learning;Graph neural networks;Real-time systems;Convolutional neural networks;System analysis and design;Standards},
}

@InProceedings{Chen2024,
  author    = {Chen, Fei and Wang, Zichen and Wang, Wenjun},
  booktitle = {2024 6th International Conference on Data-driven Optimization of Complex Systems (DOCS)},
  title     = {DFT-Triangle: A Novel Frequency Spectrogram Feature for Stock Price Prediction},
  year      = {2024},
  month     = {Aug},
  pages     = {543-550},
  abstract  = {Discrete Fourier Transform(DFT) was popular for extracting frequency feature from price series. However, it has been observed that two similar price series exhibit distinct features in the frequency domain, leading to confusion in time-frequency analysis and learning. Secondly, as common knowledge suggests, it is believed that more recent prices have a greater impact on future price predictions in the stock market. Inspired by these points, this study proposed a novel frequency-domain feature of price series called DFT-triangle, which functions as a novel spectrogram for transfer learning and stock forecasting. By stacking price series into 2-dimensional matrices with transferred frequency features, DFT-triangle is formed within a scale-frequency coordinate system, where scale refers to the size of sub-sequences generated from the current price backward to each of the previous ones, hence the name DFT-triangle. Experiments on entire 470 stocks were then carried out for evaluating the power of DFT-triangle in stock prediction, based on neural networks. It was noted that DFT-triangle with a single-layer CNN produced promising results in stock prediction, compared to advanced sequential networks like Attention-LSTM and CNN-LSTM, as well as traditional econometric predictors such as AR and ARIMA.},
  doi       = {10.1109/DOCS63458.2024.10704304},
  keywords  = {Time-frequency analysis;Transfer learning;Stacking;Neural networks;Feature extraction;Econometrics;Stock markets;Forecasting;Spectrogram;Optimization;stock price prediction;price series;time-series analysis;neural networks;Discrete Fourier Transformation},
}

@InProceedings{Zhang2011,
  author    = {Zhang, Jianhua and Yu, Changhai and Hou, Guolian},
  booktitle = {2011 Chinese Control and Decision Conference (CCDC)},
  title     = {Application of chaotic particle swarm optimization in the short-term electricity price forecasting},
  year      = {2011},
  month     = {May},
  pages     = {1071-1075},
  abstract  = {The market-oriented reform of the electric power industry is a trend around the world, electricity price issues are the key problems in the power markets and how to price the special commodity-electricity is essential for the smooth market operation. Accurate price forecasting provides crucial information for electricity market participants to make reasonable competing strategies, which is related to the position and benefit of the market participators. So using the relative historic data in predicting the future electricity price is a very meaningful work. With comprehensive considerations of the fluctuation rules and the various influencing factors on the forming of price in the power market, a short-term electricity price forecasting method based on the time series ARMAX model was chosen in this paper. Aimed to solve the problem with traditional method of parameter identification which is easy to fall into the local least values and has low identification precision, chaotic particle swarm optimization (CPSO) algorithm was proposed in this paper. Calculation example shows that this method can reflect the law of the development of the electricity price well and improve forecasting accuracy greatly.},
  doi       = {10.1109/CCDC.2011.5968343},
  issn      = {1948-9447},
  keywords  = {Forecasting;Electricity;Power systems;Predictive models;Autoregressive processes;Artificial neural networks;Load modeling;Short-term electricity price forecasting;ARMAX model;Chaotic particle swarm optimization algorithm},
}

@Article{Amiri2025,
  author   = {Amiri, Babak and Haddadi, Amirali and Farajpour Mojdehi, Kosar},
  journal  = {IEEE Access},
  title    = {A Novel Hybrid GCN-LSTM Algorithm for Energy Stock Price Prediction: Leveraging Temporal Dynamics and Inter-Stock Relationships},
  year     = {2025},
  issn     = {2169-3536},
  pages    = {24815-24832},
  volume   = {13},
  abstract = {Energy stock price prediction is a pivotal challenge in financial forecasting, characterized by high volatility and complexity influenced by geopolitical factors, regulatory shifts, and sector-specific issues. Traditional methods often struggle to account for the intricate dependencies and temporal patterns present in energy stock data. To address these limitations, this study introduces a hybrid model that integrates a Graph Convolutional Network (GCN) with an attention-enhanced Long Short-Term Memory (LSTM) architecture. By employing a graph structure derived from Dynamic Time Warping (DTW), the GCN captures inter-stock relationships, while the attention mechanism within the LSTM component refines the modelling of temporal dynamics, allowing the model to focus on the most relevant historical information. Experimental evaluations across multiple energy stocks show that this combined LSTMGC model significantly outperforms conventional approaches- including Linear Regression, GRU, MLP, and standalone LSTMs- when assessed using Mean Squared Error (MSE) and R-squared (R2) metrics. By jointly leveraging spatial and temporal dependencies, as well as the selective attention mechanism, the proposed framework enhances predictive accuracy and reliability, offering valuable insights for investors and policymakers navigating the evolving energy market.},
  doi      = {10.1109/ACCESS.2025.3536889},
  keywords = {Predictive models;Long short term memory;Analytical models;Accuracy;Forecasting;Data models;Machine learning;Time series analysis;Sentiment analysis;Deep learning;Stock price;energy;graph neural networks;long short-term memory;dynamic time warping;graph convolutional networks},
}

@InProceedings{Jain2025,
  author    = {Jain, Kashika and Jain, Panav},
  booktitle = {2025 3rd International Conference on Disruptive Technologies (ICDT)},
  title     = {Stock Price Forecasting Using LSTM Model},
  year      = {2025},
  month     = {March},
  pages     = {660-664},
  abstract  = {This research work incorporates historical data and various predictive models to forecast the future prices of stocks traded in financial markets based on factors such as market trends, company performance, economic indicators, and external events. This work introduces a new approach for the prediction of stock market using Long Short-Term Memory (LSTM) type of networks. It enhances the ability of model to recognize patterns and temporal connections in historical stock price data by incorporating multiple layers of LSTM units. The model can effectively learn both short-term and long-term dependencies, helping to adapt to the volatile nature of these financial markets. Rigorous experiments validate the efficacy of this stacked LSTM-based approach in predicting and understanding stock market trends. Once the models are trained and validated, it is used to make predictions on unseen or future data, generating forecasts of stock prices alongside measures of uncertainty or confidence intervals. The accuracy of the model has been increased to 98.2% using the proposed technique. Sentiment Analysis has been incorporated to include the effects of news articles etc. as positive, negative or neutral sentiment. In order to continue to explore the possibilities of machine learning in financial forecasting, our findings pave the way for further advancements in predictive modelling and risk management strategies.},
  doi       = {10.1109/ICDT63985.2025.10986696},
  keywords  = {Adaptation models;Sentiment analysis;Uncertainty;Measurement uncertainty;Predictive models;Market research;Data models;Forecasting;Stock markets;Long short term memory;Stock Price Prediction;LSTM (Long Short Term Memory);Financial Market;Sequential Data;Sentiment Analysis;Time Series Analysis;Predictive Modelling},
}

@Article{Long2023,
  author   = {Long, Jun and Li, Lue and Li, Zejun},
  journal  = {IEEE Access},
  title    = {A Combined Framework Based on Feature Selection and Multivariate Mixed-Frequency for Crude Oil Prices Point and Interval Forecasting},
  year     = {2023},
  issn     = {2169-3536},
  pages    = {144064-144083},
  volume   = {11},
  abstract = {Effective crude oil price forecasting is essential for energy supply stabilization, investment decisions, policy formulation, and economic impact assessment. However, previous studies of crude oil futures price forecasting either consider only a single variable without adequately accounting for the influence of various factors on crude oil prices, or they consider only the same frequency of influences and ignore the importance of mixed frequencies, resulting in forecasts that do not achieve the desired results. To overcome these problems, this paper proposes a new multivariate combinatorial mixed frequency forecasting system to predict the weekly closing price of crude oil futures. The system is divided into four modules: Data denoising, Feature selection, Combined forecasting, and Performance evaluation module. To obtain smooth data, ICEEMDAN is used to denoise the original data. Furthermore, to select appropriate variables and reduce model redundancy, recursive feature elimination is used to select appropriate variables with low frequency. Considering the importance of mixed-frequency data, the mutual information method was used to select appropriate high-frequency variables for modeling the crude oil price forecast model. To overcome the shortcomings of Back Propagation Neural Network, Gate Recurrent Unit, and Radial Basis Function Neural Network models, integrate their advantages, and obtain accurate and stable prediction results, a combined forecasting mechanism based on a Multi-Objective Sparrow Search algorithm was developed to obtain both point and interval forecasting results, and finally, two data sets were selected for empirical analysis. The results show that the mean absolute percentage errors of the point forecast of this model are 1.96% and 1.84%, respectively, about 31% and 15% higher than those of the competing models (mean absolute percentage errors 2.57% and 2.13%, respectively). For interval forecasting, the accumulated width deviation is 0.0037 and 0.002, respectively, about 35% and 25% higher than those of the competing models (accumulated width deviation 0.005 and 0.0025, respectively). Thus, the proposed forecasting framework outperforms all comparative models and can be used effectively for forecasting crude oil prices.},
  doi      = {10.1109/ACCESS.2023.3344162},
  keywords = {Forecasting;Predictive models;Feature extraction;Biological system modeling;Mutual information;Market research;Pricing;Pareto optimization;Oil refineries;Petroleum industry;Crude oil price;feature selection;interval forecasting;multi-objective sparrow search algorithm;multivariate mixed-frequency combinatorial forecasting framework},
}

@InProceedings{Mathur2023,
  author    = {Mathur, Aryan and Fulwala, Pujan and Lal, Shreya and Relan, Sonia},
  booktitle = {2023 Global Conference on Information Technologies and Communications (GCITC)},
  title     = {A Comparative Study of Machine Learning Approaches for Stock Price Forecasting},
  year      = {2023},
  month     = {Dec},
  pages     = {1-6},
  abstract  = {The stock market displays significant fluctuations, which are affected by numerous factors, including financial indicators, political events, environmental conditions, and a variety of internal and external forces. It has been a challenging endeavor, captivating the interest of both researchers and investors alike, due to its intricate and ever-changing nature. The objective of Stock Market Prediction is to forecast the future value of a company’s financial stocks. In contemporary times, a widely used method involves the application of machine learning techniques. These methods utilize current stock market indices and historical data for training to predict future values. Machine learning employs diverse models to enable precise and simplified predictions. Our study has overviewed the following methodologies which are - Neural Network, LSTM, SSA & SVR, SVM, Graph Construction, etc. After performing the comparative study, we identified LSTM (Long Short-Term Memory) as the most appropriate algorithm for stock value prediction, taking into account factors like open, close, low, high, and volume. The outcomes of this study contribute to the growing knowledge in the field of stock market prediction using machine learning algorithms. The LSTM-based method demonstrates significant potential in effectively predicting stock prices, empowering investors and financial analysts to make well-informed choices.},
  doi       = {10.1109/GCITC60406.2023.10426471},
  keywords  = {Support vector machines;Machine learning algorithms;Neural networks;Machine learning;Predictive models;Prediction algorithms;Stock markets;Machine Learning Techniques;Volatility;Stock Prediction;Sentiment Analysis},
}

@InProceedings{R2025,
  author    = {R, Anandhajothi Nalini and M, Ishwarya and D, Thamizhisai and G, Sriranganathan.},
  booktitle = {2025 4th International Conference on Automation, Computing and Renewable Systems (ICACRS)},
  title     = {Intelligent Deep Learning Framework for Real-Time Agricultural Price Prediction using NBEATS-X},
  year      = {2025},
  month     = {Dec},
  pages     = {1288-1293},
  abstract  = {Precise agricultural price prediction is important to delivering market stability, reducing the volatility of food supplies, and informing farmer, trader, and policy maker choices. Most current deep learning models like LSTM-based volatility models and transformer-based encoders lack real-time responsiveness because of computational overheads and expert tuning to highly non-stationary agricultural data. In order to tackle such a challenge, for this research, an Intelligent Deep Learning Framework for Real-Time Agricultural Price Forecasting using NBEATS-X is proposed, which is a state-of-the-art temporal forecasting model pre-trained on multivariate agricultural market data. The new framework is a stack-based, interpretable model that incorporates trend, seasonality, and generic components that can effectively extract short-term market trends and long-term cyclical patterns. A web-based interface facilitates live consumption of data, model training, and live price prediction through a Flask web API. The framework was tested with agricultural and vegetable commodity data gathered from different regional markets between 2010 and 2024 with standard forecasting metrics of RMSE, MAE, MAPE, and RMSPE. Results of experiments confirm that the suggested NBEATS-X model has 15–20% less RMSE and 12% less inference time than state-of-the-art models such as Transformer-CNN and Bi-LSTM. The system also offers explainability through decomposed trend and seasonality outputs to support decision-making for agricultural supply chain management through well-informed decisions. This work pushes NBEATS-X as a computer-efficient and precise real-time farming price prediction model, furthering the emerging field of smart Ag Tech systems and sustainable data-farming.},
  doi       = {10.1109/ICACRS67045.2025.11324187},
  groups    = {Previsão + Otimização},
  keywords  = {Deep learning;Analytical models;Computational modeling;Predictive models;Transformers;Market research;Real-time systems;Data models;Forecasting;Tuning;Agricultural Price Forecasting;NBEATS-X;Deep Learning;Time Series Prediction;Ag Tech;Real-Time Analysis;Transformer Model;LSTM;Market Intelligence;Sustainable Agriculture;Web-Based Prediction Framework;Commodity Price Modeling},
}

@InProceedings{R2025a,
  author    = {R, Kanchana and Fernandez, F. Mary Harin},
  booktitle = {2025 International Conference on Visual Analytics and Data Visualization (ICVADV)},
  title     = {Stock Price Prediction using LSTM with Toeplitz Matrix-Driven Feature Extraction for Enhanced Forecasting Accuracy},
  year      = {2025},
  month     = {March},
  pages     = {756-760},
  abstract  = {The research methodology studies the use of Long Short-Term Memory networks in predicting stock prices, with the case of Tata Motors' historical price data reporting. A unique aspect of this study is the introduction of a Toeplitz matrix to capture the sequential information present in the stock data, thus, the model can better identify time-dependent correlations. Data mining includes cleaning, normalizing, and restructuring the dataset for the best application of the LSTM model. The study divides the data into training and testing sets for the model to learn from the past and then make the price predictions. Overall performance evaluation exhibits how the model was able to follow intricate price movements and provide a concrete reality prediction of the future prices. In addition to that, results verifying the efficiency of LSTM networks in processing the non-linear and dynamic relationships of price stocks in the respective financial markets, which in turn provides confidence to explore further developments and improvements in prediction. This is demonstrating the capability of machine learning algorithms to be the most useful in economic analysis when novel and creative techniques are implemented that help to boost the precision of model forecasting even in uncertain market conditions.},
  doi       = {10.1109/ICVADV63329.2025.10960957},
  keywords  = {Machine learning algorithms;Correlation;Time series analysis;Predictive models;Motors;Data models;Data mining;Forecasting;Long short term memory;Optimization;Stock Price;Long Short-Term Memory (LSTM);Toeplitz Matrix;Time Dependent Correlation;Data Mining;Financial Markets;Machine Learning Algorithm;Economic Analysis},
}

