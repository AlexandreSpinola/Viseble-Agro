@ARTICLE{Shaheen2026,
	author = {Shaheen, F.A. and Gul, Aqib and Ganai, Nazir and Majid, Masroor and Rashid, Mudasir and Sultan, Abid},
	title = {Deep learning-enabled cherry price forecasting and real-time system deployment across multi-market supply chains in India},
	year = {2026},
	journal = {Scientific Reports},
	volume = {16},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-025-30980-9},
	url = {https://www.scopus.com/pages/publications/105027373447?origin=resultslist},
	affiliations = {Institute of Business and Policy Research, Sher-e-Kashmir University of Agricultural Sciences and Technology of Kashmir, J&K, Srinagar, 190025, India; Vice Chancellor, Sher-e-Kashmir University of Agricultural Sciences and Technology of Kashmir, J&K, Srinagar, 190025, India},
	abstract = {For high-value perishable goods such as cherries, accurate price forecasting is crucial for the supply chain, stabilizing producer income, informing policy interventions & real-time decision support at various stakeholder levels. This study enquires whether Deep Learning (DL) architectures can be implemented in real time for daily advisory tools while simultaneously surpassing conventional statistical and Machine Learning (ML) models in predicting cherry prices. To tackle this issue, daily cherry price data from five wholesale markets in India were utilized for the period 2012–2024 to evaluate six forecasting methodologies, i.e., Seasonal Auto-regressive Integrated Moving Average (SARIMA), Prophet, Random Forest (RF), Extreme Gradient Boosting (XGBoost), Long Short-Term Memory (LSTM), and Transformer. The results show that deep learning models are better at capturing non-linear price changes than statistical or tree-based methods. The LSTM and Transformer models consistently performed better across all error metrics (MAE, RMSE, sMAPE, MFE, NMBE, and DA). During the 2025 cherry season, the best-performing LSTM was used as a live, web-based forecasting system that accepted real-time submissions from market officials and produced daily predictions based on field conditions. After the season, we checked the actual prices against the forecasted values and found that they were correct with more than 92 per cent accuracy for market-variety-grade combinations. In major markets like Azadpur, Narwal, and Parimpora, the sMAPE was often below 5–10 per cent, and the error margins (MAE 5–8; RMSE 8–12) were low. Further, the Diebold–Mariano (DM) test showed that deep learning was statistically superior to the baselines. The current study presents a novel and comprehensive operational methodology for advanced Artificial Intelligence (AI) models in the agriculture & allied sectors of India, establishing a scalable framework for incorporating ML/DL into agricultural market intelligence and advisory systems. © The Author(s) 2025.},
	keywords = {Commerce; Deep Learning; Forecasting; India; Models, Economic; Prunus avium; article; artificial intelligence; benchmarking; cherry; controlled study; decision support system; deep learning; forecasting; human; intelligence; long short term memory network; machine learning; market; prediction; price; random forest; root mean squared error; supply chain; commercial phenomena; economic model; economics; forecasting; growth, development and aging; India; procedures; sweet cherry},
	correspondence_address = {F.A. Shaheen; Institute of Business and Policy Research, Sher-e-Kashmir University of Agricultural Sciences and Technology of Kashmir, Srinagar, J&K, 190025, India; email: fashaheen@yahoo.com; A. Gul; Institute of Business and Policy Research, Sher-e-Kashmir University of Agricultural Sciences and Technology of Kashmir, Srinagar, J&K, 190025, India; email: maaqib90@gmail.com},
	publisher = {Nature Research},
