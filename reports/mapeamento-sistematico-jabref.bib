  keywords  = {Industries;Data preprocessing;Predictive models;Data models;Information management;Stock markets;Forecasting;Tuning;Optimization;Investment;stock price;informer;transformer},
}

@InProceedings{Maheshwari2022,
  author    = {Maheshwari, Abhishek and Malhotra, Amit and Tuteja, Sumedha and Ranka, Monica and Basha, Md Shaik Amzad},
  booktitle = {2022 IEEE North Karnataka Subsection Flagship International Conference (NKCon)},
  title     = {Prediction of Stock Prices using Prophet Model with Hyperparameters tuning},
  year      = {2022},
  month     = {Nov},
  pages     = {1-5},
  abstract  = {As part of the data analytical process, predicting and time - series are crucial. In academics and financial research, anticipating share prices is a prominent and significant subject. A share market would be an uncontrolled environment for anticipating shares since there are no fundamental guidelines for evaluating or anticipating share prices there. As a result, forecasting share prices is a difficult time-series issue. fundamental, technical, time series predictions and analytical strategies are just a few of the various techniques and approaches that machine learning uses to execute stock value predictions. This article implements the stock price prediction, Researchers compared the model of the prophet with the tuned model of the prophet. By utilizing the tuning of hyperparameters using parameter grid search to improve the performance of the model accuracy for the best prediction. The findings of the study demonstrated that tuned model of the prophet with hyperparameters tuning which results in model accuracy and based on the experimental findings mean squared error (MSE) and mean absolute percentage error (MAPE) has significant improvement.},
  doi       = {10.1109/NKCon56289.2022.10126796},
  keywords  = {Time series analysis;Machine learning;Predictive models;Share prices;Forecasting;Tuning;Optimization;share prices;forecast;prophet model;time-series;hyperparameter tuning},
}

@InProceedings{Bouabidi2024,
  author    = {Bouabidi, Sanaa and Hanyn, Dounia and Salhi, Abderahim and Baslam, Mohamed},
  booktitle = {2024 10th International Conference on Optimization and Applications (ICOA)},
  title     = {Advanced Machine Learning Techniques for Predicting Precious Metal Prices in Financial Trading},
  year      = {2024},
  month     = {Oct},
  pages     = {1-6},
  abstract  = {In an environment as intricate as the financial markets, where fortunes can shift in an instant, the prices of gold, silver, and oil emerge as puzzles, their fluctuations shrouded in mystery. These precious commodities, valued for their intrinsic worth and myriad applications, have long captivated both traders and investors. Today, technological advancements in machine learning play an increasingly crucial role in analyzing these fluctuations, thereby influencing market trends and contributing to shaping global economies. In this context, our aim is to design an intelligent system capable of accurately predicting the prices of gold, silver, and oil in the financial markets. The convergence of cutting-edge technology and financial strategies is essential to understanding and anticipating the movements of precious metal prices. Sophisticated algorithms such as Random Forest Regression (RFR), Long Short-Term Memory (LSTM) networks, and Support Vector Regression (SVR) allow us to explore new horizons in forecasting market trends. This study delves into this technological and financial convergence, paving the way for redefining the boundaries of precious metal price prediction through artificial intelligence, offering more precise and informed investment strategies, and thereby contributing to the evolution of practices in the financial sector.},
  doi       = {10.1109/ICOA62581.2024.10754218},
  issn      = {2768-6388},
  keywords  = {Support vector machines;Silver;Gold;Fluctuations;Oils;Market research;Prediction algorithms;Long short term memory;Random forests;Convergence;Machine Learning;Trading;Regression;Precious Metals;LSTM},
}

@Article{Singh2026,
  author   = {Singh, Priya and Sharma, Akanksha},
  journal  = {IEEE Access},
  title    = {Improving Gold Price Prediction Accuracy Through Variational Mode Decomposition and Bayesian-Tuned Hybrid BiLSTM-BiGRU Model},
  year     = {2026},
  issn     = {2169-3536},
  pages    = {58690-58706},
  volume   = {14},
  abstract = {Due to the highly dynamic and unpredictable nature of the global economy, it is very difficult to make successful predictions of gold prices. Traditional approaches for forecasting price movements will frequently fail due to the complexity of the relationships among the variables driving the gold price, such as economic indicators, geopolitical events, and market sentiment. Therefore, there is a need for modern, data-driven techniques for developing accurate models that predict gold prices. In this study, we present a new hybrid model and methodology that includes multiple levels of processing to overcome many of these obstacles. The selection of input features is guided by a Granger causality analysis used as a preliminary statistical screening step to identify variables with potential predictive relationships with gold prices. Next, we utilize Variational Mode Decomposition (VMD) to denoise the temporal data. The final phase of the methodology, the hybrid Bidirectional Gated Recurrent Unit (BiGRU) and Bidirectional Long Short Term Memory (BiLSTM), was developed using a Bayesian Optimization approach to develop a model that utilizes both BiLSTMs and BiGRUs, allowing for the combined advantages of LSTMs and GRUs. Based on previously collected and recorded prices for gold, this new predictive model provides a statistically superior forecast compared to both the traditional industry benchmarks and several current internet websites that provide gold price predictions. The results of 5-fold cross-validation and an ablation study confirmed the robustness of this model. Further statistical analysis using analysis of variance (ANOVA) and the Holm-Bonferroni post-hoc procedure provides evidence that the results of this model are statistically significantly better (p < 0.05) than those of any of the benchmark models used. Additionally, the use of an Integrated Deep Learning Architecture (IDLA), advanced signal processing methodologies, and rigorous feature validation techniques has resulted in a more accurate and reliable performance in the prediction of gold price movements.},
  doi      = {10.1109/ACCESS.2026.3683311},
  keywords = {Feeds;Oscillators;Circuits and systems;Filtering;Filters;Regional area networks;Radio access networks;Communication systems;Local area networks;Computer networks;Gold price prediction;BiLSTM;BiGRU;variational mode decomposition;Granger causality test;Holm-Bonferroni post-hoc test;SHAP},
}

@InProceedings{Sen2021,
  author    = {Sen, Jaydip and Dutta, Abhishek and Mehtab, Sidra},
  booktitle = {2021 IEEE Mysore Sub Section International Conference (MysuruCon)},
  title     = {Stock Portfolio Optimization Using a Deep Learning LSTM Model},
  year      = {2021},
  month     = {Oct},
  pages     = {263-271},
  abstract  = {Predicting future stock prices and their movement patterns is a complex problem. Hence, building a portfolio of capital assets using the predicted prices to achieve the optimization between its return and risk is an even more difficult task. This work has carried out an analysis of the time series of the historical prices of the top five stocks from the nine different sectors of the Indian stock market from January 1, 2016, to December 31, 2020. Optimum portfolios are built for each of these sectors. For predicting future stock prices, a long-and-short-term memory (LSTM) model is also designed and fine-tuned. After five months of the portfolio construction, the actual and the predicted returns and risks of each portfolio are computed. The predicted and the actual returns of each portfolio are found to be high, indicating the high precision of the LSTM model.},
  doi       = {10.1109/MysuruCon52639.2021.9641662},
  keywords  = {Deep learning;Computational modeling;IEEE Sections;Conferences;Time series analysis;Predictive models;Task analysis;Portfolio Optimization;Minimum Variance Portfolio;Optimum Risk Portfolio;Stock Price Prediction;LSTM;Deep Learning;Sharpe Ratio;Prediction Accuracy;Return;Volatility},
}

@InProceedings{Gong2022,
  author    = {Gong, Yang and Zhang, Pan},
  booktitle = {2022 2nd International Conference on Networking Systems of AI (INSAI)},
  title     = {Commodity Price Analysis and Prediction Based on Ensemble Learning},
  year      = {2022},
  month     = {Oct},
  pages     = {199-204},
  abstract  = {From the development of human social productive forces to a certain stage, commodities appear. Especially in modern society, people often need to buy things. When you buy something, there is a price issue. In order to help people grasp the price of a commodity, this paper proposes a commodity price analysis and prediction method based on ensemble learning. This method first obtains the historical data of the product; then simply analyzes the batch of data; then visualizes the data features; then adopts bagging regression in ensemble learning, using different weak classifiers (decision tree, support vector machine, K nearest neighbors), random forest, linear) for modeling comparison and analysis, the highest model accuracy rate can reach 0.9502; finally, five models are used to predict future prices. After testing, this method can be used in certain scenarios.},
  doi       = {10.1109/INSAI56792.2022.00045},
  groups    = {Predição de Commodities},
  keywords  = {Support vector machines;Analytical models;Data visualization;Predictive models;Data models;Ensemble learning;Regression tree analysis;ensemble learning;commodity price;machine learning;analysis and prediction},
}

@InProceedings{Gautam2026,
  author    = {Gautam, Divyanshu Kumar and Rathor, Archit and Singha, Anjani Kumar and Urooj, Shabana},
  booktitle = {2026 5th OPJU International Technology Conference (OTCON) on Smart Computing for Innovation and Advancement in Industry 5.0},
  title     = {Optimizing Agricultural Logistics and Market Access Using Machine Learning Models},
  year      = {2026},
  month     = {June},
  pages     = {1-6},
  abstract  = {As agriculture supply chain continues expanding and the markets become more sensitive, we are witnessing the actual demand of smart systems, which could turn the logistics process easier and assist farmers with entering the markets more conveniently. Former forecasting tools are becoming such a complex mess, but it is unable to reflect the real-time dynamics, which are in fact of significance thus farmers would lose the opportunity to gain a profit over time. This is why recent studies have become interested in machine learning (ML) to experiment with predicting the efficiency of various models when predicting farmland logistics. In order to actually justify the ML solution, we have compared four popular models which include Regression Analysis, Random Forest, Gradient Boosting and Neural Networks. We have taken accuracy, precision, recall and the F1 score to understand the rankings of each of the models in terms of predicting the logistic variables. The simple Regression model had an approximation of 87.4 per cent accuracy which is fair in detecting linear association but fails miserably when the data becomes messy. Instead, the Random Forest has reached the highest accuracy of 95.6 per cent by more accurately representing the nonlinear trends of the logistics data. Gradient Boosting was next with an impressive accuracy of 97.2 per cent and the concept of precision being superior which implies a refinement of the model in selecting out an error in the forecasting process. Neural Network became the savior of the day. It remained the most consistent in all the measures with accuracy of 99.01, precision of 98.89 and recall of 98.78. Such figures indicate that deep learning has been successful in capturing the intricate aspects that are inputted into the forecasting mechanism and, therefore, it is most suitable in this kind of endeavor. The general findings are in many ways favourable to the notion that ML models can create physically tangible improvements in the efficiency of the agricultural logistics sector in order to enable farmers and the supply chain to operate more effectively.},
  doi       = {10.1109/OTCON69332.2026.11629946},
  keywords  = {Modeling;Machine learning;Logistics;Agriculture;Machining;Accuracy;Forecasting;Printing;Crops;Pricing;Agricultural logistics;Market access;Machine learning(ML) models;Supply chain optimization;Price prediction;Farm-to-market efficiency;Economic sustainability;Predictive analytics},
}

@InProceedings{Wu2023a,
  author    = {Wu, Tianyu},
  booktitle = {2023 International Conference on Applied Intelligence and Sustainable Computing (ICAISC)},
  title     = {Research on Multimodal Futures Price Prediction Method based on DCC-GARCH Model},
  year      = {2023},
  month     = {June},
  pages     = {1-7},
  abstract  = {As the economy and technology rapidly advance, financial investment has increasingly become a means for the general public to generate and accumulate wealth. Futures trading, a method in which buyers and sellers enter a standardized contract to exchange a commodity at a predetermined date, is one such avenue. While futures investments require minimal capital and permit investors to sell prior to buying, they also subject traders to greater investment risks. In recent years, as computer science and its interdisciplinary fields have developed, employing mathematical and statistical approaches to analyze and predict the futures market for wise investments has gained popularity. Considering the uncertainty and multimodal characteristics of the futures trading market, this study categorizes futures trading into five modes and investigates the relationship between these modes and futures prices. By utilizing the Generalized Autoregressive Conditional Heteroskedasticity (GARCH) model for predictions in varying mode environments, this research applies a mode correction function to adjust the base step in GARCH forecasts to address market fluctuations. Analyzing results derived from actual futures trading data reveals that the multimodal futures price prediction model demonstrates higher accuracy compared to the conventional GARCH model.},
  doi       = {10.1109/ICAISC58445.2023.10199418},
  keywords  = {Analytical models;Fluctuations;Uncertainty;Computational modeling;Predictive models;Rendering (computer graphics);Market research;futures trading;price prediction;multimodal;GARCH model},
}

@InProceedings{Sen2021a,
  author    = {Sen, Jaydip and Mondal, Saikat and Nath, Gourab},
  booktitle = {2021 IEEE 18th India Council International Conference (INDICON)},
  title     = {Robust Portfolio Design and Stock Price Prediction Using an Optimized LSTM Model},
  year      = {2021},
  month     = {Dec},
  pages     = {1-6},
  abstract  = {Accurate prediction of future prices of stocks is a difficult task to perform. Even more challenging is to design an optimized portfolio with weights allocated to the stocks in a way that optimizes its return and the risk. This paper presents a systematic approach towards building two types of portfolios, optimum risk, and eigen, for four critical economic sectors of India. The prices of the stocks are extracted from the web from Jan 1, 2016, to Dec 31, 2020. Sector-wise portfolios are built based on their ten most significant stocks. An LSTM model is also designed for predicting future stock prices. Six months after the construction of the portfolios, i.e., on Jul l, 2021, the actual returns and the LSTM-predicted returns for the portfolios are computed. A comparison of the predicted and the actual returns indicate a high accuracy level of the LSTM model.},
  doi       = {10.1109/INDICON52576.2021.9691583},
  issn      = {2325-9418},
  keywords  = {Economics;Systematics;Computational modeling;Conferences;Buildings;Predictive models;Task analysis;Portfolio optimization;Minimum Variance Portfolio;Optimum Risk Portfolio;Eigen Portfolio;Stock Price Prediction;LSTM;Sharpe Ratio;Prediction Accuracy},
}

@InProceedings{Pratama2024,
  author    = {Pratama, Andre},
  booktitle = {2024 2nd International Conference on Technology Innovation and Its Applications (ICTIIA)},
  title     = {Bitcoin Cryptocurrency Price Prediction Using IFA-BiLSTM},
  year      = {2024},
  month     = {Sep.},
  pages     = {1-6},
  abstract  = {Bitcoin stands out as the most valuable asset in the cryptocurrency market, characterized by its highly fluctuating and unpredictable price. Investments relying on price fluctuations entail high levels of risk, thus requiring accurate methods to predict Bitcoin price estimates. This research aims to devise a solution for predicting the price value of Bitcoin with fluctuating price characteristics using a combination of the Improved Firefly Algorithm (IFA) and Bidirectional Long Short Term Memory (BiLSTM) methods. The predicted data is preprocessed through min-max normalization before being split into training and testing sets, maintaining an 80:20 ratio. Then, the IFA method will search for the best hyperparameter values for BiLSTM. By using the right hyperparameter values that are appropriate for the data, the model can generate good prediction accuracy. The IFA-BiLSTM model outperforms previous models with an RMSE of 2051.55, MAPE of 3.48%, and accuracy of 96.52%.},
  doi       = {10.1109/ICTIIA61827.2024.10761776},
  keywords  = {Training;Technological innovation;Accuracy;Computational modeling;Time series analysis;Bitcoin;Predictive models;Prediction algorithms;Data models;Testing;Firefly Algorithm;BiLSTM;Hyperparameter Optimization;Bitcoin Price Prediction},
}

@InProceedings{Thamizhselvi2025,
  author    = {Thamizhselvi, D. and S, Praveen and A, Akshaya Praveen and S, Bharath and R, Dhanusha},
  booktitle = {2025 International Conference on Computing and Communication Technologies (ICCCT)},
  title     = {Data-Driven Investing: Enhancing Trading Strategies with ML and Big Data},
  year      = {2025},
  month     = {April},
  pages     = {1-5},
  abstract  = {Predicting stock prices is a difficult task, but investors must make informed decisions. Using Bigdata and Machine Learning technologies we can accurately predict the stock prices, which analyses past data and quantitative indications. Utilizing big data analytics, this system can analyze and extract useful information from a vast amount of historical stock data. Then a machine-learning model is used to generate trading signals that depend on technical indicators. The RSI, MACD, and Bollinger Bands are only a few of the technical indicators used by the model to forecast how stock prices are going to change over the next few days. A big dataset of past stock prices and technical indicators is used to train the model. The model can produce trading signals when it has been trained. The model outputs a signal for each stock, indicating whether the investor should buy, sell, or hold the stock. The investor can then use these signals to make informed trading decisions. The proposed model is evaluated on a held-out test set. The outcomes prove that the model can generate trading signals that are more profitable than a buy-and-hold strategy. Investors can use the proposed model to improve their trading performance. The model is simple to use and doesn't require any specific machine learning expertise.},
  doi       = {10.1109/ICCCT63501.2025.11019142},
  issn      = {2995-3197},
  keywords  = {Computational modeling;Machine learning;Big Data;Predictive models;Communications technology;Data mining;Stock markets;Stock market prediction;Machine learning;Big Data;Technical Indicators;Trading signals},
}

@InProceedings{Durgapal2021,
  author    = {Durgapal, Ayushman and Vimal, Vrince},
  booktitle = {2021 IEEE 8th Uttar Pradesh Section International Conference on Electrical, Electronics and Computer Engineering (UPCON)},
  title     = {Prediction of Stock Price Using Statistical and Ensemble learning Models: A Comparative Study},
  year      = {2021},
  month     = {Nov},
  pages     = {1-6},
  abstract  = {Prediction of the stock price has always been a challenging task due to irregular patterns of the market. Uncertainty has made researchers think of some new and robust predictive methods. Many studies are available in the literature, with many models to predict the stock price accurately. Statistical, machine learning, deep learning, and other related approaches can create a predictive model. ARIMA model is the most commonly used statistical model for time series prediction. But ensemble learning techniques have not been explored much to predict future stock price. So, the present study stresses comparing statistical methods with ensemble learning methods. This paper compares the ARIMA, Random Forest, and Extreme Gradient Boosting models based on root mean squared error (RMSE) and mean absolute percentage error (MAPE). The subject chosen is Google’s stocks, and the data used is from NASDAQ stock exchange. The analysis results show that the ARIMA model performed fairly well for short-term predictions but relatively high MAPE value. The extreme gradient boosting model gave the best performance with the lowest RMSE and MAPE value. Hence, it is evident that after proper hyperparameter tuning, ensemble learning techniques can be used to create robust stock price-prediction models.},
  doi       = {10.1109/UPCON52273.2021.9667644},
  issn      = {2687-7767},
  keywords  = {Uncertainty;Computational modeling;Time series analysis;Predictive models;Boosting;Task analysis;Stock markets;Ensemble learning Models;ARIMA;Random Forest Model;Extreme gradient Boosting Model;Stock Price Prediction},
}

@InProceedings{Sen2021b,
  author    = {Sen, Jaydip and Mehtab, Sidra and Dutta, Abhishek and Mondal, Saikat},
  booktitle = {2021 19th OITS International Conference on Information Technology (OCIT)},
  title     = {Precise Stock Price Prediction for Optimized Portfolio Design Using an LSTM Model},
  year      = {2021},
  month     = {Dec},
  pages     = {210-215},
  abstract  = {Accurate prediction of future prices of stocks is a difficult task to perform. Even more challenging is to design an optimized portfolio of stocks with the identification of proper weights of allocation to achieve the optimized values of return and risk. We present optimized portfolios based on the seven sectors of the Indian economy. The past prices of the stocks are extracted from the web from January 1,2016, to December 31, 2020. Optimum portfolios are designed on the selected seven sectors. An LSTM regression model is also designed for predicting future stock prices. Five months after the construction of the portfolios, i.e., on June 1, 2021, the actual and predicted returns and risks of each portfolio are computed. The predicted and the actual returns indicate the very high accuracy of the LS TM model.},
  doi       = {10.1109/OCIT53463.2021.00050},
  keywords  = {Computational modeling;Predictive models;Resource management;Task analysis;Information technology;Portfolios;portfolio optimization;minimum variance portfolio;optimum risk portfolio;stock price prediction;LSTM;Sharpe ratio;prediction accuracy},
}

@Article{Li2022c,
  author   = {Li, Lue and Han, Caihong and Yao, Shengwei and Ning, Liangshuo},
  journal  = {IEEE Access},
  title    = {Variable Weights Combination MIDAS Model Based on ELM for Natural Gas Price Forecasting},
  year     = {2022},
  issn     = {2169-3536},
  pages    = {52075-52093},
  volume   = {10},
  abstract = {Accurate and stable natural gas price forecasts are essential for effective management of energy systems. However, due to the mixed frequency of data and the inherent nonlinear fluctuation characteristics of natural gas price changes, it is difficult to achieve satisfactory forecasting performance. In order to effectively improve the forecasting results of mixed frequency data. In this study, the MIDAS regression model and the machine learning MIDAS models are successfully combined to form a novel combination forecasting model. Moreover, the extreme learning machine with the multi-objective grey-wolf algorithm is used to combine univariate MIDAS results and further improve the forecasting accuracy. In the empirical analysis, the weekly natural gas futures prices of the Intercontinental Exchange UK NBP are used to generate real-time forecasts to evaluate the forecasting performance of the proposed combination model. The experimental results show that the comprehensive forecasting accuracy of the novel combination MIDAS model is 26.35%, 8.82% and 12.91% higher than that of the benchmark MIDAS regression models, the combination MIDAS models and the multivariate MIDAS models, respectively. Based on the forecasting results, the non-linear, non-stationary and irregular natural gas futures prices can be effectively managed, which provides better investment and management tools.},
  doi      = {10.1109/ACCESS.2022.3174814},
  keywords = {Natural gas;Predictive models;Forecasting;Data models;Economics;Oils;Coal;Natural gas price forecasting;mixed data sampling model;combination-MIDAS-MOGWO-ELM model;forecasting accuracy},
}

@InProceedings{Assaduddiari2025,
  author    = {Assaduddiari, Iqbal Ghani and Kurdhi, Nughthoh Arfawi and Siri, Zailan and Aruchunan, Elayaraja},
  booktitle = {2025 International Conference on Artificial Intelligence and Technological Solutions (ICAITech)},
  title     = {Forecasting Tesla Stock Price Using XGBoost, Random Forest, and CatBoost: A Comparative Study with TreeSHAP Interpretation of the Best Model},
  year      = {2025},
  month     = {Nov},
  pages     = {309-314},
  abstract  = {The rapid development of electric vehicles (EV) has significantly increased investor interest in Tesla Inc., one of the world’s largest and most influential EV manufacturers. Accurate stock price forecasting has thus become a valuable tool for supporting investment decisions. This study leverages recent advancements in artificial intelligence to develop predictive models for Tesla’s stock price using historical stock data and related commodity market indicators. We construct and evaluate three machine learning models namely XGBoost, Random Forest, and CatBoost. Their performance is rigorously assessed using key metrics, including Mean Absolute Error (MAE), Root Mean Square Error (RMSE), and the Coefficient of Determination $\left(\mathbf{R}^{\mathbf{2}}\right)$. The results demonstrate that the CatBoost model outperformed the others, achieving the lowest MAE and RMSE and the highest $\mathbf{R}^{\mathbf{2}}$ value, proving it to be the most accurate model for forecasting Tesla’s stock price in this study. Furthermore, to enhance transparency and interpretability, we integrate Explainable Artificial Intelligence (XAI) techniques, specifically Tree-based SHapley Additive exPlanations (TreeSHAP), which elucidates the reasoning behind the model’s predictions. By combining predictive modeling with interpretability tools, this study provides both accurate and explainable forecasts, offering practical insights for investors, analysts, and financial decision-makers. The research confirms that machine learning, when augmented with explainability techniques, constitutes a powerful framework for stock price forecasting in dynamic markets such as the EV industry.},
  doi       = {10.1109/ICAITech66481.2025.11387624},
  keywords  = {Analytical models;Accuracy;Explainable AI;Supply chains;Predictive models;Forecasting;Vehicle dynamics;Random forests;Tuning;Investment;Stock Price;Tesla(TSLA);Machine Learning;TreeSHAP},
}

@InProceedings{Zhang2024,
  author    = {Zhang, Pengfei and Hu, Zhanshuo and Xing, Zuoxia and Hu, Bo},
  booktitle = {2024 IEEE 8th Conference on Energy Internet and Energy System Integration (EI2)},
  title     = {Day-Ahead Electricity Prices Prediction Method Based on Spatial-temporal Transformer with Variable-Specific Modeling},
  year      = {2024},
  month     = {Nov},
  pages     = {2346-2350},
  abstract  = {Electricity price predictions occupy an important position in the electricity market and are a key to the healthy operation. in order to solve the problem that the past prediction models can only capture the average characteristic due to the variables sharing the same parameters, this paper proposes a spatial-temporal Transformer prediction model based on variable-specific modeling, by designing specific temporal projection matrices and spatial projection matrices that enable specific modeling of each variable and correlations between variables so that this prediction model captures the unique spatial-temporal characteristic of day-ahead electricity prices. Taking electricity price data from Australia as an example, verified the effectiveness of the prediction model by comparing it with six mainstream prediction models.},
  doi       = {10.1109/EI264398.2024.10991416},
  keywords  = {Correlation;Electricity;Computational modeling;Time series analysis;Energy Internet;System integration;Predictive models;Transformers;Electricity supply industry;Data models;day-ahead electricity price prediction;transformer;variable-specific modeling;time series},
}

@Article{SaeedAlzaeemi2021,
  author   = {Saeed Alzaeemi, Shehab Abdulhabib and Sathasivam, Saratha},
  journal  = {IEEE Access},
  title    = {Examining the Forecasting Movement of Palm Oil Price Using RBFNN-2SATRA Metaheuristic Algorithms for Logic Mining},
  year     = {2021},
  issn     = {2169-3536},
  pages    = {22542-22557},
  volume   = {9},
  abstract = {RBFNN with different algorithms and the logic mining method for forecasting constitute the most significant tools and techniques, which are used to demonstrate the economic growth in the country. Upon using monthly data spanning from Jan 2016 to March 2020 for the manufacturing of palm oil, the results mainly revealed that RBFNN-2SATRAAIS is the most accurate and efficient model compared to RBFNN-2SATRAPSO and RBFNN-2SATRAGA in forecasting the price of palm oil. RBFNN-2SATRAAIS had the highest average overall accuracy (90.476190%), followed by RBFNN-2SATRAPSO (85.71%), and RBFNN-2SATRAGA (76.19%). The results also showed that the spot price of palm oil is highly influenced by the total exports and imports, as well as the production of palm oil, its end-stocks, and Malaysia’s real, effective exchange rate. By using the data mining technique based on the energy minimization technique, the logical mining task was carried out. The empirical findings provided useful insights into decision-making and policy implementations, including the formulation of strategies to help the industry in dealing with constant price fluctuations and, thereby, enabling the Malaysian palm oil industry to continue its domination over the international market.},
  doi      = {10.1109/ACCESS.2021.3054816},
  keywords = {Oils;Data mining;Forecasting;Prediction algorithms;Petroleum industry;Neurons;Genetic algorithms;Palm oil prices;economic growth;forecasting;artificial immune system;particle swarm optimization;genetic algorithm;radial basis functions neural network;2 satisfiability;2 satisfiability reverse;Analysis;logic mining},
}

@Article{Krejnik2012,
  author   = {Krejnik, Miloš and Tyutin, Anton},
  journal  = {IEEE Transactions on Neural Networks and Learning Systems},
  title    = {Reproducing Kernel Hilbert Spaces With Odd Kernels in Price Prediction},
  year     = {2012},
  issn     = {2162-2388},
  month    = {Oct},
  number   = {10},
  pages    = {1564-1573},
  volume   = {23},
  abstract = {For time series of futures contract prices, the expected price change is modeled conditional on past price changes. The proposed model takes the form of regression in a reproducing kernel Hilbert space with the constraint that the regression function must be odd. It is shown how the resulting constrained optimization problem can be reduced to an unconstrained one through appropriate modification of the kernel. In particular, it is shown how odd, even, and other similar kernels emerge naturally as the reproducing kernels of Hilbert subspaces induced by respective symmetry constraints. To test the validity and practical usefulness of the oddness assumption, experiments are run with large real-world datasets on four futures contracts, and it is demonstrated that using odd kernels results in a higher predictive accuracy and a reduced tendency to overfit.},
  doi      = {10.1109/TNNLS.2012.2207739},
  keywords = {Kernel;Hilbert space;Interpolation;Data models;Time series analysis;Optimization;Complexity theory;Financial time series;kernel ridge regression (KRR);odd kernel;price prediction;reproducing kernel Hilbert space (RKHS)},
}

@Article{Ferreira2021,
  author   = {Ferreira, Fernando G. D. C. and Gandomi, Amir H. and Cardoso, Rodrigo T. N.},
  journal  = {IEEE Access},
  title    = {Artificial Intelligence Applied to Stock Market Trading: A Review},
  year     = {2021},
  issn     = {2169-3536},
  pages    = {30898-30917},
  volume   = {9},
  abstract = {The application of Artificial Intelligence (AI) to financial investment is a research area that has attracted extensive research attention since the 1990s, when there was an accelerated technological development and popularization of the personal computer. Since then, countless approaches have been proposed to deal with the problem of price prediction in the stock market. This paper presents a systematic review of the literature on Artificial Intelligence applied to investments in the stock market based on a sample of 2326 papers from the Scopus website between 1995 and 2019. These papers were divided into four categories: portfolio optimization, stock market prediction using AI, financial sentiment analysis, and combinations involving two or more approaches. For each category, the initial introductory research to its state-of-the-art applications are described. In addition, an overview of the review leads to the conclusion that this research area is gaining continuous attention and the literature is becoming increasingly specific and thorough.},
  doi      = {10.1109/ACCESS.2021.3058133},
  keywords = {Portfolios;Stock markets;Investment;Artificial intelligence;Optimization;Finance;Computational finance;algotradings;artificial intelligence;finance},
}

@InProceedings{Ding2023,
  author    = {Ding, Yu and Zhai, Yuqing and Chu, Xinyi and Xie, Jinchi and Zhang, Yu and Lu, Denghui and Li, Yunhao},
  booktitle = {2023 International Conference on Intelligent Management and Software Engineering (IMSE)},
  title     = {Temporal Relational Ranking for Non-Fungible Tokens},
  year      = {2023},
  month     = {Sep.},
  pages     = {121-125},
  abstract  = {NFTs (Non-Fungible Tokens) are a type of digital asset based on blockchain technology that has become an attractive investment tool for many investors. This paper proposes a model based on knowledge graphs and LSTM (Long Short-Term Memory) networks to provide investors with a ranking prediction of future NFT returns, assisting traders in making more accurate investment decisions in the NFT market. To verify the usability and accuracy of the model, we collected data from 345 different types of NFTs on the OpenSea platform and conducted experimental validation, comparing our method with other benchmark methods to demonstrate the accuracy of our proposed method in practical scenarios.},
  doi       = {10.1109/IMSE61332.2023.00032},
  keywords  = {Knowledge graphs;Predictive models;Benchmark testing;Data models;Nonfungible tokens;Usability;Long short term memory;Non-Fungible Tokens Prediction;Knowledge Graph;LSTM;Learning to Rank},
}

@Article{Liu2021,
  author   = {Liu, Boming and Akcakaya, Murat and Mcdermott, Thomas E.},
  journal  = {IEEE Transactions on Smart Grid},
  title    = {Automated Control of Transactive HVACs in Energy Distribution Systems},
  year     = {2021},
  issn     = {1949-3061},
  month    = {May},
  number   = {3},
  pages    = {2462-2471},
  volume   = {12},
  abstract = {Heating, Ventilation, and Air Conditioning (HVAC) systems contribute significantly to a building's energy consumption. In the recent years, there is an increased interest in developing transactive approaches which could enable automated and flexible scheduling of HVAC systems based on the customer demand and the electricity prices decided by the suppliers. Flexible and automated scheduling of the HVAC systems make it a prime source for participation in residential demand response or transactive energy systems. Therefore, it is of significant interest to identify an optimal strategy to control the HVAC systems. In this article, reducing the energy cost while keeping the comfort level acceptable to the users, we argue that such a control strategy should consider both the energy cost and user comfort simultaneously. Accordingly, we develop the control strategy through the solution of an optimization problem that balances between the energy cost and consumer's dissatisfaction. This optimization enables us to solve a decision-making problem through first price prediction and then choosing HVAC temperature settings throughout the day based on the predicted price, history of the price and HVAC settings, and outside temperature. More specifically, we formulate the control design as a Markov decision process (MDP) using deep neural networks and use Deep Deterministic Policy Gradients (DDPG)-based deep reinforcement learning algorithm to find the optimal control strategy for HVAC systems that balances between electricity cost and user comfort.},
  doi      = {10.1109/TSG.2020.3042498},
  keywords = {HVAC;Temperature control;Schedules;Reinforcement learning;Home appliances;Transactive energy;Prediction algorithms;Transactive energy;reinforcement learning;HVAC},
}

@InProceedings{Amellal2023,
  author    = {Amellal, Asmae and Amellal, maIssam and Seghiouer, Hamid and Ech-Charrat, Mohammed Rida},
  booktitle = {2023 7th IEEE Congress on Information Science and Technology (CiSt)},
  title     = {BERT-Enhanced Deep Gaussian Regression: A Unified Approach for Sentiment Analysis and Price Prediction},
  year      = {2023},
  month     = {Dec},
  pages     = {541-546},
  abstract  = {This study presents a novel approach that fuses the BERT (Bidirectional Encoder Representations from Transformers) model for sentiment analysis with Deep Gaussian Processes (DGP) for automotive spare parts price prediction, targeting applications in supply chain management. Leveraging the strengths of both models, our method enhances NLP (Natural Language Processing) and time series forecasting, promoting informed decision-making and improved business intelligence strategies in a data-driven world.},
  doi       = {10.1109/CiSt56084.2023.10409882},
  issn      = {2327-1884},
  keywords  = {Analytical models;Sentiment analysis;Decision making;Machine learning;Predictive models;Data models;Global Positioning System;BERT model;deep Gaussian processes;business intelligence;decision-making},
}

@InProceedings{Szydlowski2024,
  author    = {Szydłowski, Kamil Ł. and Chudziak, Jarosław A.},
  booktitle = {2024 IEEE 36th International Conference on Tools with Artificial Intelligence (ICTAI)},
  title     = {Toward Predictive Stock Trading with Hidformer Integrated into Reinforcement Learning Strategy},
  year      = {2024},
  month     = {Oct},
  pages     = {213-220},
  abstract  = {This paper presents the Hidformer model, a Transformer-type neural network, integrated with reinforcement learning (RL) strategies for enhanced stock trading performance. By leveraging the Hidformer model's predictive capabilities, we aim to improve the decision-making processes of RL agents in financial markets. Our approach extends state observations with future stock price predictions, allowing for more informed trading actions. Experimental results demonstrate that the enhanced RL strategy outperforms traditional methods across multiple metrics, including annual return, cumulative return, and risk-adjusted measures such as the Sharpe and Calmar ratios. Although statistical significance was not achieved, the consistent improvement trends, especially when considering visual analysis, underscore the potential of combining advanced time series forecasting models with RL techniques. This integration suggests a promising direction for developing robust and profitable automated trading systems. Furthermore, our findings provide further understanding of the practical use of Transformer architectures in finance and risk management, emphasizing their potential to enhance algorithmic trading strategies and potentially enable investors to achieve excess earnings.},
  doi       = {10.1109/ICTAI62512.2024.00039},
  issn      = {2375-0197},
  keywords  = {Measurement;Visualization;Time series analysis;Neural networks;Reinforcement learning;Predictive models;Transformers;Prediction algorithms;Market research;Risk management;Automated stock trading;Stock price prediction;Transformer;Hidformer;Deep reinforcement learning;Actor-critic framework},
}

@InProceedings{Parikh2023,
  author    = {Parikh, Aayush and Goswami, Himanshu and Vora, Nivan and Kore, Aniket},
  booktitle = {2023 6th International Conference on Advances in Science and Technology (ICAST)},
  title     = {Cryptocurrency Price Prediction using Regression Models on Momentum Indicators},
  year      = {2023},
  month     = {Dec},
  pages     = {131-136},
  abstract  = {Cryptocurrencies have enormously gained popularity ever since the launch of Bitcoin in 2009 and are now valued at over a trillion dollars as a whole. A significant number of people actively participate in cryptocurrency trading, to the extent that various goods and services can be acquired through the use of digital currencies like Bitcoin, Ethereum, and others. Nevertheless, the analysis of trends, graphs, and trading strategies involves a considerable level of complexity. Making use of conducted research enables traders to effectively capitalize on trading opportunities. The proposed model uses three momentum indicators which are the Relative Strength Index(RSI), Moving Average Convergence Divergence(MACD), and Average Directional Index(ADX) as features. Each indicator takes as input custom factors that give substantial trend analysis. The values of each indicator are used as features in a variety of machine-learning models that rely on regression to predict the price of cryptocurrencies in the future. The price prediction model is fairly accurate, and it is observed that the gradient boost shows the highest accuracy of the three models with an R-squared value equal to 0.968.},
  doi       = {10.1109/ICAST59062.2023.10455082},
  keywords  = {Radio frequency;Analytical models;Bitcoin;Predictive models;Market research;Random forests;Testing;cryptocurrency;bitcoin;indicators;regression models;gradient boost;price prediction},
}

@InProceedings{Zeng2025,
  author    = {Zeng, Xilei},
  booktitle = {2025 2nd International Conference on Software, Systems and Information Technology (SSITCON)},
  title     = {Accurate Oil Futures Price Prediction by Integrative Learning and Transfer Learning Integration},
  year      = {2025},
  month     = {Oct},
  pages     = {1-6},
  abstract  = {Metro shield tunneling adjacent to high-voltage iron towers often causes construction settlement, which threatens the tower's structural safety. Existing single prediction models fail to accurately capture the complex nonlinear settlement patterns, posing challenges to engineering safety decision-making. A machine learning-based construction settlement prediction model was established, integrating shield construction parameters, geological data, and tower surrounding monitoring data, and optimizing the model structure to enhance feature capture capability. Experiments show the model significantly improves prediction accuracy-its test-set error is notably lower than traditional models, accurately reflecting real settlement trends and effectively avoiding settlement-induced tower risks. The model provides reliable technical support for construction settlement control in such scenarios, ensuring the safety of metro tunneling projects and high-voltage iron towers.},
  doi       = {10.1109/SSITCON66133.2025.11341979},
  keywords  = {Oils;Computational modeling;Poles and towers;Stacking;Computer architecture;Predictive models;Tunneling;Data models;Real-time systems;Safety;oil futures prices;integrated learning;migration learning;stacking integrated architecture;pre-training - finetuning strategy},
}

@InProceedings{Venkatesan2026,
  author    = {Venkatesan, R and Mahto, Dindayal and Saravanan, G and Raghav, R S and Sanjeev Kumar, A N and Rajendiran, P},
  booktitle = {2026 International Conference on Advanced Computing and Knowledge Engineering (ICACKE)},
  title     = {XGBoost-Driven Forecasting of Crude Oil Prices: A Comparative Machine Learning and Stochastic Evaluation},
  year      = {2026},
  month     = {July},
  pages     = {1-7},
  abstract  = {It can be seen that the market dependence on the rules and the non-linear and complex nature of the world energy market. The process of estimating the prices of crude oil an inherently difficult task. The complex dynamics, in turn, influenced by geopolitical shocks, supply-demand imbalance and macroeconomic fluctuations, are often not well-aware of conventional econometric and stochastic models. To overcome these limitations, this study provides the comparative analysis of three machine-learning models: 1) Random Forest, 2) Extreme Gradient Boosting (XGBoost) and 3) Multiple Linear Regression (MLR with a mean-reversion stochastic model to provide directional predictions of crude-oil prices in the Indian MCX market based on historical data of 2009-2025. Technical indicators and lag-based features are designed in order to increase predictive performance, and the time series crossvalidation was used to ensure strong temporal generalization. The results of the experiment show that the XGBoost is most successful model among the other machine learning models, with the lowest mean squared error (MSE $=130,057)$ and the highest time-series coefficient of determination $\left(\mathrm{R}^{2}=0.932\right)$. In comparison, the stochastic model produced a directional accuracy of 59% which is a sign of moderate performance, but this clearly represents poorer reliability than the ML-based forecasting methods. These results are consistent with the fact that machine learning, especially gradient-boosting algorithms, is better placed at capturing the complex nonlinear dynamics of financial time series, and hence provides better decision-support services to commodity exchanges. Additionally, the findings highlight the growing importance of ML-based forecasting systems in energy price prediction and indicate promising future research directions of hybrid deep-learning models and reinforcement-learning-based adaptive trading systems.},
  doi       = {10.1109/ICACKE65470.2026.11651157},
  keywords  = {Modeling;Pricing;Forecasting;Lubricating oils;Oils;Timing;Machine learning;Accuracy;Machining;Random forests;Crude Oil Forecasting;Machine Learning;Ensemble Models;Time-Series Forecasting;XGBoost;Stochastic Modelling},
}

@InProceedings{Peng2026,
  author    = {Peng, Jiayi and Ma, Yanna and Wei, Wei and Wang, Hongxia and Hu, Mengyao and Shao, Yupeng and Shao, Bilu and Junfang, Fang},
  booktitle = {2026 IEEE 9th International Conference on Big Data and Artificial Intelligence (BDAI)},
  title     = {A Hybrid Computational Intelligence Framework for PTA Futures Price Forecasting with Ridge Residual LSTM-Forest},
  year      = {2026},
  month     = {July},
  pages     = {450-454},
  abstract  = {Purified terephthalic acid (PTA) futures forecasting is a challenging computational intelligence problem because prices are jointly driven by upstream crude oil and para-xylene costs, downstream polyester demand, spot-futures basis, market sentiment, and trading behavior. The resulting series contains linear autocorrelation, nonlinear residual patterns, feature redundancy, and regime-dependent volatility. This paper proposes a hybrid computational intelligence framework for next-day PTA futures price forecasting. The framework combines a Ridge linear anchor with a random-forest-screened LSTM ensemble, referred to as LSTM-Forest. Ridge regression first extracts the dominant linear component from all engineered features, while the LSTM-Forest module learns the remaining nonlinear residual from selected features and rolling historical windows. A double Bollinger-band module is further used to evaluate the decision-support value of the predicted price curve. Using daily PTA futures data from December 2006 to April 2026, with training data up to 2024, validation data in 2025, and testing data from January to April 2026, the selected configuration achieves a test MAE of 76.08 CNY per ton, RMSE of 107.07 CNY per ton, MAPE of 1.23 percent, directional accuracy of 67.11 percent, and correlation of 0.9889. Benchmark and ablation experiments show that linear models are strong competitors, random-forest feature screening improves the LSTM-Forest module, and derivative loss does not provide stable gains under the current setting. The results indicate that residual learning is an interpretable way to integrate linear structure, neural ensemble learning, and trading-signal analysis for commodity futures forecasting.},
  doi       = {10.1109/BDAI70753.2026.11655166},
  keywords  = {Modeling;Forecasting;Long short term memory;Pricing;Printing;Forests;Testing;International trade;Equations;Random forests;computational intelligence;PTA futures;financial time-series forecasting;residual learning;Ridge regression;LSTM-Forest;random forest feature selection;neural ensemble},
}

@InProceedings{Lutfi2021,
  author    = {Lutfi, Moch. and Agustin, Sheilla Putri and Nurma Yulita, Intan},
  booktitle = {2021 International Conference on Artificial Intelligence and Big Data Analytics},
  title     = {LQ45 Stock Price Prediction Using Linear Regression Algorithm, Smo Regression, And Random Forest},
  year      = {2021},
  month     = {Oct},
  pages     = {1-5},
  abstract  = {Researchers have carried out stock predictions in various ways. Stock is one type of investment that is quite attractive to investors. However, the risk of relatively large stock price fluctuations raises many questions among investors and researchers (academics) about how investors can predict stock prices in the future. There are two types of factors that affect stock price movements. There are external factors and internal factors. This study predicts stock prices using linear regression, SMO regression, and random forest algorithms. and compare the three models to find the most effective model in predicting stock prices. The results show that the most efective modeling in this study is using SMOReg which has the smallest error value among other models with a metric with an MAE number of 7.4758; MSE 157.0944; RMSE 12.5337; and MAPE 0.524. This means that the model is reliable enough to be used to predict future stock prices. However, SMOReg still has weaknesses in studying sequential data and causes overfitting.},
  doi       = {10.1109/ICAIBDA53487.2021.9689749},
  keywords  = {Measurement;Fluctuations;Linear regression;Predictive models;Big Data;Prediction algorithms;Artificial intelligence;Stock Price;Predictions;Algoritma linear regression;SMO regression;dan random forest},
}

@InProceedings{Sen2021c,
  author    = {Sen, Jaydip and Mondal, Saikat and Mehtab, Sidra},
  booktitle = {2021 International Conference on Data Analytics for Business and Industry (ICDABI)},
  title     = {Portfolio Optimization on NIFTY Thematic Sector Stocks Using an LSTM Model},
  year      = {2021},
  month     = {Oct},
  pages     = {364-369},
  abstract  = {Portfolio optimization has been abroad and intense area of interest for quantitative and statistical finance researchers and financial analysts. It is a challenging task to design a portfolio of stocks to arrive at the optimized values of the return and risk. This paper presents an algorithmic approach for designing optimum risk and eigen portfolios for five thematic sectors of the NSE of India. The prices of the stocks are extracted from the web from Jan 1, 2016, to Dec 31,2020. Optimum risk and eigen portfolios for each sector are designed based on ten critical stocks from the sector. An LSTM model is designed for predicting future stock prices. Seven months after the portfolios were formed, on Aug 3, 2021, the actual returns of the portfolios are compared with the LSTM-predicted returns. The predicted and the actual returns indicate a very high-level accuracy of the LSTM model.},
  doi       = {10.1109/ICDABI53623.2021.9655886},
  keywords  = {Industries;Data analysis;Computational modeling;Finance;Predictive models;Data models;Task analysis;Portfolio Optimization;Minimum Variance Portfolio;Optimum Risk Portfolio;Eigen Portfolio;Stock Price Prediction;LSTM;Sharpe Ratio;Prediction Accuracy},
}

@InProceedings{Balasooriya2022,
  author    = {Balasooriya, Tharindu and Kavishka, Lakindu and Dananjana, Isini and Yumna, Maryam and Thelijjagoda, Samantha and Attanayaka, Buddhima and Marasinghe, Lanil},
  booktitle = {2022 3rd International Conference on Smart Electronics and Communication (ICOSEC)},
  title     = {Location Intelligence Based Smart E-Commerce Platform for Residential Real-Estate Industry},
  year      = {2022},
  month     = {Oct},
  pages     = {867-873},
  abstract  = {Making the decision to purchase or invest in real estate can be a very crucial process due to its high financial risk. The purchasing decision of residential real estate properties can be even more decisive because, apart from the financial risk, the choice of a property can have a great impact on the future lifestyle of the buyer. When considering residential real estate, one major factor to be considered is the property location. This research sought to determine the applicability of modern technologies such as location intelligence and machine learning in the development of an e-commerce system that may assist users in making optimal residential real estate location decisions. Third-party web APIs were used to obtain location data, and as a result of the study, methodologies were defined to convert location data into meaningful insights by using statistical methods like weighted sum and the analytical hierarchy process. The functionalities in the proposed system have been designed, considering the roles of both buyers and sellers in the real estate business. In the proposed system, the location quality index framework provides overall insights on the location, the personalized insights and alternative locations are generated via the personal preference-based suitability analyzer and the price prediction system provides the current and future price fluctuations. The usefulness of image processing technologies and machine learning for making the sellers’ journey easier on a real estate platform has also been assessed.},
  doi       = {10.1109/ICOSEC54921.2022.9952023},
  keywords  = {Industries;Fluctuations;Statistical analysis;Image processing;Machine learning;Analytic hierarchy process;Electronic commerce;Location intelligence;Real estate decision support;Spatial decision making;Residential choice;Location analytics},
}

@InProceedings{Pangaribuan2025,
  author    = {Pangaribuan, Jefri Junifer and Nababan, Adli Abdillah and Zarqan, Ince Ahmad and Nugraha, Dimas Yudistira and Hansopaheluwakan, Scherly and Sihotang, Fernando},
  booktitle = {2025 5th International Conference of Science and Information Technology in Smart Administration (ICSINTESA)},
  title     = {Application of the Spectral Clustering Method for Identifying Commodity Price Patterns},
  year      = {2025},
  month     = {Nov},
  pages     = {672-677},
  abstract  = {Commodity markets are a vital component of the global economy, yet accurately anticipating their volatile price movements is a persistent challenge. This volatility necessitates advanced analytical methods to uncover non-obvious relationships. This research explores the application of Spectral Clustering, an unsupervised learning technique, to identify hidden patterns within a historical dataset of 23 commodities (energy, metals, agriculture). A rigorous methodology was employed, beginning with data preprocessing, including outlier removal (reducing the dataset from 6092 to 3472 entries) and normalization using StandardScaler. Principal Component Analysis (PCA) was applied for dimensionality reduction. This transformed data was used to construct a cosine similarity matrix and model an eigenspace for the Spectral Clustering algorithm. To quantify performance in the absence of ground truth, cluster assignments were evaluated against statistical price tiers derived from data percentiles. The study's key finding demonstrates that model performance is critically dependent on the selected number of clusters (k). An initial model configured with 3 clusters performed poorly against ternary tiers, achieving an accuracy of only 30% for 'Natural Gas'. However, upon optimization to 2 clusters, the model's performance improved dramatically. The accuracy for 'Natural Gas' rose to 65%, while 'corn' increased to 75%. This research concludes that Spectral Clustering is a viable method for identifying underlying binary patterns in commodity price data, contingent on proper parameter configuration.},
  doi       = {10.1109/ICSINTESA68165.2025.11413631},
  groups    = {Suporte à Decisão Agrícola},
  keywords  = {Dimensionality reduction;Accuracy;Clustering methods;Metals;Data models;Information technology;Natural gas;Unsupervised learning;Optimization;Principal component analysis;Clustering;Spectral Clustering;Commodity Prices;Data Mining;Price Prediction},
}

@InProceedings{Sudarshan2025,
  author    = {Sudarshan, K and Sharan Karthik, S and Sudha, K.},
  booktitle = {2025 10th International Conference on Smart Structures and Systems (ICSSS)},
  title     = {Ensemble-Based Gold Price Prediction Using Super Learner},
  year      = {2025},
  month     = {Dec},
  pages     = {1-7},
  abstract  = {Proper prediction of gold prices is essential as a risk management tool, portfolio optimization, and strategic financial planning- Gold is one of the most prominent assets in global financial markets because of its status as a safe-haven, inflation-hedge, and long-term value holding asset. To solve the intrinsic instability of large fluxes and a complex dynamic of the gold prices, the given paper proposes a complex pattern of a gold price prediction with the help of a Super Learner ensemble model which is the system based on several algorithms and able to take advantage of the strengths of each separately and reduce the drawbacks of each. The model integrates five different learners- Linear Regression (LR), Random Forest (RF), Gradient Boosting Machine (GBM), Support Vector Regression (SVR), and K-Nearest Neighbors (KNN) each having its own strength in terms of predictivity of the model owing to the types of assumptions that they make as well as their predictive algorithms. indexes, stock market indexes, and exchange rates. Each entity base learner would be trained on this augmented database, where the non-linear patterns and linear relations were capture, and the metalearner of the ensemble would cumulative these estimations in a stacking design with cross-validation to decrease overfitting and raise the degree to which it would represent the general population. The performance of the Super Learner uses extensive evaluation metrics, such as Mean Squared Error (MSE), Root Mean Squared Error (RMSE), and Rsquared ($\mathbf{R}^{\mathbf{2}}$), thereby validating the greater effectiveness of ensemble learning to address complex forecasting requirements within a financial setting.},
  doi       = {10.1109/ICSSS66939.2025.11346376},
  keywords  = {Support vector machines;Radio frequency;Gold;Machine learning algorithms;Predictive models;Nearest neighbor methods;Prediction algorithms;Boosting;Risk management;Random forests;gold price forecasting;Super Learner ensemble model;Random Forest (RF);Gradient Boosting Machine (GBM);Support Vector Regression (SVR);macroeconomic indicators;financial risk management},
}

