}

@InProceedings{Li2022b,
  author    = {Li, Kaiye},
  booktitle = {2022 IEEE International Conference on Artificial Intelligence and Computer Applications (ICAICA)},
  title     = {Predicting Stock Price Using Convolutional Neural Network},
  year      = {2022},
  month     = {June},
  pages     = {739-742},
  abstract  = {For academics, predicting stock price based on raw data attributes has been a major yet difficult job. Most studies of stock price prediction concentrate on individual stocks, overlooking the link between similar stocks throughout the whole stock market. This study presents a clustering approach for mining related stocks. C-HTM is an online learning algorithm that uses Hierarchical temporal memory (HTM) to learn trends from comparable stocks and then forecast them. C-HTM has superior forecast accuracy than HTM, which has not learnt similar stock patterns, and its performance in terms of short-term prediction is better than the baseline models.},
  doi       = {10.1109/ICAICA54878.2022.9844607},
  keywords  = {Knowledge engineering;Training;Convolution;Computational modeling;Semantics;Predictive models;Prediction algorithms;Stock Prediction;Machine Learning;Convolutional Neural Network},
}

@InProceedings{Ahmed2025,
  author    = {Ahmed, Khandakar Rabbi and Sizan, Mir Mohtasam Hossain and Chouksey, Anchala and Montaser, Md Abdullah Al and Islam, Md Rafiqul and Islam, Md Shahidul},
  booktitle = {2025 International Conference on Networks and Cryptology (NETCRYPT)},
  title     = {AI for Financial Market Prediction: Machine Learning Models for Stock Price Forecasting},
  year      = {2025},
  month     = {May},
  pages     = {739-744},
  abstract  = {Stock market prediction is a complex and challenging task due to financial markets' volatility, uncertainty, and sensitivity. Conventional forecasting methods, namely fundamental and technical analysis, do not fundamentally consider the complex patterns, nonlinearity, and interdependent dynamics that drive stock price movements. In this work, we introduce a novel hybrid AIdriven method that aims to enhance predictive accuracy and reliability via an ensemble prediction model where the contributions of distinct ML models, Random Forest, XGBoost, Support Vector Machine (SVM), and Light GBM, combine. It highlights the necessity for good data cleaning, feature selection, and optimization of relevant financial indicators with minimum noise and discrepancies in data. Based on the results, through repetitive performance testing, Random Forest outperformed the other models with an $\mathrm{R}^{2}$ value of 0.9789, Mean Squared Error (MSE) value of 83722.04, and Mean Absolute Error (MAE) value of 25000.50 proved its reliability over the stock market dataset reflecting its ability to predict stable outcomes. The dualism significantly improves predictive stability and generalization, countering blocking problems such as overfitting and sensitivity to market turbulence. The study suggests potential areas for future research, such as adding deep learning approaches to improve prediction accuracy and employing real-time processing of financial data to enhance model adaptability. This research adds to the portfolio of AI-driven financial analytics, highlighting the capacity of integrated machine learning algorithms in predicting stock market trends and aiding investors in more accurately assessing their investment trajectories.},
  doi       = {10.1109/NETCRYPT65877.2025.11102142},
  keywords  = {Support vector machines;Adaptation models;Accuracy;Uncertainty;Predictive models;Real-time systems;Data models;Stock markets;Forecasting;Random forests;Stock Price Forecasting;Machine Learning;Random Forest;Time-Series Analysis;UNIQLO Dataset;Mean Squared Error (MSE);Mean Absolute Error (MAE);$R^{2}$ Score;Predictive Analytics;Financial Market Prediction},
}

@InProceedings{Ramachandran2026,
  author    = {Ramachandran, V. and Muthukumar, S. and Divyapushpalakshmi, M. and Thiruselvan, S. and Stalin, J. and Balaji, V.},
  booktitle = {2026 International Conference on Advanced Computing and Knowledge Engineering (ICACKE)},
  title     = {Bi-Directional LSTM for Forecasting Agricultural Commodity Prices Using Government Open Data},
  year      = {2026},
  month     = {July},
  pages     = {1-6},
  abstract  = {One of the difficulties of farming is price volatility. While grain is being seeded, its price is likely to drop to near zero by harvest. This is one of many reasons that small and marginal farmers in India choose suboptimal crops, causing them to lose out on profits. This paper discussed the benefits of using data to integrate deep learning with public data in order to improve agriculture’s sustainability and adaptability. In this work, I show that I am using Bi-LSTM neural networks to predict commodity prices from open government data from India’s data project on its government portal (data.gov.in). These model takes into account the temporal dependence of the input (forward and backward) which gives myriad of intricately granularity to myriad actors in a volatile and ever- evolving market. To train the Bi-LSTM model, I collected and preprocessed raw data of rural commodities (cit), including cereals, pulses, and spices. Once the size of the data was accounted for, then model performance was based on a standard evaluation of MAE and RMSE at the error level. The resultsof the implementation clearly depicts that Bi-LSTM forecasts better than ARIMA, while parsing out directions to trends, and grappling with nonlinear patterns in commodity price development, while user to user variability was also managed. The predictive performance of the model is validated using visual comparisons of predicted prices, to actual prices; as well as through forecasting for short term predictions, while comparing the trend detection power of our model. By utilizing this model an agricultural planning or decision-making application, the farmer may make a more informed decision before sowing, which can influence profit margins and lower their vulnerability to market based risk.},
  doi       = {10.1109/ICACKE65470.2026.11651173},
  keywords  = {Modeling;Pricing;Long short term memory;Bismuth;Business intelligence;Forecasting;Machine learning;Crops;Training;Deep learning;Agricultural commodity Price Forecasting;ARIMA;Bi-Directional LSTM;Open Government Data},
}

@InProceedings{AbdualSalam2010,
  author    = {Abdual-Salam, Mustafa E. and Abdul-Kader, Hatem M. and Abdel-Wahed, Waiel F.},
  booktitle = {2010 The 7th International Conference on Informatics and Systems (INFOS)},
  title     = {Comparative study between Differential Evolution and Particle Swarm Optimization algorithms in training of feed-forward neural network for stock price prediction},
  year      = {2010},
  month     = {March},
  pages     = {1-8},
  abstract  = {This paper presents a comparison between two stochastic, population based and real-valued algorithms. These algorithms are namely Differential Evolution (DE) and Particle Swarm Optimization (PSO). These algorithms are used in the training of feed-forward neural network to be used in the prediction of the daily stock market prices. Stock market prediction is the act of trying to determine the future value of a company stock or other financial instrument traded on a financial exchange. The successful prediction of a stock's future price could yield significant profit. The feasibility, effectiveness and generic nature of both DE and PSO algorithms are demonstrated. These algorithms are proposed to solve the problems of traditional training techniques like local minima and overfitting. Comparisons were made between the two approaches in terms of the prediction accuracy, convergence speed and generalization ability. The proposed model is based on the study of historical data, technical indicators and the application of Neural Networks trained with DE and PSO algorithms. The simulation results presented in this paper show the potential of both two algorithms in solving the problems of traditional training techniques. DE algorithm is better than PSO algorithm in prediction accuracy, convergence speed and handling fluctuated stock time series.},
  keywords  = {Particle swarm optimization;Feedforward systems;Neural networks;Feedforward neural networks;Stock markets;Accuracy;Convergence;Stochastic processes;Instruments;Prediction algorithms;Evolutionary algorithms;Differential evolution;Particle swarm optimization;feed-forward neural network;technical indicators;stock prediction},
}

@InProceedings{Gulati2022,
  author    = {Gulati, Kamal and Gupta, Jyoti and Rani, Lekha and Sarangi, Pradeepta kumar},
  booktitle = {2022 10th International Conference on Reliability, Infocom Technologies and Optimization (Trends and Future Directions) (ICRITO)},
  title     = {Crude Oil Prices Predictions in India Using Machine Learning based Hybrid Model},
  year      = {2022},
  month     = {Oct},
  pages     = {1-6},
  abstract  = {Crude oil is a crucial fuel and one of the world's most important resources, and its prices have a direct impact on the global economy, habitat, oil exploration, and other activities. Crude oil is an important factor in any economy in today's modern world. Pandemics have increased the volatility of oil prices in recent years, necessitating the development of a new intelligent method for predicting long-term pricing. The ANN and ANN-PSO algorithms are used to forecast crude oil prices in this research. The artificial neural network (ANN) can be an accurate and efficient prediction approach. This work implements two machine learning models namely ANN and a hybrid model ANN - PSO to predict the future crude oil price. The data used in this work is for the period from January 2019 to April 2022. Results obtained from the Particle Swarm Optimization Model (ANN-PSO) has been compared with the results obtained from the implementation of Artificial Neural Networks (ANN). The results of this study's experiments confirmed that the ANN-PSO model can accurately predict long-term crude oil prices. Furthermore, more precise forecasting will assist investors in earning more, resulting in considerable long-term profits and have a direct impact on the economy.},
  doi       = {10.1109/ICRITO56286.2022.9964577},
  keywords  = {Biological system modeling;Oils;Artificial neural networks;Machine learning;Pricing;Predictive models;Prediction algorithms;Crude oil;prediction;ANN;ANN-PSO;Hybrid model;Price-prediction Machine learning},
}

@InProceedings{M2024,
  author    = {M, Sowmya and Al-Farouni, Mohammed and Reddy Panga, Naresh Kumar and Indira, R and Saranya, N. Naga},
  booktitle = {2024 International Conference on Intelligent Algorithms for Computational Intelligence Systems (IACIS)},
  title     = {Stock Price Prediction using Bi-directional Long-Short Term Memory based Deep Neural Network},
  year      = {2024},
  month     = {Aug},
  pages     = {1-4},
  abstract  = {In the area of finance, forecasting of stock price is becoming very popular increasingly. Predicting the stock price of a firm is very important to increase speculators interest in investing for a company and for growth of shareholders in that stock. In addition to a unique investment portfolio model based on the projections produced, this article suggests a novel method for time-series stock price prediction. To achieve this, a Bidirectional Long-Short Term Memory-based Deep Neural Network (Bi-LSTM-DNN) is equipped with novel regression technique. Once made, the predictions are utilized to build investment portfolio, more precisely, a projected portfolio. Numerous tests have been conducted using NIFTY-50 stock data that was acquired from Indian National Stock Exchange. The outcomes verify that suggested model performs better than a number of conventional prediction models and a number of conventional portfolio optimization algorithms. Reducing investing risks and increasing rewards are possible with an accurate stock price prediction. The Root Mean Square Error (RMSE) value for the proposed deep learning network for stock prediction using Bi-LSTM-DNN is 0.81.},
  doi       = {10.1109/IACIS61494.2024.10721651},
  keywords  = {Deep learning;Accuracy;Computational modeling;Atmospheric modeling;Predictive models;Prediction algorithms;Stock markets;Forecasting;Portfolios;Investment;bidirectional long short-term memory;deep neural network;deep learning;indian national stock exchange;stock prediction},
}

@InProceedings{Dey2025,
  author    = {Dey, Maloy Kumar and Dey, Shouvik},
  booktitle = {2025 International Conference on Computing, Intelligence, and Application (CIACON)},
  title     = {Optimized Stock Price Forecasting: A Deep Learning Approach Using QCTO Based GRU Network},
  year      = {2025},
  month     = {July},
  pages     = {1-6},
  abstract  = {Stock represents ownership in a publicly traded company and stock price is the current market value of a company’s stock. It fluctuates based on factors such as supply and demand, company performance, and overall market conditions. Predicting accurate stock price is the basic task of every trader and investor to gain profit from the financial market. Traditional trend prediction models are generally based on experts knowledge and experience. Often, it is difficult to find out hidden patterns contained in the stock time series data due to its inherent volatility and complexity. To address this issue, a Quantum Class Topper Optimization based Gated Recurrent Unit (QCTO-GRU) model is proposed to predict stock price movement, highlighting its ability to capture intricate patterns in dynamic market conditions. The parameters of GRU model are optimized using QCTO, a meta-heuristic optimization technique. The proposed model excels in predicting the stock price and outperforms the existing models with the value of 0.01271 and 0.00975 for MAE and MSE respectively.},
  doi       = {10.1109/CIACON65473.2025.11189776},
  keywords  = {Accuracy;Supply and demand;Quantum computing;Computational modeling;Time series analysis;Gated recurrent units;Companies;Predictive models;Stability analysis;Forecasting;Stock Price Prediction;Gated Recurrent Unit;Quantum Computing;Class Topper Optimization},
}

@InProceedings{Arnold2026,
  author    = {Arnold, J. and FD, Abinesh and M, Reethiga and Genitha, C. Heltin},
  booktitle = {2026 International Conference on Computer Networks and Inventive Communication Technologies (ICCNCT)},
  title     = {Multi-Modal Hybrid Attention-based LSTM-CNN Framework for Real-Time Gold Price Forecasting},
  year      = {2026},
  month     = {May},
  pages     = {1648-1653},
  abstract  = {The international financial system relies heavily upon gold, both as a main source of investment and also as a hedge against unpredictable changes. The large demand for this specific asset along with its fluctuating price (based upon an ever-increasing number of variables) makes accurate forecasting a challenging issue; these variables are defined by future inflation rates, currency fluctuation rates, and changes in political landscapes. Traditionally, financial analysts utilize Linear Regression, Decision Tree, and Random Forest, derive inferences by interpreting complex transactional relationships. However, the aforementioned models typically under-represent the time-dependent nature of financial time-series data. Our ML model/algorithm is a multi-modal hybrid deep learning model combining Convolutional Neural Networks (CNN) to extract static numerical sequences used for making decisions with Long Term (LSTM) Memory Networks. This was done to overcome the limitations related to using only static numeric data. This model utilizes both structured macroeconomic indicator data in addition to real-time sentiment analysis of global financial markets, from relevant news articles, to generate decisions as input data. We conducted experimental evaluation in order to benchmark our multi-modal hybrid design against several traditional ensemble-classifiers; and observed that there was an average decrease of 4.5% in RMSE and an increase of 6.8% in R-Squared for our architecture compared to the other classifiers. Additionally, we demonstrated the ability for real-time forecasting and dynamic risk visualization via a cloud-based interactive interface; thereby supporting our claim that we have produced a valid and reliable decision support tool in the context of rapidly evolving and highly volatile financial markets.},
  doi       = {10.1109/ICCNCT68477.2026.11590615},
  keywords  = {Modeling;Pricing;Gold;Machine learning;Timing;Machining;Forecasting;Long short term memory;Convolutional neural networks;Random forests;LSTM;CNN;Attention Mechanism;Gold Price Prediction;Sentiment Analysis;Hybrid Learning;Financial Forecasting;Real-time Decision Support},
}

@Article{Anamika2018,
  author   = {Anamika and Peesapati, Rajagopal and Kumar, Niranjan},
  journal  = {IEEE Systems Journal},
  title    = {Electricity Price Forecasting and Classification Through Wavelet–Dynamic Weighted PSO–FFNN Approach},
  year     = {2018},
  issn     = {1937-9234},
  month    = {Dec},
  number   = {4},
  pages    = {3075-3084},
  volume   = {12},
  abstract = {In competitive electricity markets, accurate price forecasting is required to both power producers and consumers for planning their bidding strategies in order to maximize their own benefits. Price classification is an alternative approach to forecasting where the exact values of future prices are not mandatory. Presently, two efficient algorithms are proposed for both short term price forecasting (STPF) and classification (STPC) purposes. The algorithms include various methodologies like wavelet transform (WT), fuzzy adaptive particle swarm optimization (FA-PSO) and feed forward neural networks (FFNN). WT is utilized to convert the pathetic price series to an inviolable price series without losing the originality in the signal. Standard PSO (S-PSO) is implemented to tune the fixed architecture FFNN weights and biases. In the present nonlinear problem, linear variation of inertia weight does not resemble exact search process. Hence, dynamic inertia weight is accomplished by implementing the fuzzy systems in the S-PSO approach. The hybrid methodology is implemented on Spanish electricity markets for the year 2002. To validate, three types of price classes and historical price series that are utilized by many researches as input features, are considered. Various statistical indicators are evaluated to compare and validate the proposed approaches with the past approaches available in the literature survey.},
  doi      = {10.1109/JSYST.2017.2717446},
  keywords = {Forecasting;Neurons;Artificial neural networks;Autoregressive processes;Predictive models;Computational modeling;Biological system modeling;Forecasting;fuzzy systems;neural networks (NN);particle swarm optimization (PSO);wavelet transform (WT)},
}

@InProceedings{Lee2025,
  author    = {Lee, Jae Yoo and Yoo, Seong Joon},
  booktitle = {2025 International Conference on Artificial Intelligence in Information and Communication (ICAIIC)},
  title     = {Stock Price Prediction Using Transformer and Time2Vec},
  year      = {2025},
  month     = {Feb},
  pages     = {0687-0689},
  abstract  = {Stock price prediction is a challenging task due to the complex, non-linear, and dynamic nature of financial markets. In this study, we propose a novel deep learning architecture that leverages the strengths of Transformer models and Time2Vec to capture the spatiotemporal dependencies inherent in stock market data. Our model incorporates temporal encoding via Time2Vec to effectively model periodic patterns and employs Transformer layers to extract high-level spatial and temporal features. By integrating these components, we aim to improve prediction accuracy and model interpretability compared to traditional time-series forecasting methods. Extensive experiments on benchmark stock market datasets demonstrate the superiority of our approach in terms of both predictive performance and robustness, offering significant implications for algorithmic trading and financial analysis.},
  doi       = {10.1109/ICAIIC64266.2025.10920805},
  issn      = {2831-6983},
  keywords  = {Deep learning;Predictive models;Transformers;Feature extraction;Prediction algorithms;Robustness;Encoding;Spatiotemporal phenomena;Stock markets;Forecasting;Time2Vec;Transformer Architecture;Stock Price Prediction;Deep Learning},
}

@InProceedings{Kazeminia2023,
  author    = {Kazeminia, Saman and Sajedi, Hedieh and Arjmand, Masoud},
  booktitle = {2023 9th International Conference on Web Research (ICWR)},
  title     = {Real-Time Bitcoin Price Prediction Using Hybrid 2D-CNN LSTM Model},
  year      = {2023},
  month     = {May},
  pages     = {173-178},
  abstract  = {Due to the growing importance of the cryptocurrency market, as well as the diversity and expansion of online trading platforms, cryptocurrency technology has piqued the curiosity of a wide range of people, from market traders to researchers and analysts. Reliable price prediction is a necessity since investors face multiple challenges including market volatility, risk management, and market complexity. Therefore, numerous studies have been done using deep learning and machine learning algorithms to demonstrate their functionality and efficiency in this area. In this paper, we employed Bitcoin historical data to make predictions for the next day's closing price using a new hybrid 2D-CNNLSTM model with OPTUNA hyperparameter tuning. The dataset used to train the model was gathered using an automated web scraping technique. With the proposed model, the R2 error achieved 0.98166 and the MAPE was 0.034. Our proposed model is compared with three different models: CNN, LSTM, and GRU. The predicted results show that the proposed hybrid model is efficient for accurately predicting bitcoin prices and reliable for supporting investors to make their informed investment decisions. Additionally, the proposed model has outperformed other commonly used algorithms, namely CNN, LSTM, and GRU in terms of R2, and MAPE. This model is also capable of performing real-time forecasting.},
  doi       = {10.1109/ICWR57742.2023.10139275},
  keywords  = {Deep learning;Bitcoin;Predictive models;Feature extraction;Data models;Real-time systems;Reliability;Price Prediction;Bitcoin;CNN;LSTM;Deep Learning},
}

