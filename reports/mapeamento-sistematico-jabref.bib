  pages                  = {1-5},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {Int. Conf. Integr. Intell. Commun. Syst., ICIICS},
  abstract               = {Accurate short-term price forecasting is critical for mitigating income volatility faced by smallholder farmers in Indian agricultural markets. This paper presents a TCN-enhanced stacked ensemble framework for forecasting olericulture crop prices using multi-source mandi data from 2019-2024. The proposed model integrates temporal convolutional networks with machine learning and statistical forecasters, while incorporating uncertainty quantification through conformal prediction. Experiments across multiple commodities and markets demonstrate that the proposed approach consistently outperforms strong baseline models, achieving 15-20% lower forecasting error in terms of MAPE. The resulting uncertainty intervals exhibit reliable empirical coverage under both stable and volatile market conditions. These results indicate that the framework can support more informed price-aware decision-making in real agricultural settings. © 2026 IEEE.},
  affiliations           = {Artificial Intelligence and Machine Learning, Dept. of Computer Science and Engineering, KG Reddy College of Engineering and Technology, Hyderabad, India; KG Reddy College of Engineering and Technology, Dept. of Computer Science and Engineering, (AIML), Hyderabad, India},
