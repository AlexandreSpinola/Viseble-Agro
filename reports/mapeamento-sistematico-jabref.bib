@InProceedings{Panwar2024,
  author    = {Panwar, Vinita and Kumar Tayal, Devendra},
  booktitle = {2024 International Conference on Computing, Sciences and Communications (ICCSC)},
  title     = {Stock Price Prediction with Fine Tuning of Support Vector Machine Using Sea Lion Optimization},
  year      = {2024},
  month     = {Oct},
  pages     = {1-5},
  abstract  = {One of the most prominent exercises people do is foresee the stock market. While attempting to predict an exact price of the stock is a futile attempt, we can accurately identify the direction, in which the stock price will move. A large number of the elements that influence the stock market come in the form of news items. Because traders are quickly swayed by what they read, the sentiments that users derive from news headlines have a significant impact on their purchasing and selling behaviors. Our research presents a hybrid technique that integrates the Support Vector Machine (SVM) and Sea Lion optimization algorithm (SLnO). Hyperparameters (kernel function, Regularization parameter, Kernel coefficient) of SVM are optimized using SLnO. Optimized SVM is employed to foresee the intraday close price movement. We have used Nifty 50 historical data from Yahoo Finance and sentiment scores from news headlines aggregated from Pulse (Pulse by Zerodha,2020) to assess the proposed hybrid strategy. According to the experimental findings, the hybrid SVM and SLnO model performs better than the benchmark model.},
  doi       = {10.1109/ICCSC62048.2024.10830439},
  keywords  = {Support vector machines;Machine learning algorithms;Predictive models;Market research;Vectors;Stock markets;Marine animals;Kernel;Optimization;Tuning;Machine learning;support vector machine;sea lion optimization algorithm;stock market;forecasting;intraday;close price movement;hyperparameters optimization},
}

@InProceedings{More2026,
  author    = {More, Aatish and Chaudhari, Smita and Patil, Swati and Sharma, Rishi and Giri, Yuvraj and Dusane, Niharika},
  booktitle = {2026 International Conference on Sustainable and Futuristic Technologies (ICSFT)},
  title     = {Krishimitra: A Vision for Predicting Agricultural Commodity Prices in India: Using Single-Layer Transformer Convolutional Encoder (STCE)},
  year      = {2026},
  month     = {April},
  pages     = {1-8},
  abstract  = {This paper presents Krishimitra, an India- centric agrarian soothsaying system powered by artificial intelligence. The platform predicts request trends for crucial agrarian goods by combining sphere moxie, literal request records, and a coldblooded deep- literacy frame. At the core of Krishimitra is the Single- Subcaste Motor Convolutional Encoder(STCE), a neural armature designed to capture both long- term temporal patterns and short- term spatial variations within multivariate time- series data. The proposed system preprocesses raw request aqueducts, generates sliding- window sequences, applies one- dimensional convolutional networks for point birth, and employs a featherlight motor encoder to identify temporal dependences. STCE is estimated against traditional models similar as ARIMA and deep- literacy nascences like LSTM for major goods including soybean, wheat, sugarcane, and sludge, using RMSE, MAE, and MAPE as performance pointers. Experimental results indicate that STCE delivers significantly advanced vaticination delicacy with comparatively lower computational conditions, making it suitable for edge bias and planter- acquainted digital dashboards. To enhance availability, the Krishimitra platform is available in both English and Marathi, icing that growers from different verbal backgrounds can profit from its perceptivity.},
  doi       = {10.1109/ICSFT67370.2026.11566634},
  keywords  = {Modeling;Pricing;Timing;Motors;Convolutional neural networks;Training;Printing;Forecasting;Long short term memory;Armature;Commodity Price Prediction;Transformer;CNN;LSTM;ARIMA;Deep Learning;Agriculture;Time Series Forecasting},
}

@Article{Chou2018,
  author   = {Chou, Jui-Sheng and Nguyen, Thi-Kha},
  journal  = {IEEE Transactions on Industrial Informatics},
  title    = {Forward Forecast of Stock Price Using Sliding-Window Metaheuristic-Optimized Machine-Learning Regression},
  year     = {2018},
  issn     = {1941-0050},
  month    = {July},
  number   = {7},
  pages    = {3132-3142},
  volume   = {14},
  abstract = {Time series forecasting has been widely used to determine the future prices of stock, and the analysis and modeling of finance time series importantly guide investors' decisions and trades. In addition, in a dynamic environment such as the stock market, the nonlinearity of the time series is pronounced, immediately affecting the efficacy of stock price forecasts. Thus, this paper proposes an intelligent time series prediction system that uses sliding-window metaheuristic optimization for the purpose of predicting the stock prices of Taiwan construction companies one step ahead. It may be of great interest to home brokers who do not possess sufficient knowledge to invest in such companies. The system has a graphical user interface and functions as a stand-alone application. The developed hybrid system exhibited outstanding prediction performance and it improves overall profit for investment performance. The proposed model is a promising predictive technique for highly nonlinear time series, whose patterns are difficult to capture by traditional models.},
  doi      = {10.1109/TII.2018.2794389},
  keywords = {Forecasting;Time series analysis;Optimization;Predictive models;Prediction algorithms;Companies;Support vector machines;Construction company;data mining;machine learning (ML);prediction system;sliding window;stock price forecasting;swarm intelligence and metaheuristic optimization;time series},
}

@InProceedings{ShyamalaDevi2022,
  author    = {Shyamala Devi, M. and Arun Pandian, J. and Srinivas Vara Prasad Korlam, Sai and Manideep Reddy, Sripathi},
  booktitle = {2022 3rd International Conference on Computing, Analytics and Networks (ICAN)},
  title     = {Two Layered Deep Long Short-Term Memory Network based Gold Rate Divination},
  year      = {2022},
  month     = {Nov},
  pages     = {1-5},
  abstract  = {From the moment of its discovery, gold has been the most significant and valuable commodity. The exact forecasting of gold price in the market remains a major challenge for the researchers to focus upon. With this motivation, this paper propose a novel Dual Coping Deep Long Short-Term Memory Network to forecast the gold price with minimum mean squared error. The model utilize the Daily gold price historical dataset retrieved from the KAGGLE machine-learning repository. The Daily gold price historical dataset contains 7 features with 5837 gold price details and is processed with missing values and encoding. The exploratory data analysis have done to visualize how the independent features are related to the gold price. The proposed Dual Coping Deep Long Short-Term Memory (DC-DLSTM) Network had designed with two LSTM overlay that recognizes short- and long-term relationships and convolutional layers retrieves the meaningful information from time-series gold price data and comprehending its internal representation. The Daily gold price historical data have applied to proposed model, same data was applied to other regressor models, and the performance metrics was analyzed. Implementation was scripted using python through NVidia Tesla V100 GPU workstation with 30 training epochs and batch size of 64. The performance metrics utilized for analysis are Mean squared error. Experimental results shows that the proposed DC-DLSTM shows the least mean squared error of 0.0013 when compared with other regressor models.},
  doi       = {10.1109/ICAN56228.2022.10007212},
  keywords  = {Training;Measurement;Gold;Analytical models;Computational modeling;Graphics processing units;Data models;LSTM;convolution;dependency;MSE;regressor;accuracy},
}

@InProceedings{Prasad2026,
  author    = {Prasad, R Vara and Krishna, Bathula Sai and Mahesh, Kammampalli Durga and Kumar, Jammula Hemanth and Kumar, Gongati Pavan},
  booktitle = {2026 9th International Conference on Electronics, Materials Engineering & Nano-Technology (IEMENTech)},
  title     = {AI for Agri: Intelligent Platform for Crop Forecasting and Farmer-Vendor Interaction},
  year      = {2026},
  month     = {Feb},
  pages     = {1-6},
  volume    = {9},
  abstract  = {Agriculture remains the fundamental economic pillar for developing nations, yet smallholder farmers continue to grapple with severe information asymmetry, dependence on exploitative intermediaries, and the increasing volatility of climate patterns. While digital marketplaces have been proposed as a solution, most current systems are either too complex for rural deployment or lack intelligent decision support mechanisms. The paper describes AI for Agri, a lightweight yet comprehensive digital system that enables direct interaction between plantation growers (farmers) and sellers. This is achieved through forecasted planting schedules and real time climate advice based on historical weather data. Based on Node.js and MySQL and utilizing machine learning regression algorithms - Random Forest and Linear Regression - we've developed a scalable system that provides its users with price visibility (transparency) and the ability to forecast product demand. Our experimental results demonstrate that using our Digital Agricultural System (AI for Agri) promotes and supports the price discovery process (by reducing transaction costs and eliminating unnecessary supply chain intermediaries) while providing a platform with $92 \%+$ accuracy in predicting crop pricing. In addition, this system has been designed with mobile and rural access in mind and will be suitable for use in low bandwidth environments.},
  doi       = {10.1109/IEMENTech202669403.2026.11433981},
  issn      = {2767-9934},
  keywords  = {Weather;Smart agriculture;Schedules;Climate;Supply chains;Crops;Weather forecasting;Market research;Real-time systems;Forecasting;Digital agriculture;crop forecasting;farmer-vendor interaction;artificial intelligence;e-marketplace;price transparency;machine learning},
}

@InProceedings{Sugimoto2007,
  author    = {Sugimoto, Junjiro and Isa, Aishah Mohd and Yokoyama, Ryuichi},
  booktitle = {2007 IEEE Power Engineering Society General Meeting},
  title     = {Profit-oriented Thermal Unit Maintenance Scheduling under Competitive Environment},
  year      = {2007},
  month     = {June},
  pages     = {1-6},
  abstract  = {In this paper, an improved maintenance scheduling approach suitable for the competitive environment is proposed by taking account of profits and costs of generation companies and the formulated combinatorial optimization problem is solved by using Reactive Tabu search (RTS) In competitive power markets, electricity prices are determined by balance between demand and supply in electric power exchanges or bilateral contracts. Therefore it is essential for system operation planners and market participants to take the volatility of electricity price into consideration. In the proposed maintenance scheduling method, firstly, electricity prices are forecasted for the targeted period using proposed aggregated bidding model. Secondly, the optimal combinatorial maintenance-scheduling problem is solved by using Reactive Tabu Search in the light of the electricity prices forecasted. This method proposes a new objective function by which the most profitable maintenance schedule would be attained. As an objective function, Opportunity Loss of Maintenance (OLM) is adopted to maximize the profit of Generation Companies (GENCOS). Finally, the proposed maintenance scheduling is applied to a practical power system test model to verify the advantages and effectiveness of the method.},
  doi       = {10.1109/PES.2007.386099},
  issn      = {1932-5517},
  keywords  = {Power generation;Job shop scheduling;Economic forecasting;Power system modeling;Electricity supply industry;Preventive maintenance;Power system planning;Power markets;Predictive models;Fuels;Power Generation Maintenance;Tabu Search;Electricity Market;Electricity Price Forecasting;Artificial Neural Network},
}

@InProceedings{SinghJatav2026,
  author    = {Singh Jatav, Divyaraj and Amin, Md Maksudul and Arifin Shawn, MD Asadul and Shah, Anuj Kumar and Shah, Harshal},
  booktitle = {2026 Innovations in Machine, Engineering, and Digital Conference (IMED)},
  title     = {Cloud-Powered Financial Stress Testing Using Deep Learning on Large-Scale Market Data},
  year      = {2026},
  month     = {March},
  pages     = {1-6},
  abstract  = {Financial stress testing is a critical part of risk management in financial institutions and is used in measuring systematic exposure of portfolios to increased market extremity. This testing contributes to the resilience of institutional structures to systemic shocks by strictly testing their exposure to adverse situations. The current models of analysis, however, often face limitations with their ability to handle and analyze large datasets of markets in cloud environments, especially when it comes to trying to capture the complex, non-linear dynamics of financial time series. These obstacles hinder the sound assessment of risk in extreme circumstances. To overcome these challenges, this paper proposes a cloud-based financial stress-testing system that uses the deep learning approaches to predict price dynamics during historically bad market events. At the center of this model is a variant of a chimp optimization (MCO) algorithm, which is utilized to facilitate the simplification of data management and preprocessing within a distributed cloud setting, therefore, guaranteeing flawless handing of large historical market repositories. Pre-trained deep-learning models are used to help extract features, including subtle market trends and anomalies, and a convex recurrent neural network (CRNN) is used to learn time-dependent relationships and forecast price changes when in stressed conditions. The effectiveness of the suggested system was empirically checked with the help of the data set containing 296 historical extreme events of the Dalian Commodity Exchange (DCE) market during the period between 4 January 2016 and 31 December 2021.},
  doi       = {10.1109/IMED68921.2026.11484378},
  keywords  = {Feeds;Filtering;Feedback;Filters;Recommender systems;Circuits;Information filtering;Internet of Things;Internet;Cloud computing;cloud computing;cloud data management;financial stress testing;deep learning;risk assessment},
}

@InProceedings{Bai2022,
  author    = {Bai, Zhenhan and Zhao, Teng and Xin, Peilin},
  booktitle = {2022 International Conference on Data Analytics, Computing and Artificial Intelligence (ICDACAI)},
  title     = {The development of daily trading strategies based on intelligent prediction models and an optimal decision-making model},
  year      = {2022},
  month     = {Aug},
  pages     = {503-507},
  abstract  = {In recent years, in pursuit of higher returns, people began to try the combination of bitcoin and gold. This study explored how to use the current and past prices of gold and bitcoin to get the best investment strategies for the next day to get the maximum return. Firstly, by preprocessing and analyzing the historical price data of gold and bitcoin in five years, the long- and short-term memory (LSTM) recurrent neural network was used to establish the price prediction models of gold and bitcoin. Secondly, the dynamic programming method was applied to transform the solution problem into the optimization problem, and the state equation of the optimal trading strategy was obtained through the determined objective function and constraint conditions. Thus, the total value of the original trading strategy determined using 1,000 $ in cash after five years of investment was calculated to be 62692.13 $. Then two methods were introduced to prove the rationality of the optimal trading strategy. Finally, the sensitivity of commission cost to trading strategies was deeply analyzed by changing the commission ratio of gold and bitcoin using the control variable method. The results show that the established price prediction models have good prediction accuracy and can accurately predict the future prices of gold and bitcoin assets. The trading strategy based on the price forecasting model and dynamic programming method can maximize the return on investment for investors. The research provides theoretical guidance for investors on choosing portfolios and trades to get the maximum return.},
  doi       = {10.1109/ICDACAI57211.2022.00106},
  keywords  = {Gold;Analytical models;Computational modeling;Decision making;Bitcoin;Predictive models;Data models;trading strategies;price prediction models;an optimal decision-making model;long- and short-term memory (LSTM) network},
}

@InProceedings{Rathod2026,
  author    = {Rathod, Sharmila and Sagale, Smruti and Sawant, Manthan and Vichare, Yash and Ugalmugale, Parth},
  booktitle = {2026 International Conference on Communication, Computing and Emerging Technologies (IC3ET)},
  title     = {AgriWave: One-Stop Platform for Every Indian Farmer's Need},
  year      = {2026},
  month     = {Feb},
  pages     = {280-285},
  abstract  = {Agriculture is a backbone of the economy in India, but farmers face recurrent problems like inadequate information access, ineffective planning for crops, market unpredictability, insufficient awareness of supportive schemes, etc. The traditional systems do not provide personalised, realtime, and technology-enabled decision support. This reduces productivity, leading to financial loss. This paper explains AgriWave, an AI-enabled platform that can give intelligent, scalable, and accessible agricultural support for the farmers. The platform uses contemporary machine learning, predictive analytics and real-time diagnostics to enable crop level recommendations, early warnings of risks, soil and weather diagnostic inputs, and supported access to habitat schemes of the government. The architecture of AgriWave is mobile-first and offline first, making it usable in low-connectivity bench environments. The support provided in local languages promotes adoption across diverse communities. There are still challenges like digital literacy and infrastructure issues, but AgriWave can form a strong base for changing the traditional practices of agriculture into data-driven and sustainable agriculture. This study highlights the potential of AI and analytics-based solutions to assist farmers, wherein timely, specific and actionable insights help in enhancing food security and promotion of rural economy in the digital age.},
  doi       = {10.1109/IC3ET64989.2026.11467468},
  groups    = {Suporte à Decisão Agrícola},
  keywords  = {Feedback;Filtering;Circuits;Filters;Recommender systems;Information filtering;Communication systems;Internet;Internet of Things;Telecommunication computing;Indian Agriculture;Farmer Support;Crop Advisory;Agricultural Technology;Artificial Intelligence;Machine Learning;Smart Agriculture;Predictive Analytics},
}

@InProceedings{Nikhil2023,
  author    = {Nikhil, Shreyas and Sah, Rahul Kumar and Kumar Parki, Santosh and Tamang, Til Bikram and D, Somashekhara Reddy. and T R, Mahesh},
  booktitle = {2023 14th International Conference on Computing Communication and Networking Technologies (ICCCNT)},
  title     = {Stock Market Prediction Using Genetic Algorithm Assisted LSTM-CNN Hybrid Model},
  year      = {2023},
  month     = {July},
  pages     = {1-6},
  abstract  = {Stock price prediction has always been a tough task for all the stakeholders involved. This paper focusses on four different models, namely LSTM, CNN, LSTM-CNN, and Genetic Algorithm-Assisted LSTM-CNN (GA-LSTM-CNN) for stock price prediction. The day-to-day stock prices of a certain company for a period of more than 10 years make up the dataset utilized in this study. Root mean square error (RMSE) has been utilized as performance metric for each model. Outcomes of our experiment show that the GA-LSTM-CNN model performed better than other models with an RMSE value of 0.0064 upon training and an RMSE value of 0.03 upon testing. The GA-LSTM-CNN model combines the strengths of LSTM as well as CNN models with the help of a genetic algorithm, which helps in optimizing the hyperparameters. According to the results, the GA-LSTM-CNN model can be very helpful for the stakeholders in predicting future stock values.},
  doi       = {10.1109/ICCCNT56998.2023.10306948},
  issn      = {2473-7674},
  keywords  = {Training;Biological system modeling;Computational modeling;Predictive models;Market research;Data models;Stakeholders;stock price prediction;deep learning;LSTM;CNN;GA;LSTM-CNN;GA-LSTM-CNN;time series forecasting;financial data;performance evaluation;RMSE;MSE loss;Adam Optimizer;training set;validation set},
}

@InProceedings{Bora2024,
  author    = {Bora, Mohit and Rawat, Praveen and Rawat, Daksh and Bhakuni, Vihan Singh and Sharma, Khushi and Das, Purushottam},
  booktitle = {2024 1st International Conference on Advanced Computing and Emerging Technologies (ACET)},
  title     = {Analyzing Market Sentiment for Gold Commodity News Through Natural Language Processing Techniques},
  year      = {2024},
  month     = {Aug},
  pages     = {1-5},
  abstract  = {This study explores how sentiment analysis methods can be applied to evaluate commodity news with a specific focus on the gold market investors and traders can understand the opinions expressed in news articles by utilizing the wealth of financial news data available to them this study examines sentiment patterns in gold-related news reports using machine learning and NLP techniques it is anticipated that the research’s conclusions will provide both business communities with new information making decisions could be made easier for traders and investors if they are aware of the relationship between news, sentiment and market dynamics. In this paper, count vectorizer has been implemented for feature extraction and machine learning classifier algorithm like random forest for sentiment analysis. Gold news is categorized as having positive, negative, neutral and no sentiment. Other performance metrics like F1 Score 73%, Recall 68% and Precision 93% were calculated for the comparison of sentiment classes. Hyperparameter tuning is employed to improve the model effectiveness. The findings demonstrate a high accuracy of 86% in sentiment analysis to predict public sentiments in commodity markets which could help stakeholders develop investment strategies.},
  doi       = {10.1109/ACET61898.2024.10730308},
  keywords  = {Measurement;Sentiment analysis;Gold;Machine learning algorithms;Heuristic algorithms;Feature extraction;Stakeholders;Tuning;Random forests;Investment},
}

@InProceedings{Matharaarachchi2026,
  author    = {Matharaarachchi, Charaka J. and Samarasinghe, Ravindu T. and Vidyasarani, G. G. T. and Fasnas, Mohamed and Siriwardana, Deemantha and Wijesooriya, Ayesha},
  booktitle = {2026 6th International Conference on Computer Communication and Artificial Intelligence (CCAI)},
  title     = {AgriSense LK: Weekly Automated Machine Learning for Sri Lankan Produce Prices with Business Continuity Plan, Market Opportunity Ranking, Cultivation Targeting, and Yield Quality Valuation},
  year      = {2026},
  month     = {May},
  pages     = {1-7},
  abstract  = {In Sri Lanka, agricultural decision-making remains largely traditional: decisions are often based on historical practices, informal consultation, and heuristic judgment. The primary barrier is that market price data is difficult to interpret without analytical expertise, resulting in unpredictable price volatility and suboptimal farmer income. AgriSense LK is a machine learning platform that converts historical price records into actionable recommendations for farmers and traders. The system comprises four components: business strategy classification, market opportunity ranking, cultivation targeting, and smartphone-based produce quality grading. The platform was trained on 123,985 real price records sourced from the Central Bank of Sri Lanka (CBSL), spanning 2017 to 2025. Key results include a MAPE 0.7% and MAE of Rs. 1.86 on weekly price forecasting (a 98.1% improvement over the naive baseline), a ROC-AUC of 0.9056 on cultivation targeting, and 91.49% crop classification accuracy with 89.84% quality grade accuracy in the computer vision component. Direct price regression over a seven-day horizon proved unreliable; a binary profitability classifier was adopted instead and substantially outperformed the regression approach. While results are promising, further validation under real-world deployment conditions is required.},
  doi       = {10.1109/CCAI69603.2026.11641892},
  groups    = {Previsão + Otimização},
  keywords  = {Modeling;Pricing;Machine learning;Crops;Printing;Training;Accuracy;Machining;Forecasting;Ranking (statistics);agricultural price prediction;machine learning;market optimization;crop recommendation;computer vision;Sri Lanka},
}

@Article{Kim2024,
  author   = {Kim, Hyung Joon and Kim, Mun Kyeom},
  journal  = {IEEE Internet of Things Journal},
  title    = {New Customized Bidirectional Real-Time Pricing Mechanism for Demand Response in Predictive Home Energy Management System},
  year     = {2024},
  issn     = {2327-4662},
  month    = {July},
  number   = {14},
  pages    = {24497-24510},
  volume   = {11},
  abstract = {The advancement of Internet of Things technologies enables precise control over home appliances, leading to a growing demand for demand response (DR) in residential areas. The electricity price mechanism has been an important means to implement residential DR, dynamically adjusting power demand to alleviate power mismatch in response to time-varying prices. However, despite various studies on pricing mechanisms, the unidirectional nature of these electricity pricing mechanisms greatly diminishes the willingness of end consumers to actively engage in housing DR as their electricity consumption behavior is not effectively reflected into their electricity pricing. To overcome these challenges, this study proposes a predictive home energy management system (PHEMS) by developing a new customized bidirectional real-time pricing (RTP) mechanism-based DR strategy along with an efficient price forecasting model. The proposed PHEMS first develops a new customized bidirectional RTP mechanism that enables the participation of end users in formulating hourly RTPs based on their hourly shifted power and household flexible appliance for strong DR participation. Second, a new deep-learning-based forecasting model, namely, unshared convolutional neural network-nested long short-term memory, is employed to address both the spatial–temporal variabilities of the real-time (RT) price and support global RT optimization. A rolling-horizon-based optimization strategy is then constructed to enable self-correction, ensuring robust and economic operation for residential end users. The experimental results demonstrate the superiority of the proposed PHEMS in terms of the forecasting accuracy, peak reduction, valley filling, and electricity cost reduction while ensuring user comfort.},
  doi      = {10.1109/JIOT.2024.3381606},
  keywords = {Pricing;Electricity;Forecasting;Predictive models;Home appliances;Real-time systems;Internet of Things;Deep learning;demand response (DR);energy management system;price forecasting;real-time pricing (RTP);rolling horizon},
}

@InProceedings{Shrivastava2014,
  author    = {Shrivastava, Nitin Anand and Khosravi, Abbas and Panigrahi, Bijaya Ketan},
  booktitle = {2014 International Joint Conference on Neural Networks (IJCNN)},
  title     = {Prediction interval estimation for electricity price and demand using support vector machines},
  year      = {2014},
  month     = {July},
  pages     = {3995-4002},
  abstract  = {Uncertainty is known to be a concomitant factor of almost all the real world commodities such as oil prices, stock prices, sales and demand of products. As a consequence, forecasting problems are becoming more and more challenging and ridden with uncertainty. Such uncertainties are generally quantified by statistical tools such as prediction intervals (Pis). Pis quantify the uncertainty related to forecasts by estimating the ranges of the targeted quantities. Pis generated by traditional neural network based approaches are limited by high computational burden and impractical assumptions about the distribution of the data. A novel technique for constructing high quality Pis using support vector machines (SVMs) is being proposed in this paper. The proposed technique directly estimates the upper and lower bounds of the PI in a short time and without any assumptions about the data distribution. The SVM parameters are tuned using particle swarm optimization technique by minimization of a modified Pi-based objective function. Electricity price and demand data of the Ontario electricity market is used to validate the performance of the proposed technique. Several case studies for different months indicate the superior performance of the proposed method in terms of high quality PI generation and shorter computational times.},
  doi       = {10.1109/IJCNN.2014.6889745},
  issn      = {2161-4407},
  keywords  = {Support vector machines;Artificial neural networks;Electricity;Training;Optimization;Uncertainty;Training data;Deregulation;Particle swarm optimization;Prediction interval;Support vector machines;Uncertainty},
}

@InProceedings{Siddique2017,
  author    = {Siddique, Talha and Barua, Dipro and Ferdous, Zannatul and Chakrabarty, Amitabha},
  booktitle = {2017 Intelligent Systems Conference (IntelliSys)},
  title     = {Automated farming prediction},
  year      = {2017},
  month     = {Sep.},
  pages     = {757-763},
  abstract  = {Farming is a predominantly manual process. The incorporation of any form of automation through the means of machine learning algorithms is still in incipient stage. This paper aims to introduce a fundamental approach to inaugurate the use of machine learning systems in the farming process. A comparative study between machine learning algorithms had been carried out in order to determine which algorithm is the most accurate in predicting the best crop for a particular land. Here, the best crop signifies the crop which had the most increase in terms of yield per unit area compared to previous years. This will ensure proper crop allocation throughout the country since optimal production for each crop will be secured. It will also increase the farmer's revenue margin. The study focuses on six major crops of Bangladesh which are Aman rice, Aus rice, Boro rice, Potato, Wheat and Jute. The algorithms that were used are Multiple Linear Regression (MLR) and K-Nearest Neighbor Regression (KNNR). Multiple Linear Regression (MLR) gave the most accurate results during the analysis and was incorporated into an android application. The android application system is also able to prepare a schedule of the complete farming process for a chosen crop, e.g. the correct time to apply fertilizers, irrigation, etc.},
  doi       = {10.1109/IntelliSys.2017.8324214},
  keywords  = {Agriculture;Prediction algorithms;Matrix decomposition;Linear regression;Androids;Humanoid robots;Machine learning algorithms;Multiple Linear Regression (MLR) Analysis;K-Nearest Neighbor Regression (KNNR);prediction;android application;fertilizer suggestion;dependent variable;independent variables},
}

@InProceedings{Erol2025,
  author    = {Erol, Ümmühan Nida and Özer, Serpil and Dosdoğru, Ayşe Tuğba and Göçken, Mustafa},
  booktitle = {2025 9th International Symposium on Innovative Approaches in Smart Technologies (ISAS)},
  title     = {A Hybrid LSTM Model with Feature Selection and ACO-Based Hyperparameter Optimization for Stock Price Prediction in the Banking Sector},
  year      = {2025},
  month     = {June},
  pages     = {1-6},
  abstract  = {Time series analysis plays a crucial role in decision-making and policy planning, as it enables the forecasting of future values based on historical data. This study explores the integration of feature selection and the Long ShortTerm Memory (LSTM) model to enhance the accuracy of stock price predictions. The stock data of U.S. Bancorp (USB), Bank of America (BAC), and Citigroup (C) from the U.S. banking sector are preprocessed, technical indicators are computed, and key features are selected using the Random Forest (RF) method. The LSTM model is trained to learn sequential data relationships, and hyperparameter optimization is performed using Ant Colony Optimization (ACO). The model’s performance is evaluated using error metrics such as RMSE, MAE, and MAPE, revealing that proper feature selection significantly enhances prediction accuracy. The findings indicate that hyperparameter optimization with ACO, particularly when combined with effective feature selection, substantially improves stock price prediction accuracy. The results show that BAC exhibits the best predictive performance with the lowest error rates, while USB and C demonstrate relatively higher prediction errors. However, the high R2 values across all banks confirm the overall robustness of the proposed model.},
  doi       = {10.1109/ISAS66241.2025.11101853},
  keywords  = {Accuracy;Computational modeling;Decision making;Predictive models;Feature extraction;Hyperparameter optimization;Universal Serial Bus;Data models;Forecasting;Long short term memory;Artificial Intelligence;Deep Learning;Stock Price Prediction;LSTM},
}

@InProceedings{Waditwar2026,
  author    = {Waditwar, Prajkta Ravindra},
  booktitle = {2026 International Conference on Smart Futuristic Technology},
  title     = {Cloud Supply Chain Optimization using AI-driven Forecasting},
  year      = {2026},
  month     = {Jan},
  pages     = {1-10},
  abstract  = {The reason is that the rapid expansion of cloud computing has forced organizations into the increasing dependency on multi-vendor infrastructures which have complexities and have diverse issues in capacity planning, cost prediction and services availability across the cloud supply chain. Classical rule based forecast methods are deficient in dynamism in workload variations, heterogeneous pricing models and variability in demand. In the current paper, the authors suggest an AI-based forecasting model of cloud supply chain optimization, which involves deep learning-based demand prediction, cost dynamic modelling, and intelligent allocation of resources. The system utilizes hybrid time-series learning models, including LSTM-Transformer ensembles, to predict the workload needs very well, and optimize the multi-cloud procurement. Moreover, a reinforcement learning module constantly adjusts the policies of provisioning to reduce the cost, service latency, and vendor lock-in risks. Real world cloud trace experimental evaluation shows that the methodology is significantly better in forecast accuracy, over-provisioning cost reduction and reliability of services than state of the art methods. The suggested framework can provide proactive cloud supply chain governance and sustainability objectives, scalability planning, and autonomous cloud-native operations to enterprise and edge settings.},
  doi       = {10.1109/ICSFT66733.2026.11507034},
  keywords  = {Clouds;Costing;Costs;Forecasting;Modeling;Optimization;Pricing;Procurement;Supply chains;Timing;Cloud Supply Chain;AI-Driven Forecasting;Resource Optimization;Multi-Cloud Cost Governance;Deep Learning;LSTM-Transformer Ensemble},
}

@InProceedings{Hossain2026,
  author    = {Hossain, Arman and Palas, Md. Rajibul and Quader, Montaser Abdul and Alam, Md. Shoab and Quader, Mozdaher Abdul},
  booktitle = {2026 IEEE 2nd International Conference on Quantum Photonics, Artificial Intelligence & Networking (QPAIN)},
  title     = {GRU-Based Time-Series Forecasting of Agricultural Commodity Prices Using Market and Climate Data},
  year      = {2026},
  month     = {April},
  pages     = {1-7},
  abstract  = {The prices of agricultural commodities in Bangladesh are shift highly just because of market and climate insecurity, making challenges for farmers, buyer and seller, and policymakers. Machine Learning (ML) Traditional models mostly lose to catch the non-linear, long-range patterns driving these up and down, guiding to unbelievable predictions and economic vulnerability across the supply chain. To fix this issue, this research introduces a deep learning (DL) framework based model on Gated Recurrent Units (GRU) for short-term forecasting of monthly closing prices of agriculture products using an compact dataset of bd market and weather attributes created from the World Bank and Bangladesh Agricultural Research Council (BARC) records. We collect the data from the years of 2007 to 2023 and this dataset is prepared through a design pipeline involving normalization, encoding, sequence generation and a strict chronological split (70 % training, 10 % validation, and 20 % testing) to save data leakage. The proposed GRU model learns patterns over time and produces accurate predictions, achieving strong and genuine forecasting performance, with a coefficient of determination ($R^{2}$) of 0.977, Root Mean Squared Error (RMSE) of 6.00, Mean Absolute Error (MAE) of 3.96, and Mean Squared Error (MSE) of 36.02. We check the model using convergence and residual plots to make sure the model's performance well and fair error distribution. The results show that the GRU model gives a strong base for useful tools such as, price alerts, buying plans and market risk control, helping stakeholders manage agricultural product price volatility.},
  doi       = {10.1109/QPAIN69676.2026.11546003},
  keywords  = {Modeling;Pricing;Forecasting;Timing;Meteorology;Training;Testing;Weather;Weathering;Printing;GRU Model;Deep Learning;Time-Series Dataset},
}

@InProceedings{Wijaya2025,
  author    = {Wijaya, Michael Eduardo and Gunawan, Alexander Agung Santoso and Tedjasulaksana, Jeffrey Junior},
  booktitle = {2025 IEEE International Conference on Artificial Intelligence and Mechatronics Systems (AIMS)},
  title     = {Short-Term NASDAQ Futures (NQ=F) Prediction Using Naïve, Conv1D, and LSTM Models},
  year      = {2025},
  month     = {May},
  pages     = {1-5},
  abstract  = {This study investigates the short-term forecasting of NASDAQ Futures ($\mathbf{N Q} \boldsymbol{=} \mathbf{F}$) price movements using three models: Naïve, Conv1D, and LSTM. Daily historical ‘ $N Q=F$ ‘ data from January 1, 2020, to January 1, 2025, was retrieved via Yahoo Finance using the yfinance library and preprocessed through normalization and windowing techniques. The Naïve model, serving as the baseline, delivered strong short-term predictions with the lowest error metrics, including MAE, MSE, and RMSE. The Conv1D model demonstrated moderate performance by capturing short-term dependencies but struggled with long-term temporal patterns. The LSTM model showed its potential to generalize temporal and non-linear patterns effectively, outperforming Conv1D but falling short of the Naïve model in short-term accuracy. The results reveal that the Naïve model achieved the lowest error metrics (MAE: 165.58, MSE: 50,937.75, RMSE: 225.69), making it the most reliable for short-term forecasting. While the Conv1D model captured localized patterns moderately well (MAE: 233.33, MAPE: 1.22%), it struggled with longer dependencies. The LSTM model demonstrated potential in capturing non-linear relationships but recorded the highest error metrics (MAE: 264.42, MAPE: 1.38%). These findings underscore the Naïve model’s effectiveness as a benchmark while highlighting the need for optimization in deep learning models to unlock their full predictive capabilities for financial time series data.},
  doi       = {10.1109/AIMS66189.2025.11229541},
  keywords  = {Measurement;Accuracy;Biological system modeling;Time series analysis;Finance;Predictive models;Data models;Forecasting;Long short term memory;Optimization;NASDAQ Futures;Yahoo Finance;Time Series Forecasting;Financial Market Prediction;Naïve Model;Conv1D;LSTM},
}

@InProceedings{Kowshik2024,
  author    = {Kowshik, S B and Nair, Samhitha and Kiruthika, S and Athanesious, J. Joshan},
  booktitle = {2024 International Conference on Computing and Intelligent Reality Technologies (ICCIRT)},
  title     = {StockAI - Stock Analysis Tool Agent},
  year      = {2024},
  month     = {Dec},
  pages     = {1-5},
  abstract  = {StockAI is a stock market analysis tool that integrates machine learning, traditional trading indicators, and intelligent agents to analyze live data and projections for stock investors. It does this by carrying out an analysis of the historical price trend of a stock and the ongoing stock markets from the use of mathematical indicators such as moving averages, relative strength index, and candlestick patterns. As a result, it aids in decision-making for both new and old traders. The system also leverages machine learning algorithms like random forests to generate price predictions with improved accuracy. StockAI’s interactive interface allows users to engage with the tool through natural language queries. However, challenges remain in evaluating the outputs of large language models, as current methods rely heavily on human evaluation. The ultimate goal of StockAI is to help investors make informed decisions, optimize market opportunities and mitigate risks through a combination of AI-driven analysis and traditional financial indicators.},
  doi       = {10.1109/ICCIRT59484.2024.10921844},
  keywords  = {Measurement;Sentiment analysis;Accuracy;Large language models;Natural languages;Real-time systems;Intelligent agents;Stock markets;Standards;Random forests;stock market analysis;agents;large language models;price prediction},
}

