	title = {A metal price forecasting framework optimized with TLBO metaheuristic and selective for highest returns},
	year = {2025},
	journal = {Expert Systems with Applications},
	volume = {285},
	pages = {},
	doi = {10.1016/j.eswa.2025.127937},
	url = {https://www.scopus.com/pages/publications/105004410496?origin=resultslist},
	affiliations = {Department of Industrial Management, National Taiwan University of Science and Technology, Taipei, Taiwan},
	abstract = {Metal price prediction constitutes a significant economic challenge. Fluctuations in metal prices substantially impact various industries, including manufacturing, construction, energy, and transportation. Accurate price predictions enable organizations to make informed decisions, optimize operations, and mitigate risks, thereby enhancing competitiveness and profitability. The proposed framework is designed to process time series price data with the target output including trend predictions and recommended actions for each day to achieve the highest return. In this study, we investigate various machine learning algorithms, including linear regression, logistic regression, Artificial Neural Networks, Long Short-Term Memory, and XGBoost, for both classification and regression output. This research employs Empirical Mode Decomposition to generate decomposed series, termed Intrinsic Mode Functions (IMFs), from close price time series data. Subsequently, these IMFs are utilized as feature vectors for prediction models. To optimize returns in trading decisions, the study applies the TLBO algorithm to determine the optimized learning rate, training and validation datasets, and SHRV method to select the models that achieve the highest return at validation. Through validation on empirical datasets from seven distinct metals markets over several years, the EMD-TLBO-SHRV framework demonstrates superior performance compared to traditional models in terms of both predictive accuracy and simulated trading returns. This research offers a practical and scalable approach to commodity price forecasting in volatile market conditions. © 2025 Elsevier Ltd},
	author_keywords = {Empirical mode decomposition; Hybrid models; Machine learning; Metal price forecasting; Model optimization; Return optimization; Time series prediction},
	keywords = {Linear regression; Logistic regression; Empirical Mode Decomposition; Hybrid model; Machine-learning; Metal price forecasting; Metal prices; Model optimization; Optimisations; Price forecasting; Return optimization; Time series prediction; Construction industry},
	correspondence_address = {S.-H. Tseng; Department of Industrial Management, National Taiwan University of Science and Technology, Taipei, Taiwan; email: shtseng@mail.ntust.edu.tw},
	publisher = {Elsevier Ltd},
	issn = {09574174},
	coden = {ESAPE},
	language = {English},
	abbrev_source_title = {Expert Sys Appl},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

