@Conference{Padmavathi2020,
  author              = {Padmavathi, G. and Valliammal, N. and Shaju, Barani and Balasubramaniam, Anandkumar and Paul, Anand},
  booktitle           = {2020 8th International Conference on Orange Technology (ICOT)},
  title               = {Enhanced prediction for investment portfolio management using multiple kernel-based long short-term memory-network for nickel price prediction},
  year                = {2020},
  month               = {Dec},
  note                = {Cited by: 0},
  pages               = {1-7},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Orange Technol., ICOT},
  abstract            = {Nickel is a key competitive material source with commodities and economic characteristics, the price volatility of which would influence shareholder's decisions. For this reason, an accurate pattern prediction of nickel prices is a crucial concern for the strategic planning of investors in the nickel trade; however, the conventional neural network models are not effective in terms of predictive performance and suitability. So, Gaussian Processes-Long Short-Term Memory (GP-LSTM) model was suggested to learn the LSTM kernels and predict the nickel prices. However, this kernel function representation was not plenty for a huge amount of data captured from various sources. Also, it cannot completely learn dynamic, composite and structural data attributes. Therefore in this article, a Multiple-Kernel LSTM (MKLSTM) network model is proposed for learning the huge amount of data and predicting the nickel prices efficiently. The core objective of this MKLSTM model is to resolve the difficulty of adding LSTM and multiple kernel functions using data from nickel industries. This model is applied to find the significant attributes for representing suitable data. Also, the proper larger kernels for learning dynamic and structural data attributes are selected by constructing a Directed Acyclic Graph (DAG). By using the selected kernels, the MKLSTM is learned to predict the nickel price and its fluctuations. At last, the experimental results exhibit the performance of MKLSTM using the nickel price database compared to the LSTM and GP-LSTM models. © 2020 IEEE.},
  affiliations        = {Avinashilingam Institute for Home Science and Higher Education for Women, Department of Computer Science, Coimbatore, India; The School of Computer Science Engineering, Kyungpook National University, Daegu, South Korea},
  author_keywords     = {Directed acyclic graph; Gaussian process; LSTM; Mineral commodity; Multiple kernel learning; Nickel; Price prediction},
  doi                 = {10.1109/ICOT51877.2020.9468787},
  isbn                = {978-166541852-2},
  journal             = {2020 8th International Conference on Orange Technology, ICOT 2020},
  keywords            = {Brain; Citrus fruits; Composite structures; Costs; Directed graphs; Economics; Electronic trading; Financial markets; Forecasting; Investments; Nickel; Directed acyclic graph (DAG); Economic characteristics; Gaussian Processes; Investment portfolio; Neural network model; Predictive performance; Price volatility; Short term memory; Long short-term memory},
  language            = {English},
  publication_stage   = {Final},
  source              = {Scopus},
  type                = {Conference paper},
  url                 = {https://www.scopus.com/pages/publications/85112455292?origin=resultslist},
}

@Article{Yang2020,
  author   = {Yang, Yujun and Yang, Yimei},
  journal  = {IEEE Access},
  title    = {Hybrid Method for Short-Term Time Series Forecasting Based on EEMD},
  year     = {2020},
  issn     = {2169-3536},
  pages    = {61915-61928},
  volume   = {8},
  abstract = {To improve the prediction effect of time series, we make a systematic study of various time series prediction methods based on statistics and machine learning in this paper. In the experiment, we compare the prediction results of several prediction methods. In particular, much research has been done on the selection of experimental data because representative time series data can better test the effectiveness and practicability of the prediction method. Based on the idea of divide and conquer of complex problems and the strategy of continuous optimization of machine learning, we proposed the prediction methods of LSTM-TFE, LR-TFE, and BR-TFE combined the EEMD, LSTM, LR, and BR methods in this paper. These methods use EEMD to decompose complex time series into several relatively milder, more regular and stable subsequences. Then the prediction model of each subsequence based on machine learning is carried out by using the LSTM, LR, or BR methods. We use these prediction models to predict the value of each subsequence. Finally, the value of multiple subsequences is fused to form the prediction results of the original complex time series. To verify the proposed method comprehensively, we select three representative time series data to test this paper. From the experimental results, we found that the proposed method has a good effect.},
  doi      = {10.1109/ACCESS.2020.2983588},
  keywords = {Time series analysis;Recurrent neural networks;Forecasting;Prediction methods;Empirical mode decomposition;Machine learning;LSTM;short-term forecasting;EEMD;price prediction;time series},
}

@InProceedings{D2025,
  author    = {D, Malathi and S, Gopika and R, Sangeetha and Jha, Anjali and Raj, Anshu},
  booktitle = {2025 3rd International Conference on Sustainable Computing and Data Communication Systems (ICSCDS)},
  title     = {Real Time Stock Market Prediction using GPU Enabled Hybrid Model},
  year      = {2025},
  month     = {Aug},
  pages     = {522-528},
  abstract  = {The financial markets are becoming increasingly dynamic, with real-time data playing a crucial role in informed decision-making. Traditional stock price prediction models often rely solely on historical numerical data, which can limit their adaptability in rapidly changing environments. In this paper, we propose a novel approach that leverages GPU acceleration and deep learning to process image-based representations of corporate data and predict stock prices in real time. Our architecture combines Convolutional Neural Networks (CNNs) for feature extraction and Long Short-Term Memory (LSTM) networks for temporal pattern recognition, enabling a more robust and dynamic prediction model. The system is trained using image datasets representing corporate stock trends and further enhanced using real-time stock data fetched via the Yahoo Finance API (y finance). By implementing the solution on Google Colab with CUDA-enabled GPU support, we achieve significant improvements in training speed and model efficiency. The model demonstrates the ability to simulate real-time predictions of corporate stock prices for each month of the year 2025, using companies such as TCS and Infosys as examples. Our results show a promising correlation between predicted and real-time fluctuated stock values, offering a fresh direction for integrating visual data and live market analytics in financial forecasting.},
  doi       = {10.1109/ICSCDS65426.2025.11167128},
  keywords  = {Training;Deep learning;Adaptation models;Graphics processing units;Finance;Predictive models;Real-time systems;Data models;Convolutional neural networks;Long short term memory;Stock Prediction;Deep Learning;CNN;LSTM;Real-Time Data;GPU Acceleration;Finance},
}

@InProceedings{Singh2024d,
  author    = {Singh, Uphar and Tamrakar, Sanghmitra and Saurabh, Kumar and Vyas, Ranjana and Vyas, O.P.},
  booktitle = {2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)},
  title     = {Optimizing Hyperparameters of Deep Learning Models for Stock Price Prediction},
  year      = {2024},
  month     = {June},
  pages     = {1-7},
  abstract  = {A Time Series data refers to a collection of observations taken in chronological order over time. In the era of Artificial Intelligence, Deep Learning(DL) has achieved enormous milestones in time series forecasting like stock price prediction, weather forecasting, etc. Hyper-parameter tuning is an essential step in DL model development, as it can significantly affect the model’s performance. In this research work, optimisation techniques such as Randomised search, Grid search, and Bayesian optimisation are used to optimise the performance of DL models(Long short term memory(LSTM), Bi-Directional LSTM(BiLSTM) and Gated Recurrent Unit(GRU)) via hyperparameter tuning. The proposed model is evaluated and compared with existing methods on various datasets of historical stock prices to demonstrate its effectiveness in predicting future stock prices. The research investigates the impact of the selected features on prediction accuracy and the contribution of the different optimisation techniques in tuning models. The GRU model has been found to be the best performer in training time and prediction errors among all search models. On the other hand, Bayesian search converges more quickly when compared to grid search and random search. The research will provide valuable insights into the use of technical indicators and multivariate timeseries analysis for stock price forecasting.},
  doi       = {10.1109/ICCCNT61001.2024.10724813},
  issn      = {2473-7674},
  keywords  = {Training;Deep learning;Time series analysis;Weather forecasting;Predictive models;Logic gates;Bayes methods;Forecasting;Tuning;Optimization;Hyperparameter Tuning;Deep Learning;Stock Prices;Multivariate Time series;Bayesian Search},
}

@InProceedings{Cheekati2025,
  author    = {Cheekati, Srinivasa Rao and Sudheer Reddy, K},
  booktitle = {2025 International Conference on Advanced Computing Technologies (ICoACT)},
  title     = {Machine Learning Strategies for Nifty50 Index Trading Optimization},
  year      = {2025},
  month     = {March},
  pages     = {01-06},
  abstract  = {The dynamic nature of financial markets, especially Nifty50 trading, requires advanced predictive models for effective decision-making and risk management. Recent advancements in machine learning have led to robust models for handling financial data complexities and market volatility. This review explores a number of machine learning algorithms ensemble methods, and deep learning models. Key stages such as data pre-processing, feature selection, and model training are analyzed, with a focus on integrating the India VIX index and financial indicators to improve accuracy. Comparative performance analysis using metrics like accuracy, sensitivity, MAPE, RMSE, and F1-Score is presented. The paper concludes with insights on how these advancements can enhance prediction precision, risk management, and trading outcomes.},
  doi       = {10.1109/ICoACT63339.2025.11004954},
  keywords  = {Deep learning;Accuracy;Reviews;Computational modeling;Decision making;Predictive models;Data models;Complexity theory;Indexes;Risk management;Nifty50;Machine Learning;Predictive Modeling;Risk Management;India VIX;Index Prediction;Time-Series},
}

@InProceedings{Ripon2016,
  author    = {Ripon, Kazi Shah Nawaz and Rajon, S. A. Ahsan},
  booktitle = {2016 International Conference on Control, Decision and Information Technologies (CoDIT)},
  title     = {Stock market forecast using bio-inspired computing},
  year      = {2016},
  month     = {April},
  pages     = {523-529},
  abstract  = {Stock Markets represent a complex, nonlinear, ever-changing, trading systems where traders (investors) are competing for profit. Stock market forecasting have attracted some special attention in the last years. However, the irregular nature and the complex behavior of stock data transform forecasting into a very hard task, and forecasting stock index has proven to be difficult. Recently, Bio-Inspired Algorithms has emerged extremely useful for forecasting dynamical systems e.g., stock market. Though a lot of research has already been done on various stock markets, relatively less attention is given for Dhaka Stock Exchange (DSE), Bangladesh in comparison to them. This work presents a stock market forecasting system based on hybridized Bio-Inspired Algorithms for DSE. Experimental result shows that the proposed system is very useful for forecasting stock market. Another contribution of this paper is to present a review of literature application of Bio-Inspired Algorithms for stock market forecasting.},
  doi       = {10.1109/CoDIT.2016.7593617},
  keywords  = {Stock markets;Forecasting;Biological system modeling;Predictive models;Genetic algorithms;Companies;Computational modeling;Stock Market Forecasting;Dhaka Stock Exchange (DSE);Bio-Inspired Algorithms;Genetic Algorithms},
}

@InProceedings{Notaria2024,
  author    = {Notaria, Harsh and Shah, Shriya and Thopte, Devarshee and Soneji, Hemang and Bari, Pranit and Deulkar, Khushali},
  booktitle = {2024 8th International Conference on Computing, Communication, Control and Automation (ICCUBEA)},
  title     = {Comparative Analysis of Stock Price Prediction using Time Series Models},
  year      = {2024},
  month     = {Aug},
  pages     = {1-6},
  abstract  = {The inconsistency of the stock market is ungovernable, making it prone to imminent financial risks. Our research indicates that the system displays remarkable precision in producing prognostics based on historical data derived from Yahoo Finance in the form of graphs and values. Resorting to our model, financial analysts and investors can alleviate risk and capitalize on market opportunities, facilitating informed decision-making. Our study’s primary focus is evaluating the following four models for predicting stock market prices: Long Short-Term Memory, Auto-Regressive Integrated Moving Average, Seasonal Auto-Regressive Integrated Moving Average using eXogenous factors, and Auto-Regressive Moving Average. ARIMA utilizes differencing to stabilize non-stationary time series, while ARMA amalgamates autoregressive and moving average components to record linear dependencies. SARIMAX strengthens ARIMA by integrating seasonal fluctuations, suitable for modeling seasonal trends in financial data. Deep learning techniques like LSTM excel at recognising complex temporal correlations. These findings showcase the importance of utilizing advanced forecasting techniques to navigate the ever-changing financial landscape, offering valuable insights for professional and academic purposes.},
  doi       = {10.1109/ICCUBEA61740.2024.10775112},
  issn      = {2771-1358},
  keywords  = {Analytical models;Navigation;Time series analysis;Pricing;Predictive models;Market research;Data models;Stock markets;Forecasting;Long short term memory;LSTM;RNN;ARMA;ARIMA;SARIMAX;Time Series Analysis},
}

@InProceedings{Srinivas2025,
  author    = {Srinivas, T. Aditya Sai and Babu, K. Dora and Ramu, M. and Shashikala, I.V. and Rakshitha, S. and Varshini, H.B.},
  booktitle = {2025 9th International Conference on I-SMAC (IoT in Social, Mobile, Analytics and Cloud) (I-SMAC)},
  title     = {Forecasting and Interpreting Inflation Trends: A Machine Learning Framework for Consumer Price Index Analysis},
  year      = {2025},
  month     = {Oct},
  pages     = {1494-1498},
  abstract  = {The Consumer Price Index (CPI) is a key measure for tracking inflation and guiding economic policy. Traditional forecasting approaches such as ARIMA and SARIMA primarily capture linear and seasonal patterns but often fail to reflect the complex and non-linear drivers of modern price movements. This study develops a machine learning-based framework to forecast and interpret inflation in India using monthly CPI data from 2013 to 2023. The framework evaluates two advanced models, XGBoost and Long Short-Term Memory (LSTM) networks, benchmarked against a SARIMA baseline. Results show that XGBoost achieves the highest predictive accuracy, reducing forecast error by nearly 45% compared to SARIMA. To improve transparency, SHapley Additive exPlanations (SHAP) are applied to identify key inflation contributors, with “Fuel and Light” and “Housing” emerging as the most influential categories. A counterfactual analysis further quantifies the COVID-19 pandemic's impact, revealing deviations of $\mathbf{4} \boldsymbol{-} \mathbf{5}$ index points from expected inflationary trends. By combining predictive precision with interpretability, the proposed framework offers policymakers a practical and explainable decision-support tool for inflation management.},
  doi       = {10.1109/I-SMAC65734.2025.11597832},
  issn      = {2768-0673},
  keywords  = {Modeling;Forecasting;Machine learning;Indexes;Long short term memory;Indexing;Pricing;Printing;Machining;COVID-19;Consumer Price Index;Inflation Forecasting;Machine Learning;XGBoost;LSTM;SHAP;Counterfactual Analysis;COVID-19},
}

@InProceedings{M2025,
  author    = {M, Roopa H and S, Sahana},
  booktitle = {2025 International Conference on Transformative Computing Technologies (ICTCT)},
  title     = {Comparing LSTM and ARIMA Approaches for Stock Price Forecasting with a Streamlit-Based Interactive Interface},
  year      = {2025},
  month     = {Sep.},
  pages     = {38-43},
  abstract  = {Analysis of the stock market is crucial for the making of financial decisions and developing investment strategies. In this paper, we discuss the creation of an Interactive Stock Analysis Dashboard implemented using Python, Streamlit, and Yahoo Finance. Investors can visualize and make decisions based on real-time data. They can access live price data with moving averages, price change heatmaps, and comparative analysis of multiple companies. This paper discusses the methodologies employed, including data collection and preprocessing, visualization techniques, and the system's experimental setup. The system designed lets the user evaluate stock price movements, compare historical stock price data, and make investment decisions based on the data analysis. The focus of subsequent studies will be directed toward the use of forecasting techniques based on AI for greater accuracy in the analysis. This research has the following notable features: Fetching stock information in real-time: Setting up a real-time automated process for fetching stock prices and their corresponding traded volume. Processing of data and performance of analytical computations: Calculating moving averages, the prices, and their changes in a more advanced means identifying the trends. Display of stock trends in a line graph, bar chart, and heatmap for easy interpretation. Allowing easy comparison across multiple companies, enabling the user to identify trends in market. By integrating real-time data and visualization, and performing underlying statistical evaluations, the system targets to provide a straight-forward and practical solution for enthusiasts, traders, and financial analyst. Further refinements will focus on incorporating advanced algorithms aimed at predictive estimation for stock market movements, thus increasing the system's functionality beyond real-time data display.},
  doi       = {10.1109/ICTCT69201.2025.00025},
  keywords  = {Heating systems;Data visualization;Finance;Companies;Market research;Prediction algorithms;Real-time systems;Stock markets;Forecasting;Investment;Streamlit;stock market analysis;machine learning;data visualization;stock movement prediction;Yahoo Finance API;real-time stock data;financial analysis;investment analysis},
}

@InProceedings{Gupta2025,
  author    = {Gupta, Shourya and Maheshwari, Ansh and Kumar, Shyam M and Reddy, Mohini and Shaikh, Shakila},
  booktitle = {2025 International Conference on Information, Implementation, and Innovation in Technology (I2ITCON)},
  title     = {AI-Enhanced Metals Hedging Strategies: Risk Management for the Indian Market},
  year      = {2025},
  month     = {July},
  pages     = {1-9},
  abstract  = {Risk management in the Indian metal market is being put to the challenge owing to the fact that the metal price in the Indian metal market is so volatile. The dynamic market makes the traditional techniques with static hedge ratios not work well. This research presents the proposed approach that combines an LSTM based price forecasting, GARCH estimation of the volatility, BERT sentiment analysis and reinforcement learning for adaptive risk hedging. It optimizes hedge ratios in the market conditions and trains with PPO based reinforcement learning algorithm. Back-testing from 2014 to 2024 the AI based method outperformed the conventional model in terms of reducing portfolio volatility and also in terms of improving risk adjusted returns as compared with conventional models. Real-time deployment ensures ongoing adaptability. Still, future research aims to push the boundaries of AI by building hybrid AI models, multi-agent learning, as well as explainable AI, to add more transparency and scalability but with the difficulties of computational complexity and data latency.},
  doi       = {10.1109/I2ITCON65200.2025.11210577},
  keywords  = {Adaptation models;Sentiment analysis;Computational modeling;Metals;Reinforcement learning;Risk management;Artificial intelligence;Forecasting;Portfolios;Long short term memory;AI-driven hedging;reinforcement learning;LSTM forecasting;sentiment analysis;risk management;commodity markets;metals trading},
}

@InProceedings{ToliyatAbolhassani2010,
  author    = {Toliyat Abolhassani, AmirMohsen and Yaghoobi, Mahdi},
  booktitle = {2010 3rd International Conference on Advanced Computer Theory and Engineering(ICACTE)},
  title     = {Stock price forecasting using PSOSVM},
  year      = {2010},
  month     = {Aug},
  pages     = {V3-352-V3-356},
  volume    = {3},
  abstract  = {In this research, we propose a machine learning system based on Particle Swarm Optimization (PSO) and Support Vector Machines (SVM) for stock market forecast. A variety of indicators from the technical analysis field of study are used as input features. We also make use of the correlation between stock prices of different companies to forecast the price of a stock, making use of technical indicators of highly correlated stocks, not only the stock to be predicted. The PSO is used to select the set of most Informative input features from among all the technical indicators. The results show that the PSOSVM system outperforms the stand alone SVM system.},
  doi       = {10.1109/ICACTE.2010.5579738},
  issn      = {2154-7505},
  keywords  = {Support vector machines;ISDN;Indium phosphide;Companies;Particle Swarm Optimization;Support Vector Machines;Stock Market Forecasting},
}

@InProceedings{Jiao2021,
  author    = {Jiao, Xingrui and Jia, Susan},
  booktitle = {2021 International Conference on Electronic Information Technology and Smart Agriculture (ICEITSA)},
  title     = {Multi-step-ahead Crude Oil Price Forecasting Based on Autoregressive Integrated Moving Average and Improved Particle Swarm Optimization-enhanced Gated Recurrent Unit},
  year      = {2021},
  month     = {Dec},
  pages     = {374-380},
  abstract  = {Crude oil price volatility has a strong influence on the stability of the global energy market. Therefore, both traders and policy makers have been interested in the accurate forecast of crude oil price so as to prevent large losses and to stabilize the market. This study forecasts crude oil price based on autoregressive integrated moving average ARIMA and improved particle swarm optimization (IPSO)-enhanced gated recurrent unit (GRU) with the daily data of West Texas Intermediate (WTI) crude oil spot prices covering a period of 714 days. Results suggest that GRU consistently enhances ARIMA by addressing the non-linear portion of the time series, but IPSO-enhanced GRU has always achieved the best performance. For twenty-step forecasting, the overall reduction of RMSE is as much as 53%, which significantly raises the prediction accuracy.},
  doi       = {10.1109/ICEITSA54226.2021.00078},
  keywords  = {Oils;Time series analysis;Predictive models;Logic gates;Stability analysis;Macroeconomics;Forecasting;global energy market;crude oil price;multi-step-ahead forecasting;hybrid model;ARIMA;GRU;IPSO},
}

@InProceedings{Anand2023,
  author    = {Anand, Abhiluv and Srivastava, Ramesh},
  booktitle = {2023 4th International Conference for Emerging Technology (INCET)},
  title     = {Confident Stock Price Prediction using Markov Chains},
  year      = {2023},
  month     = {May},
  pages     = {1-6},
  abstract  = {The ability to predict future stock price movement is very important to financial institutions that use stock price projections to calculate future values of stocks or indexes. Although there are numerous well-known methods for predicting stock prices, in this paper, we have focused on a short-term Markov chain-based stock price prediction model. Previous studies have demonstrated the practicality of modeling the financial market as a random walk and the potential for perceiving a market to have the Markov property by defining the transition states as deviations from the opening and closing stock prices of the relevant day. The aim of this study was to construct a first-order transition Markov chain-based stock price prediction model, where the states are continuous price ranges as opposed to potential closing price variations. The First-order transition Markov Chain Model was developed on MATLAB 2020. The outcomes include graphs forecasting the future prices for the top five Nifty-Fifty stocks (based on market capitalization at the time) in comparison to the actual stock prices. Further, the confidence interval was generated for the first prediction using a sample size of 100 predictions with respect to the real stock price. The model was recommended for use on a short-term basis as it loses significance over time owing to the volatility of the market and limited transitions found in the used data set.},
  doi       = {10.1109/INCET57972.2023.10170592},
  keywords  = {Measurement;Instruments;Predictive models;Markov processes;Mathematical models;Indexes;Forecasting;Stock price prediction;Markov chain;First-order transition Markov Chains;Transition probability matrix},
}

@InProceedings{Nanuam2025,
  author    = {Nanuam, Jakkaphun and Phukseng, Thanaphon and Thongnim, Pattharaporn},
  booktitle = {2025 International Technical Conference on Circuits/Systems, Computers, and Communications (ITC-CSCC)},
  title     = {IoT-Driven Smart Farming Data Ecosystems for Durian Price Forecasting},
  year      = {2025},
  month     = {July},
  pages     = {1-6},
  abstract  = {This study presents a smart farming data ecosystem driven by Internet of Things (IoT) for forecasting durian prices in Thailand. Real-time environmental data are collected from field-deployed sensors measuring temperature, humidity, solar radiation, rain fall, wind speed and wind direction. These data are combined with local durian price records and preprocessed using techniques such as outlier detection, linear interpolation and normalization. Random Forest Regression is used to identify influential environmental features and predict market prices. The results show that applying interpolation techniques significantly improves model accuracy and enables more reliable identification of key features such as solar radiation, wind speed and temperature. The proposed ecosystem offers a practical framework that transforms raw sensor data into actionable insights through predictive models and dashboards. This approach promotes proper data management aligned with real-time environmental inputs ensuring consistency and reliability for future forecasting and decision-making within the smart farming ecosystem.},
  doi       = {10.1109/ITC-CSCC66376.2025.11137651},
  issn      = {2997-741X},
  keywords  = {Smart agriculture;Temperature sensors;Temperature measurement;Interpolation;Wind speed;Ecosystems;Real-time systems;Internet of Things;Solar radiation;Forecasting;Internet of Things;Smart Farming;Data Ecosystems;Machine Learning;Durian},
}

@InProceedings{Nikarika2024,
  author    = {Nikarika and Kukreja, Vinay and Thapliyal, Nitin and Aeri, Manisha and Sharma, Rishabh},
  booktitle = {2024 IEEE International Conference on Information Technology, Electronics and Intelligent Communication Systems (ICITEICS)},
  title     = {An Efficient Auto Regressive Integrated Moving Average Model for AAPL, MSFT, NTFX, and GOOGL Stock Price Prediction},
  year      = {2024},
  month     = {June},
  pages     = {1-5},
  abstract  = {Stock market prediction is an important facet of financial analysis since it affects the investment decisions. This study employs the AutoRegressive Integrated Moving Average (ARIMA) model to predict the future price movements of four prominent technology stocks: The abovementioned companies include Apple Inc. (AAPL), Microsoft Corporation (MSFT), Netflix Inc. ARIMA model is a steady time series forecasting process that introduced the autoregressive, differencing and moving average components for capturing temporal patterns in stock price data. The study presents the data collection and preprocessing, model selection, training end evaluation steps. The historical stock price data, trading volumes and relevant financial indicators are then collected from records which includes the processing of information in terms of quality control as well as stationarity. The study focuses on choosing proper parameters for the three hyperparameters (p, d and q) of ARIMA model via rigorous analysis of autocorrelation plot along with partial correlation plot as well Akaike Information Criterion AIC &amp; Bayesian Information Criterion BIC. The chosen models are trained on a subset of historical data, and their performance is measured using metrics including Mean Absolute Error (MAE), Mean Squared Error (MSE), and Root Mean Square error(RMSE). The aim of this study is to shed light on the accuracy and efficiency of ARIMA model for stock prices forecasting AAPL, MSFT, NFLX & GOOGL in a given time frame. Although aware of the fundamental difficulties and limitations in stock market prediction, this study seeks to offer perspectives on using time series forecasting techniques for better decision-making within an uncertain environment such as financial markets. The results and conclusions of this study are relevant for investors, traders, financial analysts as well as researchers who believe in the use of quantitative methods to obtain an overview on stock market patterns and make evidence-based investment decisions.},
  doi       = {10.1109/ICITEICS61368.2024.10624873},
  keywords  = {Training;Time series analysis;Process control;Quality control;Predictive models;Data models;Stock markets;Stock market prediction;deep learning;AAPL;MSFT;netflix;google},
}

@InProceedings{Aldo2025a,
  author    = {Aldo, Dasril and Nur, Yohani Setiya Rafika and Putra, Tomy Nanda and Hariselmi and Firmansyah, Muhammad Raafi’u},
  booktitle = {2025 IEEE 11th Information Technology International Seminar (ITIS)},
  title     = {Deep Learning-Based Price Prediction of Red Bird’s Eye Chili: An LSTM Approach with Hyperparameter Variation},
  year      = {2025},
  month     = {Oct},
  pages     = {195-200},
  abstract  = {The volatile pricing of red bird’s eye chili (Capsicum frutescens) presents a serious challenge to Indonesia’s agricultural market stability, particularly in Central Java. This study investigates the use of a Long ShortTerm Memory (LSTM) neural network to forecast chili prices by examining the effect of hyperparameter tuning, including training epochs, activation functions (tanh, sigmoid, ReLU), and optimizers (Adam, RMSprop, SGD). Daily price data from the National Food Price Panel (April 1, 2021-February 10, 2025) were preprocessed using linear interpolation for missing values and Min-Max normalization. Multiple configurations were tested, with performance measured through MAE, RMSE, MAPE, $R^{2}$, final epoch loss, and runtime. The best configuration-sigmoid activation, Adam optimizer, and 300 epochs-achieved an MAE of 0.0197, RMSE of 0.0434, MAPE of $81.05 \%$, and $\mathbf{R}^{2}$ of 0.9702. These findings highlight the importance of hyperparameter selection in improving both predictive accuracy and efficiency. The research contributes to methodological discussions on LSTM tuning and provides practical insights for developing AI-driven price forecasting platforms to support policymakers, agribusiness stakeholders, and technology innovators in managing volatility in Indonesia’s food markets.},
  doi       = {10.1109/ITIS67966.2025.11308845},
  keywords  = {Training;Java;Accuracy;Predictive models;Birds;Loss measurement;Stakeholders;Forecasting;Long short term memory;Tuning;activation function;hyperparameter variation;LSTM;optimizer;red bird’s eye chili},
}

@InProceedings{Sikarwar2026,
  author    = {Sikarwar, Vikrant and Meshram, Amit Kumar},
  booktitle = {2026 IEEE 12th International Conference on High Performance and Smart Computing (HPSC)},
  title     = {Stock Price Prediction Using Time Series Forecasting Model Used HDFC Banking Dataset},
  year      = {2026},
  month     = {May},
  pages     = {55-60},
  abstract  = {Financial market data to predict stock price movements using historical trading information ML techniques are used to extract the trends in the market and enhance precision in predicting prices of real-life banking stocks. This study suggests a mixture of XGBoost and LSTM networks to forecast stock prices by sifting through financial time series data for complex nonlinear correlations and time-dependent interactions. The HDFC Bank Stock Price Dataset is used to conduct experiments, where it is a real-life market behavior. This hybrid model is compared to other ML and DL models: XGBoost, Random Forest, LSTM, Linear Regression, CNN, and SVR, and it is based on a powerful preprocessing pipeline that eliminates duplicate values, treats null values, scales features using Minimum and Maximum, and engineers' features to improve data quality and model stability. The hybrid XGBoost-LSTM model is more effective than all the analogous models, having a high $\mathbf{R}^{\mathbf{2}}$ coefficient at 0.9548, low RMSE at 95.97, MAE at 58.87, MAPE at 4.03%, and explained variance at 0.9552. These findings suggest that there are considerable changes in prediction accuracy and strength, which demonstrate the usefulness of the offered hybrid framework to predict stock prices in real-life and its potential to be implemented in financial decision-support systems.},
  doi       = {10.1109/HPSC69479.2026.00024},
  keywords  = {Modeling;Pricing;Long short term memory;Timing;Forecasting;Equations;Printing;Banking;Stock markets;Machine learning;financial market;stock price prediction;time series forecasting;ML;hybrid model},
}

@InProceedings{Sharma2025a,
  author    = {Sharma, Somesh and Saxena, Ashish Kumar and Deogaonkar, Anant and Sareen, Nitin and Bansal, Manmohan},
  booktitle = {2025 6th International Conference on Data Intelligence and Cognitive Informatics (ICDICI)},
  title     = {A Data-Driven Approach to Gold Price Forecasting Using Supervised Learning: An Empirical Study with Decision Tree and Random Forest},
  year      = {2025},
  month     = {July},
  pages     = {532-538},
  abstract  = {Predicting commodity prices like gold forms a central part of economic decision-making, investment plans, and economic policy formulation. This paper discusses the application and comparison of two popular forms of machine learning Random Forest Regression and Decision Tree Regression in modeling and forecasting past gold price trends from 1990 to 2024 with a forecasting period till 2034. Both models were trained on past data using the MATLAB software with the target variable taken as annual gold price. Both models were compared through a study of the actual vs. predicted price plots and residual behavior. The performance of both the models was measured in terms of Mean Absolute Error (MAE), Mean Squared Error (MSE), and Root Mean Squared Error (RMSE) metrics. All the metrics were less for the Random Forest model compared to the Decision Tree model, reflecting better error in prediction and tighter residual behavior, demonstrating the better generalization ability and output predictability of the Random Forest model. It concludes that ensemble models like Random Forest render better and consistent forecasts compared to single-tree models in the context of forecasting economic time series data and are therefore better equipped for economic forecasting over the longer term.},
  doi       = {10.1109/ICDICI66477.2025.11135085},
  keywords  = {Gold;Analytical models;Biological system modeling;Time series analysis;Predictive models;Market research;Data models;Forecasting;Random forests;Regression tree analysis;Gold Price Prediction;Time Series Forecasting;Financial Data Analysis;Random Forest;Decision tree},
}

@InProceedings{Vinodhini2024,
  author    = {Vinodhini, H and Amuthaguka, D},
  booktitle = {2024 8th International Conference on Electronics, Communication and Aerospace Technology (ICECA)},
  title     = {Multicollinearity Least Square Recursive Optimized Deep Belief Network based Financial News Sentiment Classification for Stock Price Prediction},
  year      = {2024},
  month     = {Nov},
  pages     = {959-965},
  abstract  = {An essential component of finance and investing is stock price prediction, which attempts to project a stock’s future price. The objective is to use a variety of techniques and data sources to predict the direction and size of price changes. Sentiment analysis of financial news data offers insightful information about the state of the market and possible changes in stock prices. Stock price projections become more accurate and dependable when sentiment research is combined with additional machine learning and deep learning models. This research develops a multicollinearity Least Square Recursive Optimised Deep Belief Network Classification (MLSRODBN) method for sentiment analysis-based stock price prediction that promises better accuracy and shorter processing times. The MLSRODBN Method comprises multiple layers for efficient stock price prediction, including preprocessing, feature selection, and classification processes. In hidden layer, Treebank Word Tokenization is performed to partition the sentences into tokens or words. Finally, Partial Least Square Regression Analysis is carried out to perform efficient sentiment classification (i.e., positive, negative, or neutral) based on the extracted keywords from the financial news. The analysis’s conclusions show that the MLSRODBN strategy fared better at predicting stock prices than other deep learning methods that were currently in use.},
  doi       = {10.1109/ICECA63461.2024.10801081},
  keywords  = {Deep learning;Sentiment analysis;Accuracy;Soft sensors;Optimization methods;Predictive models;Feature extraction;Tokenization;Regression analysis;Root mean square;Deep Belief network;Treebank Word Tokenization;Congruence Similarity Coefficient;Wilcoxon T-test},
}

@InProceedings{Fitriani2022,
  author    = {Fitriani, Shafilah Ahmad and Astuti, Yuli and Wulandari, Irma Rofni},
  booktitle = {2021 International Seminar on Machine Learning, Optimization, and Data Science (ISMODE)},
  title     = {Least Absolute Shrinkage and Selection Operator (LASSO) and k-Nearest Neighbors (k-NN) Algorithm Analysis Based on Feature Selection for Diamond Price Prediction},
  year      = {2022},
  month     = {Jan},
  pages     = {135-139},
  abstract  = {Diamonds are the most expensive, rarest, and most complex gemstones globally. Diamond investing is a new lifestyle; however, diamond prices fluctuate and are difficult to predict. Predicting the price of diamonds can be done using a regression technique because the price is continuous. Regression is part of the field of machine learning. This study aims to find the most efficient and accurate model. The models used to predict diamond prices are k-Nearest Neighbors (kNN) and Least Absolute Shrinkage and Selection Operator (LASSO). The process is carried out by selecting features, considering the value of k from k-NN and alpha from LASSO to ensure optimal accuracy. The data of this research is public and taken from Kaggle. The number of datasets is around 54000 data and is divided into training data by 80% and testing data by 20%. The results showed that k-NN had the highest accuracy of 0.9066 compared to LASSO, which was 0.8801. Meanwhile, the RMSE level shows that k-NN has the smallest value, 926.06, compared to LASSO, 1049.59.},
  doi       = {10.1109/ISMODE53584.2022.9742936},
  keywords  = {Seminars;Social networking (online);Training data;Machine learning;Predictive models;Nearest neighbor methods;Prediction algorithms;Machine learning;Diamonds;k-NN;LASSO},
}

@InProceedings{Pagariya2022,
  author    = {Pagariya, Payal and Shinde, Sadhvee and Shivpure, Rupali and Patil, Sakshi and Jarali, Ashwini},
  booktitle = {2022 2nd Asian Conference on Innovation in Technology (ASIANCON)},
  title     = {Cryptocurrency Analysis and Forecasting},
  year      = {2022},
  month     = {Aug},
  pages     = {1-6},
  abstract  = {Cryptocurrencies are becoming a well-known and commonly acknowledged kind of substitute trade money. Most monetary businesses now include cryptocurrency. Accordingly, cryptocurrency trading is widely regarded as the most of prevalent and capable types of lucrative investments. However, because this financial sector is already known for its extreme volatility and quick price changes, over brief periods of time. For such constantly changing nature of crypto trends and price, it has become a necessary part for traders and crypto enthusiast to get a detailed analysis before investing. Also, the construction of a precise and dependable forecasting model is regarded vital for portfolio management and optimization. In this paper we propose a web system, which will help to understand cryptocurrency in a more statistical way. Proposed system focuses mainly on four coins : Bitcoin, Ethereum, Dogecoin and Shiba Inu performing analysis and forecasting on all the four coins. System will also do statistical comparison between the coins. Analysis and comparison is carried out using python libraries and modules whereas LSTM and ARIMA are used for forecasting. Extensive research was conducted using real-time and historical information, on four key cryptocurrencies, two of which had the greatest market capitalization, notably Bitcoin and Ethereum, while the other, Dogecoin and Shiba Inu, that had a significant growth in market capitalization over the previous year. In comparison to old fully-connected deep neural networks, the suggested model may employ mixed crypto data more proficiently, minimizing overfitting and computing costs.},
  doi       = {10.1109/ASIANCON55314.2022.9909168},
  keywords  = {Technological innovation;Neural networks;Bitcoin;Predictive models;Market research;Real-time systems;Libraries;LSTM(Long short-term memory);ARIMA (Autoregressive Integrated Moving Average);Real time data;historical data;BTC;ETH;Dogecoin;Shiba;prediction;analysis},
}

@InProceedings{Dubey2025,
  author    = {Dubey, Parul and Dubey, Pushkar and Verma, Shraddha and Verma, Gargi and Keswani, Vinay and Sahu, Satish Kumar},
  booktitle = {2025 IEEE 3rd International Symposium on Sustainable Energy, Signal Processing and Cybersecurity},
  title     = {Artificial Intelligence and Machine Learning in Stock Market Prediction and Trading},
  year      = {2025},
  month     = {Nov},
  pages     = {1-6},
  abstract  = {Artificial intelligence (AI) and machine learning (ML) are reshaping financial markets—from price prediction and sentiment analysis to algorithmic and high-frequency trading (HFT). These technologies enable traders and analysts to process vast data streams in real time, accelerating decision-making and sharpening signals that humans might miss. This study surveys key AI techniques used for stock prediction and sentiment inference, including Support Vector Machines (SVM), Decision Trees, and Neural Networks, and examines their roles alongside HFT systems. It also highlights AI-driven portfolio management, where predictive models with dynamic optimization continuously adapt portfolio allocations to evolving market conditions. Using a systematic literature review and real-world case studies, we find that AI-based predictive analytics can improve forecast accuracy and profit margins. However, persistent challenges include managing market volatility, ensuring high-quality and reliable training data, and addressing fairness, transparency, and the systemic risks of automated trading. Future advances are likely to emphasize robustness and rapid adaptability to regime shifts in financial markets.},
  doi       = {10.1109/iSSSC66652.2025.11388094},
  keywords  = {Support vector machines;Deep learning;Ethics;Machine learning algorithms;Signal processing algorithms;Prediction algorithms;Real-time systems;Artificial intelligence;Stock markets;Portfolios;Artificial Intelligence;Machine Learning;Stock Market Prediction;Algorithmic Trading;High-Frequency Trading;Portfolio Management;Market Volatility;Ethical Considerations},
}

@InProceedings{Jaiswal2023,
  author    = {Jaiswal, Sahil and Srivastava, Sudhanshu and Garg, Shelly and Singh, Pardeep},
  booktitle = {2023 International Conference on Artificial Intelligence and Applications (ICAIA) Alliance Technology Conference (ATCON-1)},
  title     = {Effect of News Headlines on Gold Price Prediction using NLP and Deep Learning},
  year      = {2023},
  month     = {April},
  pages     = {1-6},
  abstract  = {This paper demonstrates the use of news headlines of various news articles to see their impact on the gold commodity. The extracted information is not only limited to the value of the asset but also takes into account various other factors that may help make decisions. Gold prices affect everyone and everyone wants to know how the commodity will behave based on global market sentiment, and statements made by large firms which could affect the market. Although many operations have been performed in this field, it has focused only on one aspect and is related to stocks and not commodities like gold. In this paper, we have a data set of news headlines from the period 2000-2019, and the proposed model is used to extract various information such as previous movements, asset comparisons, price guidance, and various other information that news contains. The experiment is done to check the relationship between gold news and gold prices and the model created produces information that has a significant relationship with the gold price.},
  doi       = {10.1109/ICAIA57370.2023.10169488},
  keywords  = {Deep learning;Gold;Globalization;Learning (artificial intelligence);Data models;Data mining;Gold Pricing;Deep Learning;Natural Language Processing;Machine Learning},
}

@InProceedings{Anjaneyulu2025,
  author    = {Anjaneyulu, Gudla and Reddy, Pundru Chandra Shaker and Praveen, Pappula and Banoth, Shobhan and Pandey, Deependra and Koka, Sridhar N},
  booktitle = {2025 International Conference on Advanced Computing Technologies (ICoACT)},
  title     = {A Hybrid Optimization Deep Learning Frame Work for Efficient Stock Market Forecasting},
  year      = {2025},
  month     = {March},
  pages     = {1-6},
  abstract  = {The widespread need to forecast future market trends has prompted the incorporation of cutting-edge technology that go beyond the realm of conventional statistical models. Predicting the future of the stock market using ML and DL methods is the focus of this article. We offer a holistic strategy that incorporates effective methods for feature selection, data preparation, and classification. To clean up the data and lower the noise level, the wavelet transform technique is used. By determining which input features are most important, the Dandelion-Optimization-Algorithm(DOA) optimizes feature selection. An innovative model for analyzing stock market data is created, 3DCNN-GRU, which combines a 3DCNNwith a gated-recurrent-unit(GRU). The Blood-Coagulation-Algorithm(BCA) makes it easier to tune hyperparameters, which improves the performance of the model. The outstanding prediction accuracy of 99.14% achieved by our methodology demonstrates its durability and efficacy in stock market anticipating applications. The proposed model has a lot of potential, but it can only handle the Nifty 50 index because that's all the dataset covers. The work's broader implications imply that the model might be further validated and its applicability improved by including additional datasets and investigating alternative market conditions. To guarantee robustness and generalizability, future research could concentrate on using this model in different financial circumstances.},
  doi       = {10.1109/ICoACT63339.2025.11004655},
  keywords  = {Analytical models;Accuracy;Predictive models;Feature extraction;Market research;Data models;Indexes;Stock markets;Forecasting;Resilience;Stock prediction;deep learning;Nifty 50 index;CNN;Gated recurrent units},
}

@InProceedings{Ettlin2020,
  author    = {Ettlin, Adrian},
  booktitle = {2020 17th International Conference on the European Energy Market (EEM)},
  title     = {Evolutionary Hedging Model for Power Trading to Maximize Daily Profits},
  year      = {2020},
  month     = {Sep.},
  pages     = {1-6},
  abstract  = {Established trading strategies such as fully back-to- back hedging no longer work in a world where customers transfer the cost of hedging completely to traders. Dynamic daily hedging models, in which profits are generated from long and short futures’ positions, have been proposed in combination with accurate Phelix futures and spot price forecasting. This study provides a new approach to accurately forecast Phelix monthly futures prices with long short-term memory-recurrent neural network time series. In addition, a newly proposed daily dynamic hedging model capable of processing recurring inputs is optimized with an evolutionary algorithm to maximize daily profits. Calculated optimized daily hedge ratios provided by the algorithm are backtested on real Phelix market data. The results for the different tested periods confirm that a trading company could consistently generate positive returns under the most competitive pricing assumption and outperform established trading strategies in both trending bear and bull markets.},
  doi       = {10.1109/EEM49802.2020.9221976},
  issn      = {2165-4093},
  keywords  = {Costs;Heuristic algorithms;Time series analysis;Evolutionary computation;Pricing;Predictive models;Power markets;Dynamic daily hedging model;evolutionary optimizer algorithm;upside potential of short futures sales;LSTM-RNN time-series forecasting;hedging strategy performance comparison},
}

@InProceedings{Yulistiani2024,
  author    = {Yulistiani, Risma and Kurniadi, Felix Indra},
  booktitle = {2024 International Conference on Information Management and Technology (ICIMTech)},
  title     = {Stock Price Prediction With the Informer Model},
  year      = {2024},
  month     = {Aug},
  pages     = {49-53},
  abstract  = {The capacity to foresee future stock prices can substantially augment the potential profits of investors; thus, the subject of stock price prediction assumes significance within the investment industry. The present study employs the Informer model for the purpose of predicting stock prices. The results obtained from this research demonstrate that the Informer model's performance is contingent upon the dataset employed, suggesting that its applicability might be limited to particular categories of stock market data. The optimal outcomes were achieved using the BNI dataset, suggesting that although the model exhibits promise, it must be tailored to specific datasets and selected accordingly in order to optimize its performance.},
