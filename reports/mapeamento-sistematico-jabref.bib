  month     = {Aug},
  pages     = {13-17},
  abstract  = {Time series analysis and forecasting play a crucial role due to their extensive application across various practical domains. Time series data represents a sequential order or collection of data points depicting the values of a variable at regular time intervals. The stock market is widely regarded as one of the most intricate financial systems, comprising numerous components or stocks, whose prices fluctuate significantly over time. Stock market forecasting aims to reveal the trends within the market as they evolve. All investors in the stock market strive to maximize returns on their investments while minimizing associated risks Due to the high sensitivity and rapid changes in stock markets, the primary objective of stock-trend prediction is to devise innovative approaches that can anticipate stocks leading to substantial profits. A statistical model capable of predicting Indian stock prices will be constructed using time series data from the Indian stock market. In our study, we utilize daily stock price data from a prominent company listed on the National Stock Exchange (NSE) of India.},
  doi       = {10.1109/ICESC60852.2024.10689888},
  issn      = {2996-5357},
  keywords  = {Sensitivity;Time series analysis;Predictive models;Market research;Data models;Stability analysis;Planning;Reliability;Stock markets;Forecasting;Time Series;Prophet;National Stock Exchange of India (NSE);Stock Price Prediction},
}

@InProceedings{Lu2015,
  author    = {Lu, Ye and Yuping, Li and Weihong, Liang and Qidao, Song and Yanqun, Liu and Xiaoli, Qin},
  booktitle = {2015 8th International Conference on Intelligent Computation Technology and Automation (ICICTA)},
  title     = {Vegetable Price Prediction Based on PSO-BP Neural Network},
  year      = {2015},
  month     = {June},
  pages     = {1093-1096},
  abstract  = {In order to predict vegetable price accurately, 117 sets of green pepper and related factors price data from 2012 to 2015 in Dan Zhou city were selected as the sample data, of which 100 groups were training data and 17 groups were test data. Based on analyzing fluctuant features of vegetable price, with the global stochastic optimization idea to optimize initial weights and thresholds of back propagation (BP) neural network, the PSO-BP prediction model concerning vegetable retail price was set up by using the particle swarm optimization (PSO) algorithm. The experimental results indicated that compared with the traditional BP method, the PSO-BP method could overcome the over-fitting problem and the local minima problem, effectively reduced training error and increased the predicting precision.},
