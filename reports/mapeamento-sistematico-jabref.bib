  doi                    = {10.1080/17480930.2024.2420697},
  keywords               = {Commodity prices; Cut-off grade; Cut-off grade optimization; Deep learning; Grade–tonnage curve; Machine learning; Machine-learning; Net present value; Optimisations; The net present value (NPV); commodity price; machine learning; mining; optimization; policy approach; price determination; uncertainty analysis; Adversarial machine learning},
  language               = {English},
