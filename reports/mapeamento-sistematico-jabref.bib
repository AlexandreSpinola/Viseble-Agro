@Article{Jin2024,
  author                 = {Jin, Bingzi and Xu, Xiaojie},
  journal                = {Neural Computing and Applications},
  title                  = {Forecasting wholesale prices of yellow corn through the Gaussian process regression},
  year                   = {2024},
  issn                   = {09410643},
  note                   = {Cited by: 256},
  number                 = {15},
  pages                  = {8693 - 8710},
  volume                 = {36},
  abbrev_source_title    = {Neural Comput. Appl.},
  abstract               = {For market players and policy officials, commodity price forecasts are crucial problems that are challenging to address due to the complexity of price time series. Given its strategic importance, corn crops are hardly an exception. The current paper evaluates the forecasting issue for China’s weekly wholesale price index for yellow corn from January 1, 2010 to January 10, 2020. We develop a Gaussian process regression model using cross validation and Bayesian optimizations over various kernels and basis functions that could effectively handle this sophisticated commodity price forecast problem. The model provides precise out-of-sample forecasts from January 4, 2019 to January 10, 2020, with a relative root mean square error, root mean square error, and mean absolute error of 1.245%, 1.605, and 0.936, respectively. The models developed here might be used by market players for market evaluations and decision-making as well as by policymakers for policy creation and execution. © The Author(s), under exclusive licence to Springer-Verlag London Ltd., part of Springer Nature 2024.},
  affiliations           = {Advanced Micro Devices (China) Co., Ltd, Shanghai, China; North Carolina State University, Raleigh, 27695, NC, United States},
  author_keywords        = {Commodity price; Corn; Forecasting; Gaussian process regression; Machine learning},
  correspondence_address = {X. Xu; North Carolina State University, Raleigh, 27695, United States; email: xxu6@alumni.ncsu.edu},
  doi                    = {10.1007/s00521-024-09531-2},
  keywords               = {Commerce; Decision making; Errors; Gaussian distribution; Gaussian noise (electronic); Machine learning; Mean square error; Regression analysis; Commodity prices; Corn; Gaussian process regression; Machine-learning; Market players; Price forecasts; Root mean square errors; Times series; Whole sale prices; Yellow corn; Forecasting},
