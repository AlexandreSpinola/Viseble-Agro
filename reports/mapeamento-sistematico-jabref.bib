@Conference{Kiruba2025,
  author                 = {Kiruba, Angelin S. and Kaaviya Priya, R. and Amshi Priyal, S.J. and Ashvatha, R.V. and Aiysvaryaa, R.R. and Kumaran, S.},
  booktitle              = {2025 10th International Conference on Smart Structures and Systems (ICSSS)},
  title                  = {AI-Enhanced Price Forecasting and Hedging Strategies for Agricultural Commodities},
  year                   = {2025},
  month                  = {Dec},
  note                   = {Cited by: 0},
  pages                  = {1-7},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {Proc. - IEEE Int. Conf. Smart Struct. Syst., ICSSS},
  abstract               = {AI-based forecasting methods are becoming more popular as a way to stabilize markets for agricultural products that are affected by climate change, since global demand is always changing. Most of these big models are generally linear and have a fixed volatility, and consequently do not work in a non-linear, non-stationary environment. The study introduces an innovative hybrid methodology that combines CEEMDAN-based decomposition, attention-driven LSTM-Transformer prediction, and GARCH-LSTM for volatility modeling with reinforcement learning hedging optimization. The multi-stage architecture effectively catches the operational dynamics of time, removes noise and it adjusts hedging ratios in response to shifting volatility regimes. The test results showed that these models could reduce RMSE by 50.5%, lower MAPE by 57.9% and achieve 16.3% higher hedging efficiency than standard obtained techniques. The results show that the resultant prediction of agricultural price dynamics is more accurate-a combination of deep learning with reinforcement capability improves accuracy, reduces market risk, and guarantees the robustness of prices in dynamic economic and environmental environments.  © 2025 IEEE.},
  affiliations           = {St. Joseph's College of Engineering, Department of Management Studies, Tamil Nadu, Chennai, India; Saveetha School of Engineering Saveetha Institute of Medical and Technical Sciences, SIMATS, Department of ECE, Tamil Nadu, Chennai, India},
  author_keywords        = {Agricultural Commodity Forecasting; CEEMDAN Decomposition; Hedging Strategy; LSTMTransformer Ensemble; Volatility Modeling},
  correspondence_address = {A.S. Kiruba; St. Joseph's College of Engineering, Department of Management Studies, Chennai, Tamil Nadu, India; email: kirubasamraj@gmail.com},
  doi                    = {10.1109/ICSSS66939.2025.11346234},
  isbn                   = {979-833156323-3},
  journal                = {Proceedings - IEEE 10th International Conference on Smart Structures and Systems, ICSSS 2025},
  keywords               = {Agriculture; Commerce; Costs; Deep learning; Economic analysis; Financial markets; Reinforcement; Agricultural commodities; Agricultural commodity forecasting; CEEMDAN decomposition; Forecasting methods; Global demand; Hedging strategies; Lstmtransformer ensemble; Non linear; Price forecasting; Volatility modeling; Forecasting},
  language               = {English},
