  author                 = {Adeniyi, Emmanuel Abidemi and Gbadamosi, Babatunde and Awotunde, Joseph Bamidele and Misra, Sanjay and Sharma, Mayank Mohan and Oluranti, Jonathan},
  journal                = {Lecture Notes in Networks and Systems},
  title                  = {Crude Oil Price Prediction Using Particle Swarm Optimization and Classification Algorithms},
