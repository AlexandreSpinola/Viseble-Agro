@Article{Zhang2022,
  author                 = {Zhang, Weipeng and Zhang, Ning and Yan, Junchi and Li, Guofu and Yang, Xiaokang},
  journal                = {Pattern Recognition},
  title                  = {Auto uning of price prediction models for high-frequency trading via reinforcement learning},
  year                   = {2022},
  issn                   = {00313203},
  note                   = {Cited by: 23},
  pages                  = {108543-108543},
  volume                 = {125},
  abbrev_source_title    = {Pattern Recogn.},
  abstract               = {In this paper, we propose an online model optimization algorithm based on reinforcement learning for quantitative trading. The combination of prediction model and trading policy is the most commonly used framework in practical quantitative trading. Integrated with machine learning methods, this framework brings huge profits to quantified companies. In the framework, the prediction model is used to predict future trading price trend, and the trading policy is used to determine the price and number of orders. Even though, the shortcomings of machine learning models are obvious, mainly are, (1) Slow prediction speed. Huge human-craft features and model computing cost much time, which is ten times of pure trading policy without model. (2) Poor generalization. This kind of models can hardly adapt to market data in each period, because market traders will change time to time at micro level, thus the distribution of market data will change. But current model is trained on a long period dataset, it achieves best effect at average, but can not adapt to different market at each period. To address this problem, we propose a novel online model optimization algorithm. A light model library will be constructed. Each light model in this library corresponds to a different market distribution. By devising the appropriate reward function via inverse reinforcement learning algorithm, the algorithm can accurately estimate the profits of each model. Then the model can be selected automatically in real-time trading, so that the trading policies can automatically adapt to changes in trading market, overcoming previous shortcoming of manually updating model and slow prediction speed. Experimental results show that the proposed algorithm achieves state-of-the-art performance on China Commodity Futures Market Data. © 2022},
  affiliations           = {Department of Computer Science and Engineering, and MoE Key Lab of Artificial Intelligence, AI Institute, Shanghai Jiao Tong University, No. 800, Dongchuan Road, Shanghai, China; Ping An Asset Management Co., Ltd. No. 1333, Lujiazui Road, Shanghai, China; MoE Key Lab of Artificial Intelligence, AI Institute, Shanghai Jiao Tong University, No. 800, Dongchuan Road, Shanghai, China},
  author_keywords        = {High-frequency trading; Inverse reinforcement learning; Multi-armed bandit; Parameter optimization},
  coden                  = {PTNRA},
  correspondence_address = {N. Zhang; Department of Computer Science and Engineering, and MoE Key Lab of Artificial Intelligence, AI Institute, Shanghai Jiao Tong University, Shanghai, No. 800, Dongchuan Road, China; email: ningz@sjtu.edu.cn},
  doi                    = {10.1016/j.patcog.2022.108543},
  keywords               = {Commerce; Financial markets; Forecasting; Inverse problems; Learning algorithms; Optimization; Profitability; Reinforcement learning; High-frequency trading; Inverse reinforcement learning; Light models; Market data; Model optimization; Multiarmed bandits (MABs); On-line modelling; Optimization algorithms; Parameter optimization; Prediction modelling; Electronic trading},
  language               = {English},
  publication_stage      = {Final},
  publisher              = {Elsevier Ltd},
  source                 = {Scopus},
  type                   = {Article},
  url                    = {https://www.scopus.com/pages/publications/85123364176?origin=resultslist},
}

@Article{SuazaMedina2023,
  author                 = {Suaza-Medina, Mario E. and Zarazaga-Soria, F. Javier and Pinilla-Lopez, Jorge and Lopez-Pellicer, Francisco J. and Lacasta, Javier},
  journal                = {Neural Computing and Applications},
  title                  = {Effects of data time lag in a decision-making system using machine learning for pork price prediction},
  year                   = {2023},
  issn                   = {09410643},
  note                   = {Cited by: 10; All Open Access; Green Open Access; Hybrid Gold Open Access},
  number                 = {26},
  pages                  = {19221 - 19233},
  volume                 = {35},
  abbrev_source_title    = {Neural Comput. Appl.},
  abstract               = {Spain is the third-largest producer of pork meat in the world, and many farms in several regions depend on the evolution of this market. However, the current pricing system is unfair, as some actors have better market information than others. In this context, historical pricing is an easy-to-find and affordable data source that can help all agents to be better informed. However, the time lag in data acquisition can affect their pricing decisions. In this paper, we study the effect that data acquisition delay has on a price prediction system using multiple prediction algorithms. We describe the integration of the best proposal into a decision support system prototype and test it in a real-case scenario. Specifically, we use public data from the most important regional pork meat markets in Spain published by the Ministry of Agriculture with a two-week delay and subscription-based data of the same markets obtained on the same day. The results show that the error difference between the best public and data subscription models is 0.6 Euro cents in favour of the data without delay. The market dimension makes these differences significant in the supply chain, giving pricing agents a better tool to negotiate market prices. © 2023, The Author(s).},
  affiliations           = {Universidad de Zaragoza, Zaragoza, Spain},
  author_keywords        = {Agri-food; Machine learning; Neural networks; Price forecasting; Time series},
  correspondence_address = {M.E. Suaza-Medina; Universidad de Zaragoza, Zaragoza, Spain; email: mesuaza@unizar.es},
  doi                    = {10.1007/s00521-023-08730-7},
  groups                 = {Previsão + Otimização},
  keywords               = {Commerce; Costs; Decision making; Decision support systems; Forecasting; Machine learning; Meats; Supply chains; 'current; Agri-food; Decision-making systems; Machine-learning; Neural-networks; Pork meat; Price forecasting; Price prediction; Time lag; Times series; Data acquisition},
  language               = {English},
  publication_stage      = {Final},
  publisher              = {Springer Science and Business Media Deutschland GmbH},
  source                 = {Scopus},
  type                   = {Article},
  url                    = {https://www.scopus.com/pages/publications/85162966090?origin=resultslist},
}

@Article{Altan2022,
  author                 = {Altan, Aytaç and Karasu, Seçkin},
  journal                = {Energy},
  title                  = {Crude oil time series prediction model based on LSTM network with chaotic Henry gas solubility optimization},
  year                   = {2022},
  issn                   = {03605442},
  note                   = {Cited by: 256},
  pages                  = {122964-122964},
  volume                 = {242},
  abbrev_source_title    = {Energy},
  abstract               = {Estimating the price of crude oil, which is seen as an important resource for economic development and stability in the world, is a topic of great interest by policy makers and market participants. However, the chaotic and nonlinear characteristics of crude oil time series (COTS) make it difficult to estimate crude oil prices with high accuracy. To overcome these challenges, a new crude oil price prediction model is proposed in this study, which includes the long short-term memory (LSTM), technical indicators such as trend, volatility and momentum, and the chaotic Henry gas solubility optimization (CHGSO) technique. In the proposed model, features based on trend, momentum and volatility technical indicators are utilized. The features are obtained by using the trend indicators such as exponential moving average (EMA), simple moving average (SMA) and Kaufman's adaptive moving average (KAMA), the momentum indicators such as commodity channel index (CCI), rate of change (ROC) and relative strength index (RSI), and the volatility indicators such as average true range (ATR), volatility ratio (VR) and highest high-lowest low (HHLL). These indicators are obtained separately for the West Texas Intermediate (WTI) and Brent COTS. Especially, including the volatility indicator in the model is important in terms of the robustness of the proposed model. The features based on EMA, SMA, KAMA indicators are composed by changing the period values between 3 and 10, the features based on ROC indicator is created by changing the period values between 5 and 12, and the features based on CCI, RSI, ATR, VR and HHLL indicators are formed by changing the period values between 5 and 20. The features are selected by CHGSO algorithm based on the logistic chaotic map, which is successful in avoiding local optima and balancing exploitation and exploration in the search space. Both Theil's U and the mean absolute percentage error (MAPE) values are utilized in the optimization algorithm as the objective function. The results show that the proposed prediction model copes with the chaoticity and nonlinear dynamics of both WTI and Brent COTS. © 2021 Elsevier Ltd},
  affiliations           = {Department of Electrical Electronics Engineering, Zonguldak Bülent Ecevit University, Zonguldak, 67100, Turkey},
  author_keywords        = {Chaotic metaheuristic optimization; Crude oil; Long-short term memory; Phillips-Perron test; Volatility},
  coden                  = {ENEYD},
  correspondence_address = {A. Altan; Department of Electrical Electronics Engineering, Zonguldak Bülent Ecevit University, Zonguldak, 67100, Turkey; email: aytacaltan@beun.edu.tr},
  doi                    = {10.1016/j.energy.2021.122964},
  keywords               = {Texas; United States; Brain; Chaotic systems; Crude oil; Forecasting; Momentum; Optimization; Solubility; Time series; Chaotic metaheuristic optimization; Chaotics; Feature-based; Gas solubility; Metaheuristic optimization; Phillip-perron test; Phillips; Prediction modelling; Times series; Volatility; crude oil; economic development; market conditions; optimization; spatiotemporal analysis; Long short-term memory},
  language               = {English},
  publication_stage      = {Final},
  publisher              = {Elsevier Ltd},
  source                 = {Scopus},
  type                   = {Article},
  url                    = {https://www.scopus.com/pages/publications/85121663221?origin=resultslist},
}

@Article{Ansari2024,
  author   = {Ansari, Yasmeen},
  journal  = {IEEE Access},
  title    = {Multi-Cluster Graph (MCG): A Novel Clustering-Based Multi-Relation Graph Neural Networks for Stock Price Forecasting},
  year     = {2024},
  issn     = {2169-3536},
  pages    = {154482-154502},
  volume   = {12},
  abstract = {Stock price forecasting is one of the indispensable challenges, as financial markets are increasingly becoming volatile due to the complex, noisy, dynamic, and chaotic nature of stock data. Accurate stock price forecasting models play a key role in protecting risks associated with markets and making sound investing decisions. Mostly, existing studies suggested different Machine Learning (ML) and Deep Learning (DL) based methodologies, but they often focus on individual stock data to generate predictions, ignoring the interconnectivity and interconnections that exist between stocks. Recent advances in graph neural networks highlighted the need to model stock-to-stock interactions to improve the reliability of forecasting. Regardless of the potential, modeling these interactions among stocks poses substantial challenges. Existing methods encompass basic heuristics like sector affiliations, shareholdings, or co-occurrence in news headlines, etc., to model relationships among stocks which can disregard the intricate and varied nature of stock interconnection. To address such issues, this study proposed a clustering-based approach to exploit relationships among stocks listed on particular stock exchanges. More precisely, different graph models are created using three proposed strategies including RS (Returns-Sharpe Ratio), VR (Volatility-Return), and YR (Yearly variance and returns) clustering. These clusters are employed to create multi-relation graphs which are then propagated to an LSTM-based graph network to forecast future prices at the node level. The proposed approach can anticipate future stock prices for all stocks featured in an NSADAQ and S&P500 index while utilizing graph nodes from a single-trained standalone model. Moreover, experimental results on NSADAQ-100 and S&P500 stocks, show that the proposed clustering-based stock graph models methodology shows good results in terms of lowest MSE and MAE values of 0.01 and 0.08 respectively.},
  doi      = {10.1109/ACCESS.2024.3476159},
  keywords = {Predictive models;Forecasting;Graph neural networks;Biological system modeling;Stock markets;Market research;Deep learning;Prediction algorithms;Indexes;Time series analysis;Long short term memory;Pricing;Clustering methods;Stock price forecasting;deep learning;graph neural networks;LSTM;multi-relation graphs;stock clustering strategies},
}

