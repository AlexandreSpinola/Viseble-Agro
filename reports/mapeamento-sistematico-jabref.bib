}

@ARTICLE{Zhou2026,
	author = {Zhou, Zhuokai and Wang, Sizhuo},
	title = {Predictive linkages between carbon markets and coking coal futures: a hybrid forecasting framework and market efficiency implications},
	year = {2026},
	journal = {Energy Sources, Part B: Economics, Planning and Policy},
	volume = {21},
	number = {1},
	pages = {},
	doi = {10.1080/15567249.2026.2685049},
	url = {https://www.scopus.com/pages/publications/105041126165?origin=resultslist},
	affiliations = {School of Management, China University of Mining and Technology, Beijing, China},
	abstract = {Accurate forecasting of coking coal futures is critical for energy security and supply chain optimization amidst global decarbonization. However, fossil fuel prices exhibit non-stationarity and prediction lags that challenge traditional econometric models. This study proposes a hybrid forecasting framework with two distinguishing features. First, a multi-source exogenous variable fusion design integrates WTI crude oil and EUA carbon futures as predictive inputs, capturing cross-market energy–climate coupling rather than relying on univariate price history. Second, a dual-evaluation paradigm systematically contrasts ex-post global decomposition (theoretical upper bound) with strict rolling-window out-of-sample testing (real-time deployment constraint) to delineate the boundary between structural predictability and actionable arbitrage. Empirical analysis of Dalian Commodity Exchange data (2018−2025) shows that the VMD-LSTM model reduces Root Mean Square Error by 31.2% (from 49.25 to 33.91) and achieves 62.69% directional accuracy, outperforming comparable decomposition−ensemble models including VMD-SVR and EMD-LSTM architectures reported in recent energy forecasting studies. Under rolling-window constraints, directional accuracy is preserved at 54.26%, confirming robust trend detection despite amplitude degradation from the VMD endpoint effect. This divergence demonstrates that while carbon–coal predictive linkages possess substantial structural value for macro-level risk management, the energy futures market remains highly efficient against high-frequency statistical arbitrage. © 2026 Taylor & Francis Group, LLC.},
	author_keywords = {Carbon neutrality; coking coal futures; economic value assessment; market microstructure; price forecasting; VMD-LSTM},
	keywords = {Carbon; Coal; Costs; Electronic trading; Energy policy; Forecasting; Global optimization; Power markets; Risk management; Carbon neutralities; Coking coal; Coking coal future; Economic value assessment; Economic values; Hybrid forecasting; Market microstructures; Price forecasting; Value assessment; VMD-LSTM; Mean square error},
	correspondence_address = {Z. Zhou; School of Management, China University of Mining and Technology, Beijing, China; email: 2310570532@student.cumtb.edu.cn},
	publisher = {Taylor and Francis Ltd.},
