	keywords = {Adaptive boosting; Costs; Crude oil price; Deep learning; Economic and social effects; Forecasting; International trade; Learning systems; Petroleum analysis; Carbon black price prediction; Crude oil forecasting; GRU; Learning models; LSTM; Machine-learning; Oil forecasting; Price prediction; Time series forecasting; Xgboost; Carbon black},
