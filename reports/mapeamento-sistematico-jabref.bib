  url                 = {https://www.scopus.com/pages/publications/105040690329?origin=resultslist},
}

@Article{Zhuang2025a,
  author                 = {Zhuang, Fujin and Chen, Xiao and Horata, Punyaphol and Sunat, Khamron},
  journal                = {IEEE Access},
  title                  = {Research on Hybrid Architecture Neural Networks for Time Series Prediction},
  year                   = {2025},
  issn                   = {21693536},
  note                   = {Cited by: 5; All Open Access; Gold Open Access; Green Open Access},
  pages                  = {101507 - 101531},
  volume                 = {13},
  abbrev_source_title    = {IEEE Access},
  abstract               = {In recent years, agricultural product price forecasting has played a crucial role in supply chain management and market decision-making. However, due to the influence of multiple factors such as supply-demand dynamics, seasonality, and weather conditions, agricultural product prices exhibit highly nonlinear and dynamic characteristics, making traditional methods often insufficient for accurate price change prediction. To address these challenges, this paper proposes a novel time series prediction model based on Temporal Convolutional Network (TCN), Multi-Layer Perceptron (MLP), and attention mechanism (referred to as “TCN-MLP-Attention”), using daily average price data from the U.S. avocado market from 2015 to 2023. The model aims to provide more accurate price trend forecasts for various stages of the supply chain. In the model architecture design, the TCN module utilizes causal convolution structure and dilated convolution to handle long-term temporal dependencies; the MLP module performs feature transformation and nonlinear mapping through a two-layer network; and the attention mechanism identifies important features at key time steps. This multi-module collaborative architecture effectively processes multi-scale features of time series data while providing model interpretability. Through comparative analysis of various optimization algorithms’ convergence performance and prediction accuracy, this study found that the AdamW optimizer, with its effective weight decay mechanism and adaptive learning rate, demonstrated superior performance in training stability and generalization capability, with MSE and R<sup>2</sup> metrics outperforming traditional optimizers. Therefore, the AdamW optimizer with an adaptive learning rate adjustment strategy was adopted for model training. Experimental results show that the proposed TCN-MLP-Attention model exhibits better prediction performance compared to the baseline Transformer model: MSE decreased by approximately 1.24%, and R<sup>2</sup> increased by about 0.17%, indicating stronger generalization ability in capturing time series features. Although MAE was slightly higher, the overall error control remained within an acceptable range, validating the model’s stability and effectiveness. The importance of the attention mechanism was further verified through ablation experiments, with the complete model’s R<sup>2</sup> value improving by 87.04% and MSE decreasing by 87.18% compared to using TCN alone, confirming the effectiveness of the multi-module collaborative design. The model’s generalization capability is further validated through noise robustness tests and cross-product validation experiments. Even with medium-level noise (σ ~ 0.05 ), the model maintains 77% of its R<sup>2</sup> value, and when applied to strawberry price prediction using the dataset published by the United States Department of Agriculture Economic Research Service (USDA ERS)—a product with significantly different market characteristics—it achieves an R<sup>2</sup> value of 0.7499 without any retraining, demonstrating strong adaptability to different data distributions. This research not only demonstrates the superiority of this hybrid architecture in handling complex time series prediction tasks, especially showing strong adaptability during market fluctuation periods, but also provides new research directions for deep learning applications in agricultural price prediction. © 2013 IEEE.},
  affiliations           = {Khon Kaen University, College of Computing, Department of Computer Science, Khon Kaen, 40002, Thailand},
  author_keywords        = {attention mechanism; deep learning; multi-layer perceptron (MLP); Price prediction; temporal convolutional network (TCN); time-series forecasting},
  correspondence_address = {P. Horata; Khon Kaen University, College of Computing, Department of Computer Science, Khon Kaen, 40002, Thailand; email: punhor1@kku.ac.th},
  doi                    = {10.1109/ACCESS.2025.3578325},
  groups                 = {Previsão + Otimização},
  keywords               = {Agricultural products; Architecture; Commerce; Convolution; Convolutional neural networks; Costs; Decision making; Forecasting; Learning algorithms; Mathematical transformations; Network layers; Supply chain management; Time series; Attention mechanisms; Convolutional networks; Deep learning; Multi-layer perceptron; Multilayers perceptrons; Optimizers; Price prediction; Temporal convolutional network; Time series forecasting; Time series prediction; Deep learning},
  language               = {English},
  publication_stage      = {Final},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  source                 = {Scopus},
  type                   = {Article},
  url                    = {https://www.scopus.com/pages/publications/105007899130?origin=resultslist},
}

@Conference{Destriana2025,
  author                 = {Destriana, Rachmat and Husain, Syepry Maulana and Taufiq, Rohmat and Hamdani},
  booktitle              = {2025 5th International Conference of Science and Information Technology in Smart Administration (ICSINTESA)},
  title                  = {Hybrid Statistical-Deep Learning Framework for Modeling Food Price Volatility Using ARIMA, LSTM, and Transformer Networks},
  year                   = {2025},
  editor                 = {Wibowo F.W.},
  month                  = {Nov},
  note                   = {Cited by: 1},
  pages                  = {299 - 304},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {Proc. ICSINTESA - Int. Conf. Sci. Inf. Technol. Smart Adm.},
  abstract               = {Price volatility of staple foods in Indonesia - driven by supply chain disruptions, climate anomalies, and global market dynamics - poses significant challenges to national food security and economic planning. This study proposes and implements a hybrid forecasting framework that combines Autoregressive Integrated Moving Average (ARIMA), Long Short-Term Memory (LSTM), and Transformer models to predict the prices of key staple commodities including rice, cooking oil, chicken meat, eggs, shallots, red chilies, and sugar. Using monthly retail price data from 2021 to 2024 provided by the Central Bureau of Statistics (BPS) and the National Food Agency (Bapanas), the model leverages ARIMA for linear trend extraction, LSTM for temporal dependencies, and Transformer for capturing non-linear patterns and global interactions. Experimental results demonstrate that the hybrid model achieves a 15.5% reduction in RMSE compared to the best-performing baseline (Transformer-only, average RMSE = 2,900), indicating not only statistical but also practical improvement in forecast precision. While the hybrid model requires higher computational resources than individual models, its deployment as a containerized REST API ensures scalability and operational efficiency suitable for institutional use. This implementation offers a practical decision-support tool for Indonesian policymakers to stabilize food markets and mitigate inflation risks in highly volatile environments. © 2025 IEEE.},
  affiliations           = {Universitas Muhammadiyah Tangerang, Department of Informatics Engineering, Tangerang, Indonesia; Universitas Muhammadiyah Tangerang, Department of Economic and Business, Tangerang, Indonesia},
  author_keywords        = {AI-Based Economic Modeling; ARIMA-LSTM-Transformer Architecture; Big Data Analytics for Policy Decision Support; Food Price Prediction; Hybrid Time-Series Forecasting},
  correspondence_address = {R. Destriana; Universitas Muhammadiyah Tangerang, Department of Informatics Engineering, Tangerang, Indonesia; email: rachmat.destriana@umt.ac.id},
  doi                    = {10.1109/ICSINTESA68165.2025.11413696},
  groups                 = {Previsão + Otimização},
  isbn                   = {979-833155699-0},
  journal                = {Proceedings ICSINTESA 2025 - 2025 5th International Conference of Science and Information Technology in Smart Administration},
  keywords               = {Advanced Analytics; Autoregressive moving average model; Big data; Costs; Decision support systems; Economic analysis; Food security; Food supply; Forecasting; International trade; National security; Prediction models; Supply chains; AI-based economic modeling; Auto-regressive; Autoregressive integrated moving average-long short-term memory-transformer architecture; Big data analytic for policy decision support; Data analytics; Decision supports; Economic models; Food price prediction; Food prices; Hybrid time-series forecasting; Moving averages; Policy decisions; Price prediction; Short term memory; Time series forecasting; Long short-term memory},
  language               = {English},
  publication_stage      = {Final},
  source                 = {Scopus},
  type                   = {Conference paper},
  url                    = {https://www.scopus.com/pages/publications/105035371925?origin=resultslist},
}

