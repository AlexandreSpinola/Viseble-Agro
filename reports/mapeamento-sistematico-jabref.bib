  keywords  = {Support vector machines;Machine learning algorithms;Uncertainty;Oils;Multimedia systems;Sociology;Neural networks;crude oil;ensemble;machine learning;hybrid},
}

@InProceedings{Wei2022,
  author    = {Wei, Wei and Liu, Xing},
  booktitle = {2022 4th International Conference on Machine Learning, Big Data and Business Intelligence (MLBDBI)},
  title     = {Research on Futures Price Forecast of WVMD-LSTM Model},
  year      = {2022},
  month     = {Oct},
  pages     = {124-127},
  abstract  = {The research on futures price prediction is of great significance to society and enterprises. In order to cope with the increasingly complex financial market environment, this paper proposes a new hybrid model, WVMD-LSTM, to improve the accuracy of futures price prediction by capturing the information of multiple dimensions in futures data. A series of single models and mixed models are used to comprehensively compare the forecasting performance of VMD-LSTM model, and the gold futures price is selected to verify the effectiveness of WVMDLSTM in futures price forecasting. The performance of the WVMD-LSTM model is comprehensively evaluated by fitting degree indicators (RMSE, MAE, MAPE, R2) and direction accuracy indicators with economic significance $(\mathrm{D}_{\mathrm{s}\mathrm{t}\mathrm{a}\mathrm{t}})$. The results show that compared with ARIMA, VMD-LSTM, WVMD-LSTM has the best prediction ability.},
  doi       = {10.1109/MLBDBI58171.2022.00030},
  keywords  = {Economics;Adaptation models;Gold;Machine learning algorithms;Fitting;Machine learning;Predictive models;futures price forecast;VMD;LSTM;WOA;optimization algorithm},
