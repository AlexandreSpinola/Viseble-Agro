  booktitle              = {2026 4th International Conference on Big Data and Privacy Computing (BDPC)},
  title                  = {Predicting Multi-commodity Futures Price with FourierGNN},
  year                   = {2026},
  month                  = {May},
  note                   = {Cited by: 0},
  pages                  = {131 - 140},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {Int. Conf. Big Data Priv. Comput., BDPC},
  abstract               = {The commodity futures market is characterized by complex spatiotemporal dependencies and high volatility, making accurate price prediction a challenging task. Traditional forecasting models often focus on single-commodity analysis or rely on discrete spatiotemporal modeling, failing to capture the dynamic interdependencies and periodic patterns across diverse commodities. This paper applies FourierGNN to the task of multi-commodity futures price forecasting and constructs a forecasting framework that integrates multi-scale feature extraction, hypervariate graph modeling, and frequency-domain graph convolutions. By mapping multivariate time series into a unified hypervariate graph, the model jointly captures price dynamics and cross-commodity spatial correlations. The frequency-domain graph convolution mechanism efficiently extracts periodic features while maintaining log-linear computational complexity. Empirical evaluations on a comprehensive dataset of 59 commodity futures across five commodity sectors demonstrate that FourierGNN significantly outperforms state-of-the-art baselines in both long-term and short-term prediction tasks. The results highlight the model's superior generalization ability and robustness in volatile market environments, providing a scalable framework for multi-commodity financial forecasting.  © 2026 IEEE.},
  affiliations           = {Central University of Finance and Economics, School of Information, Beijing, China},
  author_keywords        = {Fourier Transform; Futures Price Prediction; Graph Neural Networks; Multi-commodity Modeling; Spatiotemporal Analysis},
  correspondence_address = {N. Zhang; Central University of Finance and Economics, School of Information, Beijing, China; email: zhangning@cufe.edu.cn},
  doi                    = {10.1109/BDPC69980.2026.11608073},
  isbn                   = {979-831951945-0},
  journal                = {2026 4th International Conference on Big Data and Privacy Computing, BDPC 2026},
  keywords               = {Commerce; Costs; Electronic trading; Financial markets; Forecasting; Graph theory; Prediction models; Commodity futures; Fourier; Frequency domains; Future price prediction; Graph neural networks; Multi-commodity; Multi-commodity modeling; Price prediction; Spatio-temporal dependencies; Spatiotemporal analysis; Convolution},
