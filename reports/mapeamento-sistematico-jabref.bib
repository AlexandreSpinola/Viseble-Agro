@Conference{Zhuang2025,
  author                 = {Zhuang, Fujin and Horata, Punyaphol and Sunat, Khamron},
  title                  = {Integrating temporal and static features: a novel deep learning architecture for accurate sales prediction},
  year                   = {2025},
  editor                 = {Luo S. and Saxena A.},
  note                   = {Cited by: 0},
  publisher              = {SPIE},
  volume                 = {13692},
  abbrev_source_title    = {Proc SPIE Int Soc Opt Eng},
  abstract               = {Agricultural commodity price prediction faces significant challenges due to complex temporal dependencies, high market volatility, and the interaction between dynamic and static features. Traditional methods and existing deep learning models often struggle to address these complexities effectively, particularly in scenarios with data imbalance and pronounced temporal fluctuations. To address these issues, this study proposes a novel hybrid deep learning framework TCN-MLP-GRU. This framework innovatively integrates Temporal Convolutional Networks (TCN), Multilayer Perceptrons (MLP), and Gated Recurrent Units (GRU) to enhance prediction accuracy. By leveraging the hierarchical temporal feature extraction capability of TCN through dilated convolutions, the ability of MLP to model complex nonlinear relationships in static features, and GRU's strength in capturing sequential patterns and long-term dependencies, the framework achieves a systematic integration. We evaluated the model's performance on a comprehensive dataset provided by the Hass Avocado Board, which includes 53,415 price records from 2015 to 2023.Experimental results demonstrate that the model achieves an R<sup>2</sup> score of 0.8571 and a Mean Squared Error (MSE) of 0.0011, significantly outperforming baseline models. Ablation studies further confirm the substantial contribution of each component to the overall performance, particularly in addressing price volatility and seasonal patterms. This study provides a robust theoretical foundation for agricultural price prediction and offers practical value for market participants in inventory management, supply chain optimization, and strategic planning. © 2025 SPIE.},
  affiliations           = {College of Computing, Khon Kaen University, Khon Kaen, Thailand},
  author_keywords        = {Deep Learning; Gated Recurrent Unit; Hybrid Architecture; Multilayer Perceptron; Price Prediction; Temporal Convolutional Network},
  coden                  = {PSISD},
  correspondence_address = {P. Horata; College of Computing, Khon Kaen University, Khon Kaen, Thailand; email: punhor1@kku.ac.th},
  doi                    = {10.1117/12.3068917},
  groups                 = {Previsão + Otimização},
  isbn                   = {978-151069330-2},
  issn                   = {0277786X},
  journal                = {Proceedings of SPIE - The International Society for Optical Engineering},
  keywords               = {Agriculture; Commerce; Complex networks; Convolution; Convolutional neural networks; Costs; Electronic trading; Financial markets; Forecasting; Inventory control; Learning systems; Mean square error; Multilayers; Supply chain management; Supply chains; Convolutional networks; Deep learning; Gated recurrent unit; Hybrid architectures; Learning architectures; Multilayers perceptrons; Price prediction; Static features; Temporal convolutional network; Temporal features; Deep learning},
  language               = {English},
