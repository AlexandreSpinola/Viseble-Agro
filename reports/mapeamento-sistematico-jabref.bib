@Conference{Bisen2026,
  author              = {Bisen, Samruddhi and Mandhane, Nandini and Raut, Anushka and Katore, Ashvini and Sakhare, Apeksha},
  booktitle           = {2026 Second International Conference on Intelligent Systems for Communication, IoT and Security (ICISCoIS)},
  title               = {KrishiMitra: An Intelligent IoT-AI Platform for Sustainable Agriculture},
  year                = {2026},
  month               = {Jan},
  note                = {Cited by: 0},
  pages               = {1-7},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Intell. Syst. for Commun., IoT Secur., ICISCoIS},
  abstract            = {This paper introduces KrishiMitra, a bilingual farm-to-consumer and smart-farming platform for Indian smallholders that integrates agronomic decision support with an integrated market to enhance productivity, input use efficiency, and income security. The system consumes soil and climate characteristics (soil type, N-P-K, pH, rainfall, temperature, humidity) from sensors or manual input and uses supervised machine-learning pipelines for ranking appropriate crops with predicted yield ranges, creating crop-specific NPK regimes with basal/top-dress schedules, predicting commodity prices for short and medium horizons, and forecasting per-hectare and total yields for planning of operations; a role-based application layer then implements these results through inventory listing, cart checkout (UPI/COD/pickup/card), and two-sided order tracking with status transitions. Experimental rollouts in representative situations yielded season-specific crop advice with suitably high suitability scores, consistent price paths, confidence-rated yield forecasts, and actionable fertilizer schedules, while functional testing validated smooth ordering and farmer-level controls, showing the feasibility of an end-to-end advisory-commerce process. Through decreased decision uncertainty, restricting nutrient overuse, and supply chain shortening through direct farmer-consumer interfaces, KrishiMitra promotes sustainable input usage, improves farm profitability, and enhances local food resilience through affordable, multilingual digital services.  © 2026 IEEE.},
  affiliations        = {G H Raisoni College of Engineering, Nagpur, India},
  author_keywords     = {Crop Yield Prediction; IoT; Machine Learning; Market Price Forecasting; Precision Agriculture; Smart Farming; Soil Monitoring; Sustainable Agriculture},
  doi                 = {10.1109/ICISCoIS62701.2026.11447903},
  groups              = {Suporte à Decisão Agrícola},
  isbn                = {979-833154596-3},
  journal             = {2026 2nd International Conference on Intelligent Systems for Communication, IoT and Security, ICISCoIS 2026},
  keywords            = {Agricultural machinery; Commerce; Costs; Crops; Electronic trading; Financial markets; Forecasting; Precision agriculture; Smart agriculture; Soil testing; Soils; Supervised learning; Crop yield; Crop yield prediction; IoT; Machine-learning; Market price; Market price forecasting; Precision Agriculture; Price forecasting; Smart farming; Soil monitoring; Sustainable agriculture; Yield prediction; Learning systems},
