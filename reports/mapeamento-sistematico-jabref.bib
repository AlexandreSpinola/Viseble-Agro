  volume                 = {149},
  abbrev_source_title    = {Appl. Soft Comput.},
  abstract               = {Agricultural product prices are subject to significant fluctuations due to variations in sales cycles, impacting people's quality of life and farmers' income while potentially giving rise to social problems. To address this issue in the smart agriculture supply chain, advancements in technologies like big data and artificial intelligence have made it feasible to predict agricultural product demand and price trends. Among the research methods, deep learning, being highly reliant on data and possessing multi-layered implicit information, has emerged as the most popular research method, exhibiting better data representation and prediction capabilities. In this study, we propose an end-to-end agricultural product price prediction model that combines complementary ensemble empirical mode decomposition (CEEMD) with long short-term memory (LSTM). The prediction generated by this model will provide guidance throughout various supply chain links, including production, harvesting, storage, and logistics. Moreover, the study aims to develop auction mechanisms based on the prediction results to achieve an optimal allocation of agricultural products. To address issues of low computational efficiency and limited benefit distribution in the auction process, this study introduces a deep learning-based iterative bilateral auction algorithm (DL-IDA), which improves upon existing methodologies by leveraging the power of deep learning. Empirical analysis is conducted using the daily price of Fuji apples at the Beijing Xinfadi market. The results demonstrate that the CEEMD-LSTM model proposed in this study exhibits superior performance in predicting agricultural product prices. Furthermore, experimental findings validate the effectiveness and superiority of DL-IDA. Compared to existing iterative bilateral auction algorithms, DL-IDA offers better performance in terms of running time, social welfare, buyer benefits, seller benefits, and broker benefits. Consequently, it can contribute to a transparent pricing mechanism for agricultural products. © 2023 Elsevier B.V.},
  affiliations           = {School of Economies and Business Administration, Chongqing University, Chongqing, 400044, China; Institute of Agricultural Resources and Regional Planning (IARRP), Chinese Academy of Agricultural Sciences, Beijing, 100081, China},
  author_keywords        = {Data prediction; Deep learning; Double auction; Long short-term memory; Supply chain},
  correspondence_address = {D. Mei; Institute of Agricultural Resources and Regional Planning (IARRP), Chinese Academy of Agricultural Sciences, Beijing, 100081, China; email: meidongcaas@163.com},
  doi                    = {10.1016/j.asoc.2023.111009},
  groups                 = {Previsão + Otimização},
  keywords               = {Brain; Combinatorial optimization; Computational efficiency; Costs; Forecasting; Iterative methods; Learning systems; Long short-term memory; Supply chains; Agricultural supply chains; Auction algorithms; Chain-mechanism; Data prediction; Deep learning; Double auction; Empirical Mode Decomposition; Performance; Product price; Research method; Agricultural products},
  language               = {English},
  publication_stage      = {Final},
  publisher              = {Elsevier Ltd},
  source                 = {Scopus},
  type                   = {Article},
  url                    = {https://www.scopus.com/pages/publications/85176505608?origin=resultslist},
}

@Article{Jin2026b,
  author                 = {Jin, Bingzi and Xu, Xiaojie},
  journal                = {Food and Humanity},
  title                  = {Predicting early indica rice prices utilizing Bayesian-optimized machine learning models employing Gaussian process regressions},
  year                   = {2026},
  issn                   = {29498244},
  note                   = {Cited by: 7},
  volume                 = {7},
  abbrev_source_title    = {Food Humanity.},
  abstract               = {Constructing predictive frameworks for agricultural commodity valuation is critical for informing operational decision-making among market participants and refining policy development. As a staple crop integral to global food security infrastructure, rice necessitates rigorous analytical approaches in price forecasting given its socioeconomic significance. This research addresses the challenge of estimating weekly wholesale price trends for early indica rice in Chinese commodity markets, utilizing datasets spanning April 2011 to September 2019. The methodology implements Gaussian process regression (GPR) models, enhanced via cross-validation procedures and Bayesian hyperparameter tuning applied to diverse kernel structures and basis formulations. Results indicate parsimonious predictive frameworks capable of achieving equilibrium between interpretability and accuracy for this economically vital crop. In out-of-sample evaluations conducted between January 2018 and September 2019, the optimized system achieved a relative root mean square error (RRMSE) of 0.2929%, demonstrating robust predictive capability. The analytical approach provides actionable insights for market participants and policymakers engaged in agricultural commodity management. © 2026 Elsevier B.V.},
