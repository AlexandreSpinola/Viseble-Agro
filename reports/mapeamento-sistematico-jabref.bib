}

@Conference{Ergun2025,
  author                 = {Ergun, Halime and Tosun, Nezire and Keskin, Halil Ibrahim and Tas, Omer Faruk and Demirbas, Leman and Koken, Fikri and Goktepe, Yunus Emre and Besir, Kerim},
  booktitle              = {2025 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)},
  title                  = {An AI-Enhanced IoT System for Soilless Agriculture: Environmental Monitoring and Market-Driven Decision Support Integration},
  year                   = {2025},
  month                  = {Aug},
  note                   = {Cited by: 0},
  pages                  = {1-6},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {Int. Conf. Artif. Intell. Comput., Data Sci., Appl., ACDSA},
  abstract               = {This study presents an AI-enhanced IoT system designed for soilless agriculture, aiming to monitor environmental conditions, automate climate control, and optimize production decisions based on market data. The system is built on the Deneyap microcontroller and is equipped with sensors that measure temperature, humidity, light intensity, water level, and air quality. Sensor data are transmitted in real time to a mobile application through a cloud-based database service, enabling both manual and automatic operation modes. In automatic mode, environmental parameters are compared to predefined thresholds to activate fan, pump, and lighting systems. Additionally, a machine learning model based on the Random Forest Regressor algorithm was developed to analyze market demand, price fluctuations, and seasonal trends. Trained on wholesale price data from Izmir Municipality (2019-2022), the model provides price forecasts for selected products on specific dates predictive insights for various product-date combinations and contributes to production planning. The integrated approach of environmental monitoring and market-aware decision-making demonstrates a novel, scalable, and practical solution for smart agriculture practices. © 2025 IEEE.},
  affiliations           = {Necmettin Erbakan University, Seydisehir Ahmet Cengiz Faculty of Engineering, Department of Computer Engineering, Konya, Turkey; Necmettin Erbakan University, Institute of Science, Department of Mechatronic Engineering, Konya, Turkey},
  author_keywords        = {Agricultural decision support system; Artificial intelligence; IoT-based automation; Mobile application; Price prediction; Random Forest; Smart farming; Soilless agriculture},
  correspondence_address = {H. Ergun; Necmettin Erbakan University, Seydisehir Ahmet Cengiz Faculty of Engineering, Department of Computer Engineering, Konya, Turkey; email: hboztoprak@erbakan.edu.tr},
  doi                    = {10.1109/ACDSA65407.2025.11166509},
  groups                 = {Previsão + Otimização},
