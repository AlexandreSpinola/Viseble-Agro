@Conference{Lubag2025,
  author                 = {Lubag, Marian and Perocho, Perrie Lance and Co, Robina and Concepcion, Ronnie and Del-Amen, Jesson and Maniquiz-Redillas, Marla},
  booktitle              = {2025 IEEE 17th International Conference on Humanoid, Nanotechnology, Information Technology, Communication and Control, Environment, and Management (HNICEM)},
  title                  = {Hinterland Lettuce Selling Price Forecasting Model Using Recurrent Neural Networks},
  year                   = {2025},
  month                  = {Nov},
  note                   = {Cited by: 0},
  pages                  = {1-6},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {IEEE Int. Conf. Humanoid, Nanotechnol., Inf. Technol., Commun. Control, Environ., Manag., HNICEM},
  abstract               = {Lettuce has a relatively short growth cycle and thrives in cooler climates, making it a primary crop cultivated in highland agricultural regions such as Benguet, Philippines. However, the varying harvest schedules across farms lead to inconsistent daily supply, resulting in days when specific lettuce varieties are unavailable in the market. This intermittency is evident in Benguet Agri-Pinoy Trading Center (BAPTC), the province's central trading facility, and poses challenges for price forecasting because machine learning models rely on continuous historical price sequences to capture temporal dependencies. To address this limitation, this study evaluates eight machine learning and deep learning models under a unified architecture and identifies the most effective approach for non-continuous pricing data. Following extensive model comparison, a three-layer Bidirectional Gated Recurrent Unit (BiGRU) network was selected and subsequently optimized through a multi-stage optimization procedure involving epoch tuning, layer-depth selection, and hidden-node optimization using Multi-Gene Genetic Programming (MGGP) and Levenberg-Marquardt search. The optimized model achieved strong predictive performance, with a test RMSE of 15.85, MAE of 8.97, MAPE of 25.52%, and an R<sup>2</sup> of 0.95. To further support trend interpretation and decision-making, the model was used to generate a one-year price projection for each lettuce variety, enabling clearer assessment of seasonal patterns and potential periods of price volatility. © 2025 IEEE.},
  affiliations           = {De La Salle University, Department of Biomedical, Manufacturing, and Robotics Engineering, Manila, Philippines; De La Salle University, Center for Engineering and Sustainable Development Research, Manila, Philippines; De La Salle University, Center for Natural Sciences and Environmental Research, Manila, Philippines; Benguet State University, Department of Crop Science, College of Agriculture, La Trinidad, Philippines; De La Salle University, Department of Civil Engineering, Manila, Philippines},
  author_keywords        = {bidirectional GRU; historical price data; non-continuous data; price trend analytics},
  correspondence_address = {M. Lubag; De La Salle University, Department of Biomedical, Manufacturing, and Robotics Engineering, Manila, Philippines; email: marian_m_lubag@dlsu.edu.ph},
