  journal             = {Indian Journal of Agricultural Economics},
  title               = {A Novel Ensemble Machine Learning Approach for Forecasting Oilseeds Prices in India},
  year                = {2024},
  issn                = {00195014},
  note                = {Cited by: 0; All Open Access; Bronze Open Access},
  number              = {4},
  pages               = {978 - 992},
  volume              = {79},
  abbrev_source_title = {Indian J. Agric. Econ.},
  abstract            = {The oilseed crops hold significant agricultural importance globally, particularly in India, where they contribute significantly to economic growth and food security. However, predicting its prices accurately remains challenging due to complex factors such as supply-demand dynamics, weather fluctuations, and global economic conditions. This study investigates price forecasting for major oilseed crops using traditional statistical models like autoregressive integrated moving average (ARIMA) and simple exponential smoothing (SES), alongside machine learning (ML) algorithms including artificial neural networks (ANN), random forest (RF), support vector regression (SVR), and K-nearest neighbors (KNN). The research employs a weighted ensemble (WE) approach based on the cuckoo search (CS) algorithm for weight optimization and model confidence set (MCS) for superior model selection. The ensemble model integrates predictions from multiple models, aiming to enhance forecast accuracy and reliability. Monthly wholesale price data of major oilseed crops from January 2010 to June 2024 across various markets from different states of India, sourced from AGMARKNET, have been analyzed. Results show that the proposed CS-WE model outperformed all the candidate models and suggest using an ensemble approach rather than a single model in managing risks and improving decision-making in the oilseed sector. © 2024 Indian Society of Agricultural Economics. All rights reserved.},
  affiliations        = {ICAR-Indian Agricultural Research Institute, New Delhi, 110 012, India; ICAR-Indian Agricultural Statistics Research Institute, New Delhi, 110 012, India},
  author_keywords     = {CS; Ensemble; machine learning; MCS; oilseed crops; price prediction},
  doi                 = {10.63040/25827510.2024.04.006},
  keywords            = {India; algorithm; crop; machine learning; numerical model; prediction; price determination; statistical analysis},
  language            = {English},
  publication_stage   = {Final},
  publisher           = {Indian Society of Agricultural Economics},
  source              = {Scopus},
  type                = {Article},
  url                 = {https://www.scopus.com/pages/publications/105010536421?origin=resultslist},
}

@ARTICLE{Wang2020,
	author = {Wang, Jue and Zhou, Hao and Hong, Tao and Li, Xiang and Wang, Shouyang},
	title = {A multi-granularity heterogeneous combination approach to crude oil price forecasting},
	year = {2020},
	journal = {Energy Economics},
	volume = {91},
	pages = {},
	doi = {10.1016/j.eneco.2020.104790},
	url = {https://www.scopus.com/pages/publications/85089599926?origin=resultslist},
	affiliations = {CEFS, MADIS, Academy of Mathematics and Systems Science, Chinese Academy of Sciences, Beijing, 100190, China; University of Chinese Academy of Sciences, Beijing, 100190, China; Systems Engineering and Engineering Management Department, University of North Carolina at Charlotte, United States},
	abstract = {Crude oil price forecasting has attracted much attention due to its significance on commodities market as well as nonlinear complexity in prediction task. Combining forecasts in different granular spaces, we propose a multi-granularity heterogeneous combination approach to enhance forecasting accuracy in the study. Firstly, we introduce various feature selection techniques including filter, wrapper and embedded methods, to identify key factors that affect crude oil price and construct different granular spaces. Secondly, distinct feature subsets distinguished by different feature selection methods are incorporated to generate individual forecasts using three popular forecasting models including Linear regression (LR), Artificial neural network (ANN) and Support vector machine (SVR). Finally, the final forecasts are obtained by combining the forecasts from individual forecasting model in each granular space and the optimal weighting vector is achieved by artificial bee colony (ABC) techniques. The experimental results demonstrate that the proposed multi-granularity heterogeneous combination approach based on ABC can outperform not only individual competitive benchmarks but also single-granularity heterogeneous and multi-granularity homogenous approaches. © 2020 Elsevier B.V.},
	author_keywords = {Artificial bee colony; Crude oil Price; Feature selection; Forecast combination; Multi-granularity},
	keywords = {Apoidea; Feature extraction; Forecasting; Optimization; Support vector machines; Support vector regression; Vector spaces; Artificial bee colonies (ABC); Combination approaches; Crude oil price forecasting; Feature selection methods; Forecasting accuracy; Forecasting modeling; Nonlinear complexity; Optimal weighting vector; accuracy assessment; artificial neural network; competitiveness; crude oil; energy market; forecasting method; oil supply; price dynamics; support vector machine; Crude oil price},
	correspondence_address = {T. Hong; Systems Engineering and Engineering Management Department, University of North Carolina at Charlotte, United States; email: hong@uncc.edu},
	publisher = {Elsevier B.V.},
	issn = {01409883},
	coden = {EECOD},
	language = {English},
	abbrev_source_title = {Energy Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 74}
}

@Article{Yan2022,
  author                 = {Yan, Wenjing and Zhang, Zesheng and Zhang, Qingchuan and Zhang, Ganggang and Hua, Qiaozhi and Li, Qiao},
  journal                = {Frontiers in Public Health},
  title                  = {Deep Data Analysis-Based Agricultural Products Management for Smart Public Healthcare},
  year                   = {2022},
  issn                   = {22962565},
  note                   = {Cited by: 12; All Open Access; Gold Open Access; Green Open Access},
  volume                 = {10},
  abbrev_source_title    = {Front. Public Health},
  abstract               = {Agricultural is an indispensably public healthcare industry for human beings at any time and smart management of it is of great significance. Since substantial technical advance relies on long-term efforts and continuous progress, reasonably scheduling the distribution of agricultural products acts as a key aspect of smart public healthcare. The most intuitive factor affecting the distribution of agricultural products is its dynamic price. Forecasting price fluctuations in advance can optimize the distribution of agricultural products and pave the way to smart public healthcare. Most researchers study the prices of various agricultural products separately, without considering the interaction of different agricultural products in the time dimension. This study introduces a typical deep learning model named graph neural network (GNN) for this purpose and proposes deep data analysis-based agricultural products management for smart public healthcare (named GNN-APM for short). The highlight of GNN-APM is to take latent correlations among multiple types of agricultural products into consideration when modeling evolving rules of price sequences. A case study is set up with the use of real-world data of the agricultural products market. Simulative results reveal that the designed GNN-APM functions well. Copyright © 2022 Yan, Zhang, Zhang, Zhang, Hua and Li.},
  affiliations           = {National Engineering Laboratory for Agri-Product Quality Traceability, Beijing Technology and Business University, Beijing, China; Digital Campus Construction Center, Capital Normal University, Beijing, China; Computer School, Hubei University of Arts and Science, Xiangyang, China; Chongqing Key Laboratory of Intelligent Perception and Blockchain Technology, Chongqing Technology and Business University, Chongqing, China},
  author_keywords        = {agricultural products; deep data analysis; graph neural network; public healthcare; smart management},
  correspondence_address = {Q. Hua; Computer School, Hubei University of Arts and Science, Xiangyang, China; email: 11722@hbuas.edu.cn},
  doi                    = {10.3389/fpubh.2022.847252},
  groups                 = {Predição de Commodities},
  keywords               = {Agriculture; Data Analysis; Delivery of Health Care; Forecasting; Humans; Neural Networks, Computer; article; data analysis; deep learning; forecasting; human; price},
  language               = {English},
  pmid                   = {35462816},
