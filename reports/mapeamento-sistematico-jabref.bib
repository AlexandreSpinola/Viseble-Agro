@Conference{Aldo2025,
  author              = {Aldo, Dasril and Firmansyah, Muhammad Raafi'u and Zalmi, Wahyuni Fithratul and Paramadini, Adanti Wido and Fathan, Faizal Burhani Ulil},
  booktitle           = {2025 International Conference on Information Technology Research and Innovation (ICITRI)},
  title               = {Optimizer Exploration on Long Short-Term Memory Architecture for Dry Bean Soybean Price Movement Prediction},
  year                = {2025},
  month               = {Sep.},
  note                = {Cited by: 0},
  pages               = {1-5},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Proceeding - Int. Conf. Inf. Technol. Res. Innov.: Harnessing Intell. Mach. Sustain. Dev.: Aligning AI SDGs, ICITRI},
  abstract            = {The volatility of agricultural commodity prices requires reliable prediction models to assist in making informed decisions in the market. This study evaluates the performance of various optimization algorithms in training Long Short-Term Memory (LSTM) architectures to predict daily dry soybean prices. The dataset is from the Indonesian National Food Price Panel, covering the period from April 1, 2021, to February 10, 2025. Data pre-processing steps include missing value imputation through linear interpolation and normalization through Min-Max Scaling. The LSTM model is evaluated based on three activation functions (Tanh, ReLU, Sigmoid) and seven optimization algorithms: Adam, RMSprop, SGD, Adagrad, Adadelta, Nadam, and AdamW. The model's predictive performance is evaluated based on the metrics MAE, RMSE, R2, loss value in the last epoch, and training time. The best results were obtained by combining the Sigmoid activation function with the Nadam optimizer, achieving an MAE of 0.011890, an RMSE of 0.022985, and an R2 of 0.639292, reflecting highly accurate predictions with stable training and low volatility. In contrast, combinations involving the SGD, Adagrad, and Adadelta optimizers consistently performed poorly. These results highlight the importance of determining the activation function and optimization algorithm in LSTM-based price-prediction models. The proposed best configuration can be optimally used for monitoring commodity prices and for decision-support systems in agriculture. This configuration can be further improved by adding external variables such as weather conditions or government policies.  © 2025 IEEE.},
  affiliations        = {Telkom University, Faculty of Informatics, Indonesia; Sam Ratulangi University, Faculty of Engineering, Indonesia; Telkom University, Faculty of Telecommunication and Electronics Engineering, Indonesia},
  author_keywords     = {Deep Learning; LSTM; Optimizer; Price Prediction; Soybean},
  doi                 = {10.1109/ICITRI67507.2025.11232753},
  isbn                = {979-833156940-2},
  journal             = {Proceeding - 2025 International Conference on Information Technology Research and Innovation: Harnessing Intelligent Machines for Sustainable Development: Aligning AI with the SDGs, ICITRI 2025},
  keywords            = {Agriculture; Chemical activation; Costs; Decision support systems; Electronic trading; Financial markets; Forecasting; Memory architecture; Tungsten alloys; Activation functions; Commodity prices; Deep learning; Dry beans; Optimization algorithms; Optimizers; Price movement; Price prediction; Short term memory; Soybean; Long short-term memory},
  language            = {English},
  publication_stage   = {Final},
  source              = {Scopus},
  type                = {Conference paper},
  url                 = {https://www.scopus.com/pages/publications/105029544800?origin=resultslist},
}

@Conference{Mustafo2026,
  author                 = {Mustafo, Sarvarov and Kashkimbayeva, Nurzhamal and Kaibassova, Dinara},
  booktitle              = {2026 IEEE 6th International Conference on Smart Information Systems and Technologies (SIST)},
  title                  = {Integrating Crop Yield Prediction with Market Price Forecasting for Data-Driven Crop Selection in Kazakhstan},
  year                   = {2026},
  month                  = {May},
  note                   = {Cited by: 0},
  pages                  = {1-7},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {SIST - IEEE Int. Conf. Smart Inf. Syst. Technol., Conf. Proc.},
  abstract               = {Existing crop recommendation systems achieve high classification accuracy but rely solely on agronomic parameters, ignoring market dynamics that determine farmer profitability. This paper proposes an integrated framework combining machine learning-based yield prediction with time-series price forecasting for economically optimal crop recommendations. Using 14 years of data (2010-2023) across five major crops and 14 oblasts of Kazakhstan, coupled with ERA5 climate reanalysis and market price records, we compare multiple models for yield prediction (Linear Regression, Random Forest, XGBoost, LSTM) and price forecasting (ARIMA, Random Forest, LSTM, GRU). The best models-XGBoost for yield (RMSE 0.271 t/ha, R2 0.847) and GRU for price (MAPE 7.86%)-are integrated into a profitability scoring framework with Markowitz-inspired risk adjustment. Backtesting on 2021-2023 shows 23.7% higher simulated profit and 26.2% lower variance compared to yield-only recommendations, providing preliminary evidence that bridging agronomic suitability with market awareness can improve farmer decision support. The system is framed as a decision-support approximation; broader temporal validation is needed to confirm generalizability.  © 2026 IEEE.},
  affiliations           = {School of Software Engineering, Astana IT University (AITU), Astana, Kazakhstan; School of Software Engineering, Astana IT University, Astana, Kazakhstan},
  author_keywords        = {agricultural decision support; Crop recommendation; Kazakhstan; machine learning; price forecasting; yield prediction},
  correspondence_address = {N. Kashkimbayeva; School of Software Engineering, Astana IT University, Astana, Kazakhstan; email: n.kashkimbayeva@astanait.edu.kz},
  doi                    = {10.1109/SIST61674.2026.11596318},
  isbn                   = {979-833158164-0},
  journal                = {SIST 2026 - 2026 IEEE 6th International Conference on Smart Information Systems and Technologies, Conference Proceedings},
  keywords               = {Agricultural machinery; Agronomy; Commerce; Costs; Crops; Decision support systems; Forecasting; Machine learning; Profitability; Agricultural decision support; Crop recommendation; Crop yield; Decision supports; Kazakhstan; Machine-learning; Market price; Price forecasting; Random forests; Yield prediction; Learning systems},
