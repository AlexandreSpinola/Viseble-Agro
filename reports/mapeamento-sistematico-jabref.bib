  author                 = {Soltani, Hayet and Taleb, Jamila and Ben Hamadou, Fatma and Boujelbène-Abbes, Mouna},
  journal                = {EuroMed Journal of Business},
  title                  = {Using machine learning to forecast clean energy, commodities, green bonds and ESG index prices: How important is financial stress?},
  year                   = {2026},
