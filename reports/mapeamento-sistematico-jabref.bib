@InProceedings{Vijava2023,
  author    = {Vijava, J. and Kumar, Pangoth Santhosh and Sorgile, Meetiksha and SV vasanth, Murukuri SV},
  booktitle = {2023 International Conference on Intelligent Systems for Communication, IoT and Security (ICISCoIS)},
  title     = {Optimization Techniques for Deep Learning Based House Price Prediction},
  year      = {2023},
  month     = {Feb},
  pages     = {202-207},
  abstract  = {With the persisting increment in the rates of houses, the cost of homes is escalating every year. So it is necessary to design a system that can predict future housing prices. This intelligent system undertakes the task to play a crucial role between learning and optimization. But because these systems are dynamic, complex, and multidisciplinary, optimizing them is particularly challenging. The House Price Index (HPI) is one of the most useful indicators for calculating frequent changes in home prices. The data processing of the current home pricing involves several approaches and takes into account several variables, including housing design, layouts, climate control conditions, etc. To incorporate the benefits of external factors and utilize the increased home price, this approach makes use of a multiple regression model and optimization approaches. Using enhanced housing price composition and multiple regression prediction models, such as particle swarm optimization, genetic, firefly, and mayfly algorithms, etc., it is possible to include the benefits of outside influences. The purpose of this work is to provide an overview of the latest and most popular deep learning optimization techniques which predicts the more precise and accurate prices of houses.},
  doi       = {10.1109/ICISCoIS56541.2023.10100566},
  keywords  = {Deep learning;Systematics;Layout;Whales;Predictive models;Prediction algorithms;Genetics;House price prediction;Deep Learning;Optimization techniques;Ant Colony Optimization;PSO},
}

@Article{Li2025b,
  author   = {Li, Yi and Li, Chaojie and Chen, Guo and Zhou, Xiaojun and Dong, ZhaoYang},
  journal  = {IEEE Transactions on Power Systems},
  title    = {Multi-Task Graph Adaptive Learning for Multivariate Electricity Price Short-Term Forecasting in Australia's National Electricity Market},
  year     = {2025},
  issn     = {1558-0679},
  month    = {Jan},
  number   = {1},
  pages    = {530-542},
  volume   = {40},
  abstract = {Accurate electricity price short-term forecasting plays an essential role in the digitization of the electricity market. However, due to the expansion of renewable energy resources and the development of electricity demands, electricity prices are increasingly volatile and difficult to predict, posing a significant threat to the security of daily electricity market operations. The uncertainty of the supply-demand balance, the spatiotemporal correlation of the electricity market are two major obstacles to making the forecasting precisely. In this paper, a multi-task learning model (MGAAL) utilizes a graph attention mechanism and incorporates an auxiliary task focused on predicting abnormal price spikes, enhancing generalization and reducing overfitting risk. Specifically, MGAAL employs attention-based Graph Neural Networks to enhance price forecasting by capturing temporal and spatial power flow dynamics. In addition, MGAAL can also adaptively assign task weights based on homoscedasticity uncertainty and gradient normalization of the tasks. Finally, our experiments, conducted using data from Australia's National Electricity Market (NEM), demonstrate the effectiveness of MGAAL, surpassing current state-of-the-art methods.},
  doi      = {10.1109/TPWRS.2024.3380834},
  keywords = {Electricity;Forecasting;Graph neural networks;Electricity supply industry;Predictive models;Feature extraction;Anomaly detection;Pricing;Multitasking;Predictive models;Adaptive learning;Anomaly event detection;electricity price forecasting;graph neural networks;multi-task learning;price spiking prediction},
}

@InProceedings{Kaur2024,
  author    = {Kaur, Arshleen and Kukreja, Vinay and Chattopadhyay, Saumitra and Joshi, Kireet and Sharma, Rishabh},
  booktitle = {2024 Asia Pacific Conference on Innovation in Technology (APCIT)},
  title     = {A Recurrent Neural Network Model for UNIQLO Stock Price Prediction},
  year      = {2024},
  month     = {July},
  pages     = {1-5},
  abstract  = {The interplay of the UNIQLO stock market is an important aspect that helps the crafting of investment returns and the opinion of company decisions. The typical procedure of stock forecasting is a comparison between linear and non-linear algorithms, including AR, MA, ARIMA, ARCH, GARCH, ANN, and ANFIS, aiming to predict stock index movements or the prices of individual stocks based on the previous day's endings. This paper suggests a new approach, which is different from the historical data being fitted to the previously obtained predicate models. However, a novel RNN-based model is developed to reveal the inner workings of the trading strategy concerned. This study models UNIQLO stock prices with a recursive neural network for prediction over the coming period. The details of the model accuracy are compared by predictive comparison. The percentage error metrics are used to gather insightfully all the essential vitality features of the model which uses the sliding window approach for predicting short-term values. This complex method is based on developing a more futuristic and powerful framework which deals with the unstable nature of the financial market with reference to the UNIQLO company with an aim of forecasting stocks more effectively.},
  doi       = {10.1109/APCIT62007.2024.10673681},
  keywords  = {Measurement;Technological innovation;Recurrent neural networks;Companies;Predictive models;Prediction algorithms;Indexes;UNIQLO Stock;RNN;LSTM;deep learning;machine learning},
}

