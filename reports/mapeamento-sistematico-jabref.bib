  booktitle = {2026 IEEE 2nd International Conference on Electronics, Energy Systems and Power Engineering (EESPE)},
  title     = {Corn Futures Prediction Based on Hybrid Intelligent Algorithm},
  year      = {2026},
  month     = {June},
  pages     = {1502-1506},
  abstract  = {This paper proposes a corn futures price prediction model based on the Chaotic Differential Evolution Particle Swarm Optimization Algorithm (CDEPSO). Given the highly nonlinear and uncertain nature of the corn futures market price fluctuations, by integrating the global search characteristics of chaos theory with the optimization efficiency of the Differential Evolution Particle Swarm Algorithm, significant improvements in prediction accuracy and stability have been achieved. The study enhances the performance of the neural network through Gaussian perturbation, Gaussian excitation, and Gaussian self-feedback mechanisms, effectively overcoming overfitting and local optimal traps. Experimental verification shows that this model significantly outperforms the BP neural network and its improved algorithms in key indicators such as mean square error (0.0245), average absolute error (0.0170), and coefficient of determination (0.9928), demonstrating outstanding data fitting and generalization capabilities, and providing a high-precision and robust scientific tool for agricultural futures market price prediction.},
  doi       = {10.1109/EESPE68405.2026.11649355},
