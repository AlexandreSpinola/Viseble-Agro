  groups                 = {Previsão + Otimização},
  keywords               = {Costs; Deep learning; Forecasting; Learning systems; Auction price; GRU; Interval estimation; Market dynamics; Optimization studies; Price interval estimation; Price prediction; Reinforcement learning models; Reinforcement learnings; Technological advancement; Reinforcement learning},
