  url                 = {https://www.scopus.com/pages/publications/85201701643?origin=resultslist},
}

@Conference{Damanik2025,
  author                 = {Damanik, Arion P. D. and Dewanta, Favian and Jumhur, Helni Mutiarsih and Hidayat, Arief Arianto},
  booktitle              = {2025 International Conference on Data Science and Its Applications (ICoDSA)},
  title                  = {Performance Evaluation of LSTM, SVR, and Hybrid LSTM-SVR Models in Corn Commodity Price Prediction},
  year                   = {2025},
  month                  = {July},
  note                   = {Cited by: 2},
  pages                  = {590 - 595},
  publisher              = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title    = {Int. Conf. Data Sci. Its Appl., ICoDSA},
  abstract               = {Indonesia, a tropical country with abundant food resources, faces challenges in stabilizing essential food supplies due to price fluctuations influenced by crop failures. One way to help address these fluctuating prices is by using Machine Learning to accurately and effectively predict prices. This study explores the application of Deep Learning and Machine Learning models - Long Short-Term Memory (LSTM), Support Vector Regression (SVR), and a Hybrid LSTM-SVR approach - to forecast national average corn prices. Bayesian Optimization is employed for hyperparameter tuning, alongside data preprocessing and algorithm integration. The SVR model demonstrates the lowest Mean Absolute Error (MAE) of 38.76, followed by the LSTM model with 47.29, while the Hybrid LSTM-SVR model shows potential for improvement with an MAE of 252.47. Despite performance variations, all models effectively capture price trends, highlighting the need for further refinement to enhance predictive accuracy.  © 2025 IEEE.},
  affiliations           = {Telkom University, Faculty of Electrical Engineering, Bandung, Indonesia; Telkom University, Faculty of Economics and Business, Bandung, Indonesia; The National Research and Innovation Agency, Bandung, Indonesia},
  author_keywords        = {deep learning; hybrid LSTM - SVR; LSTM; SVR},
  correspondence_address = {A.P.D. Damanik; Telkom University, Faculty of Electrical Engineering, Bandung, Indonesia; email: ariondamanik1504@gmail.com},
  doi                    = {10.1109/ICoDSA67155.2025.11157019},
  groups                 = {Previsão + Otimização},
  isbn                   = {979-833159854-9},
