@Conference{Kumar2024a,
  author              = {Kumar, Atul and Singh, Keerti and Krishna, Charu and Kumar, Divya},
  title               = {Stock Price Prediction using CABC Trained Neural Network},
  year                = {2024},
  note                = {Cited by: 1},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Comput., Electron., Electr. Eng. their Appl., IC2E3},
  abstract            = {The Artificial Bee Colony (ABC) algorithm is a prominent swarm-based optimization procedure. This meta-heuristic optimization procedure is structured over of the food-search behavior of natural honey bee swarms. CABC (Co-variance Guided Artificial Bee Colony), a powerful variant of ABC, is formed by combining ABC with the principles of statistical co-variance. In this article, CABC algorithm is used and tested for the optimization of neuron weights in an Artificial Neural Network. The tuned and trained Artificial Neural Network is then used to forecast the market movements of the three major stock market commodities, i.e. crude oil, gold, and silver. The performance of the suggested CABC based neural network training model is justified on the readings of Mean Error and Mean Absolute Percentage Error (MAPE). Obtained results exhibit that CABC is more accurate and has a superior performance over similar swarm based algorithms.  © 2024 IEEE.},
