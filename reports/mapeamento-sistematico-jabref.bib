  pages               = {542 - 549},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Proceeding - IEEE Int. Conf. Comput., Power, Commun. Technol., IC2PCT},
  abstract            = {In this work, we present an explainable AI (XAI) framework for predicting the price of crops that leverages deep learning and post-hoc interpretability to enable decision-making based on evidence for farmers, traders, and policy makers. The historical commodity prices are combined with agro-climatic variables, market arrivals, and macroeconomic indicators to predict future commodity prices using a hybrid architecture (BiLSTM + gradient boosting) for multi-step time series forecasting. For transparency, SHAP, LIME and permutation importance are used to decompose model outputs into feature-level attributions that explain relative impacts of weather anomalies, demand shocks, seasonal cycles and supply trends on predicted prices. These explanations are implemented in a dashboard for end users to access that displays forecast prediction intervals, scenario analysis, and key predictors so the user can investigate model behavior and reconcile predictions with domain expertise. Experimental results on multi-season regional crop datasets show that the model achieves better RMSE, MAPE and directional accuracy than traditional ARIMA and standalone machine learning baselines, while having great interpretability scores according to user studies. The platform increases confidence, usability, and use of AI-based price intelligence by converting black-box forecasts into actionable and understandable guidelines for managing risks, timing markets, making recommendations for policy in agricultural value chains. © 2026 IEEE.},
  affiliations        = {Amity School of Engineering & Technology, AUGN Campus, India; Amity School of Engineering & Technology, Noida Capus, UP, India; Marwadi University, Gujarat, Rajkot, India},
  author_keywords     = {Agricultural Markets; Crop Price Prediction; Decision Support; Explainable AI (XAI); Feature Attribution; LIME; SHAP; Stakeholder Trust; Time-Series Forecasting},
