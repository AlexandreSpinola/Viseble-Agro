  groups    = {Previsão + Otimização},
  keywords  = {Crops;Pricing;Machine learning;Modeling;Internet of Things;Machining;Long short term memory;Timing;Printing;Artificial intelligence;Market Price Prediction;Crop Price Forecasting;Machine Learning in Agriculture;Farmer Empowerment;Predictive Analytics},
}

