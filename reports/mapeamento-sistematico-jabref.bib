@Article{Githiria2025,
  author                 = {Githiria, Joseph and Musingwini, Cuthbert and Madahana, Milka and Khangamwa, Gift},
  journal                = {International Journal of Mining, Reclamation and Environment},
  title                  = {Incorporating a machine learning approach for commodity price prediction to generate a cut-off grade optimisation policy under grade uncertainty},
