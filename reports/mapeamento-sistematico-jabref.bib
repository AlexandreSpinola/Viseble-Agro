}

@InProceedings{Mustaffa2014a,
  author    = {Mustaffa, Z. and Yusof, Y. and Kamaruddin, S. S.},
  booktitle = {2014 IEEE 8th International Power Engineering and Optimization Conference (PEOCO2014)},
  title     = {Application of LSSVM by ABC in energy commodity price forecasting},
  year      = {2014},
  month     = {March},
  pages     = {94-98},
  abstract  = {The importance of the hyper parameters selection for a kernel-based algorithm, viz. Least Squares Support Vector Machines (LSSVM) has been a critical concern in literature. In order to meet the requirement, this work utilizes a variant of Artificial Bee Colony (known as mABC) for hyper parameters selection of LSSVM. The mABC contributes in the exploitation process of the artificial bees and is based on Levy mutation. Realized in crude oil price forecasting, the performance of mABC-LSSVM is guided based on Mean Absolute Percentage Error (MAPE) and Root Mean Square Error (RMSPE) and compared against the standard ABC-LSSVM and LSSVM optimized by Genetic Algorithm. Empirical results suggested that the mABC-LSSVM is superior than the chosen benchmark algorithms.},
  doi       = {10.1109/PEOCO.2014.6814406},
  keywords  = {Support vector machines;Optimization;Prediction algorithms;Conferences;Genetic algorithms;Forecasting;Particle swarm optimization},
}

@InProceedings{Ma2022,
  author    = {Ma, Rui and Ye, Shuhan and Feng, Zihao and Jin, Jiyang},
  booktitle = {2022 International Conference on Computers, Information Processing and Advanced Education (CIPAE)},
  title     = {Research on Quantitative Trading Strategy based on LSTM and Dynamic Programming},
  year      = {2022},
  month     = {Aug},
  pages     = {282-285},
  abstract  = {To get the most bang for the buck, market traders always trade a combination of volatile assets frequently in a short period, such as the combination of gold and bitcoin. This paper establishes a trading strategy model with quantitative risk assessment using machine learning and heuristic algorithms to obtain maximum returns when frequently trading this portfolio. And then guide traders to make investment decisions. First, we build a predictive model. We build a price prediction model based on LSTM neural network. Using LSTM can effectively convey and express information in long time series and not cause useful information long ago to be ignored. Better forecasting performance in financial time series. Then, we build a decision model. We have established quantitative trading strategies based on dynamic programming. Based on the prediction, we established a multi-objective dynamic programming model that maximizes returns under the premise of ensuring low risk. We use it to simulate and record the proportion of assets when the maximum return is obtained in each cycle to accelerate the function.},
  doi       = {10.1109/CIPAE55637.2022.00066},
  keywords  = {Gold;Neural networks;Time series analysis;Bitcoin;Predictive models;Prediction algorithms;Dynamic programming;LSTM;dynamic programming;quantitative transaction},
}

@InProceedings{Kihtir2024,
  author    = {Kihtir, Fatih and Oztoprak, Kasim},
  booktitle = {2024 IEEE International Conference on Big Data (BigData)},
  title     = {A Comparative Analysis on Leveraging K-Nearest Neighbours for Accurate Stock Price Forecasting},
  year      = {2024},
  month     = {Dec},
  pages     = {7061-7067},
  abstract  = {This research presents a comprehensive comparison of hybrid models combining K-Nearest Neighbours (KNN) with Support Vector Machines (SVM) and Long Short-Term Memory (LSTM) networks for stock price prediction. Using historical data from major technology stocks (AAPL, GOOGL, MSFT) spanning 2020-2023, we implemented and evaluated KNN-SVM and KNN-LSTM architectures. Our experiments demonstrate varied performance across different stocks, with the KNN-SVM hybrid achieving optimal results for GOOGL (RMSE: 2.11, R2 : 0.968) while showing moderate performance for AAPL (RMSE: 13.56) and MSFT (RMSE: 25.39). This variation in performance provides important insights into the relationship between stock characteristics and model efficacy. Through extensive experimentation and architectural optimization, we demonstrate that while simpler hybrid models can achieve superior performance in specific cases, their effectiveness varies significantly across different market conditions and stock characteristics. The study reveals important insights into the trade-offs between model complexity, computational efficiency, and prediction accuracy in financial time series forecasting.},
  doi       = {10.1109/BigData62323.2024.10825529},
  issn      = {2573-2978},
  keywords  = {Support vector machines;Accuracy;Computational modeling;Time series analysis;Predictive models;Nearest neighbor methods;Data models;Forecasting;Long short term memory;Optimization;KNN;SVM;LSTM;Hybrid Models;Stock Price Prediction;Machine Learning},
}

@InProceedings{Safari2013,
  author    = {Safari, M. Ikhsan Khamil Mohd and Dahlan, Nofri Yenita and Razali, Nor Shahida and Rahman, Titik Khawa Ab.},
  booktitle = {2013 IEEE 3rd International Conference on System Engineering and Technology},
  title     = {Electricity prices forecasting using ANN Hybrid with Invasive Weed Optimization (IWO)},
  year      = {2013},
  month     = {Aug},
  pages     = {275-280},
  abstract  = {Electricity prices forecasting is an important tool for power generating company to make investment decision, engage with long-term contracts, bidding in short-term market and other strategic actions. It is also a useful tool for electricity consumers to manage their demand consumption. In this paper an Artificial Neural Network (ANN) Hybrid with Invasive Weed Optimization (IWO) is introduced to forecast the electricity prices in the environment of restructured power market such as Australian Market. The ANN model uses the conventional back propagation technique, but the number of neuron nodes, learning rate and momentum constant are optimally determined using the IWO technique. Result shows that the ANN-IWO technique gives a better performance in term of forecasting error than the ANN technique alone.},
  doi       = {10.1109/ICSEngT.2013.6650184},
  keywords  = {Artificial neural networks;Electricity;Sociology;Statistics;Electricity supply industry;Forecasting;Optimization;Artificial Neural Network (ANN);Invasive Weed Optimization (IWO);Electricity Market Price (EMP);Momentum Constant (MC);Learning Rate (LR);Number Neuron (NM)},
}

@InProceedings{Siva2025,
  author    = {Siva, K. P. and Dhanashree, R. and Gomathi, R. and Nithika, K. S. and Perumal, S. Prasanna},
  booktitle = {2025 5th International Conference on Mobile Networks and Wireless Communications (ICMNWC)},
  title     = {Intelligent Sales Forecasting using a Multi-Model AI Approach for Market Adaptation},
  year      = {2025},
  month     = {Dec},
  pages     = {1-6},
  abstract  = {AI-powered models are transforming sales and price forecasting by addressing the challenges of unpredictable market fluctuations. Traditional methods fail to capture realtime consumer demand, climate variations, and market trends. This study introduces an advanced machine learning approach that integrates sentiment analysis, supply chain forecasting, and predictive analytics to enhance accuracy in sales and price predictions, benefiting farmers, dealers, and policymakers. The model uses advanced AI techniques like Spatiotemporal Convolutional Networks (STCNs), Reinforcement Learning, XGBoost and Temporal Fusion Transformer (TFT) to improve accuracy. It helps predict sales trends, assess climate suitability, analyse customer behaviour, recommend government schemes, forecast supply chain delays, detect pest risks and suggest the best time and place to sell crops for maximum profit. Sentiment analysis of news and social media helps track price fluctuations in real time. As in traditional models relying only on past data, this AI-driven approach adapts to real-world changes. It integrates market trends, climate forecasts and alternative crop recommendations to assist stakeholders in making informed decisions. An interactive AI dashboard offers farmers, traders and policy makers valuable insights. By merging AI with precision farming, this research provides a smart, scalable solution for better sales predictions, reducing risks, improving productivity and ensuring sustainable profits.},
  doi       = {10.1109/ICMNWC66779.2025.11354301},
  keywords  = {Wireless communication;Sentiment analysis;Fluctuations;Accuracy;Supply chains;Crops;Market research;Transformers;Forecasting;Farming;AI in farming;machine learning;price prediction;smart agriculture;supply chain forecasting},
}

@Article{Li2023a,
  author   = {Li, Fei and Zhou, Hanlu and Liu, Min and Ding, Leiming},
  journal  = {IEEE Access},
  title    = {A Medium to Long-Term Multi-Influencing Factor Copper Price Prediction Method Based on CNN-LSTM},
  year     = {2023},
  issn     = {2169-3536},
  pages    = {69458-69473},
  volume   = {11},
  abstract = {Non-ferrous copper prices exhibit high noise, non-smoothness, and non-linearity, which pose significant challenges to accurate price prediction. One of the current methods for predicting copper prices is multi-influencing factor analysis, which typically relies on traditional optimization or neural network methods to identify factors that affect copper prices. However, extracting attribute features and high-level semantics from raw data using these conventional methods can be difficult, which may necessitate revision of the selected influencing factors and final results. This paper proposes a CNN-LSTM-based approach that leverages the feature extraction capabilities of Convolutional Neural Networks (CNN) and Long Short-Term Memory (LSTM) networks. After analyzing the fluctuation features of copper prices and their qualitative relationships with factors such as supply and demand, energy costs, alternative metals, global macroeconomic conditions, and national policies, we selected 11 influencing factors for copper price fluctuation as explanatory variables using scatter plots, Pearson correlation coefficients, and heat maps. These variables are then fed into a CNN-LSTM network as a two-dimensional multivariate time series, along with historical copper price data, for monthly price forecasting. Experimental results show that our proposed method outperforms other existing methods by utilizing the attribute space feature extraction capability of CNNs and the temporal feature extraction of LSTMs.},
  doi      = {10.1109/ACCESS.2023.3288486},
  keywords = {Copper;Metals;Fluctuations;Forecasting;Predictive models;Convolutional neural networks;Feature extraction;Long short term memory;Pricing;Convolutional neural network;long short-term memory;multi-influencing factor;correlation analysis;price prediction},
}

@InProceedings{Karahyla2023,
  author    = {Karahyla, Dr Jai Kishan and Sharma, Neelam and Chamoli, Sushant and Shirgire, Dr Anil and Kant, Ravi and Chauhan, Amit},
  booktitle = {2023 4th International Conference on Electronics and Sustainable Communication Systems (ICESC)},
  title     = {Predicting Price Direction of Bitcoin based on Hybrid Model of LSTM and Dense Neural Network Approach},
  year      = {2023},
  month     = {July},
  pages     = {953-958},
  abstract  = {Bitcoin is a rapidly growing but extremely risky cryptocurrency. It marks a watershed moment in the history of cash. These days, digital currency is preferred to actual money. Bitcoin has decentralized authority and placed it in the hands of its users. Many people are joining the largest and most well-known Bitcoin mining pools as the risk of working alone is too great. In order to enhance their chances of creating the next block in the Bitcoins blockchain and decrease the mining reward volatility, users can band together to form Bitcoin pools. This tendency toward consolidation may also be seen in the rise of large-scale mining farms equipped with powerful mining resources and speedy processing capability. Because of the risk of a 51% assault, this pattern shows that Bitcoin’s pure, decentralized protocol is moving toward greater centralization in its distribution network. Not to be overlooked is the resulting centralization of the bitcoin network as a result of cloud wallets making it simple for new users to join. Because of the easily hackable nature of Bitcoin technologies, this could lead to a wide range of security vulnerabilities. The proposed approach uses normalization and filling missing values in preprocessing, PCA for feature Extraction and finally training the model using LSTM-DNN Models. The proposed approach outperforms other two models such as CNN and DNN.},
  doi       = {10.1109/ICESC57686.2023.10193561},
  keywords  = {Training;Protocols;Online banking;Neural networks;Bitcoin;Watersheds;Predictive models;Dense Neural Network (DNN);Normalization;Bitcoin},
}

@InProceedings{Singh2024c,
  author    = {Singh, Naksh and Jha, Waibhav and Gupta, Prisha and Gupta, Kritesh Kumar},
  booktitle = {2024 IEEE Recent Advances in Intelligent Computational Systems (RAICS)},
  title     = {Artificial Intelligence driven Portfolio Management},
  year      = {2024},
  month     = {May},
  pages     = {1-6},
  abstract  = {In general, portfolio optimization is used to strategically allocate funds into financial assets with the goal of maximizing returns over risk. In the traditional sense, such procedures necessitate a great deal of experience and rely on a trial-and-error approach. To address such inherent issues, this study provides a computational framework for integrating Monte-Carlo simulation-driven stock price optimization coupled with deep learning-driven forecasting of future stock prices. The Monte-Carlo simulation (MCS) is utilized to quantify the uncertain variations in the optimal parameters such as Sharpe ratio and volatility. The time history of the stock prices corresponding to the best stock (based on high returns over minimal risk) identified by MCS is further used to train the LSTM (Long Short-Term Memory) deep learning model. To ensure sound prediction capability, the constructed LSTM model is validated with out-of-fold unknown temporal history data. The presented coupled framework resulted in a promising method of portfolio management.},
  doi       = {10.1109/RAICS61201.2024.10689727},
  issn      = {2769-5565},
  keywords  = {Monte Carlo methods;Computational modeling;Finance;Predictive models;Internet;History;Forecasting;Portfolios;Long short term memory;Optimization;Portfolio Optimization;Machine Learning;LSTM Networks;Monte Carlo Simulation;Sharpe Ratio},
}

@InProceedings{Khandelwal2023,
  author    = {Khandelwal, Ritvik and Marfatia, Prasham and Venkataramanan, V.},
  booktitle = {2023 4th International Conference for Emerging Technology (INCET)},
  title     = {Implementing various Deep Learning Models to Predict Stock Price Movement},
  year      = {2023},
  month     = {May},
  pages     = {1-8},
  abstract  = {In the past, academics have had difficulty predicting stock prices and movements. We can accurately predict stock prices, despite the widely accepted efficient market hypothesis, according to formal arguments in the literature. Regression models for stock price forecasting developed using deep learning are presented in this article. Predictive models were developed for a well-known American company in this study. Stock prices are updated every five minutes on weekdays and weekends. Stock price data was used to build four convolutional neural networks (CNN) and five LSTM-based deep learning models for forecasting future stock prices. To determine the accuracy of forecasts, this research thoroughly examines all proposed models, including their execution time and root mean square error (RMSE).},
  doi       = {10.1109/INCET57972.2023.10169969},
  keywords  = {Deep learning;Statistical analysis;Biological system modeling;Companies;Predictive models;Convolutional neural networks;Forecasting;Deep learning;Long Short Term Memory;convolutional neural network;Stock Price;Sentiment Analysis},
}

@InProceedings{Oriani2016,
  author    = {Oriani, Felipe Barboza and Coelho, Guilherme P.},
  booktitle = {2016 IEEE Symposium Series on Computational Intelligence (SSCI)},
  title     = {Evaluating the impact of technical indicators on stock forecasting},
  year      = {2016},
  month     = {Dec},
  pages     = {1-8},
  abstract  = {The application of time series analysis and forecasting to stock markets is particularly relevant to Technical Analysis, which uses historical values to obtain indicators that highlight possible trends in stock prices. In practice, most of these indicators are evaluated graphically and their direct impact on the quality of stock price forecasting has not been appraised so far. Therefore, the impact of different technical indicators on the prediction of stock closing prices was evaluated in this paper. Under the machine learning perspective, each technical indicator was used as input for artificial neural networks (multilayer perceptrons) trained to forecast the daily stock closing prices of five companies with high representation in the Brazilian IBovespa index. The results have led to two main conclusions: (i) lagging technical indicators such as the Exponential Moving Average and Weighted Moving Average, when used as isolated inputs of the neural networks, can improve the accuracy of the stock forecast when compared to forecasts made with the original series of closing prices; and (ii) the combination of different indicators as inputs to the same neural network can improve even more the forecasting performance. These results may contribute to the development of more robust forecasting techniques for stock prices in the future.},
  doi       = {10.1109/SSCI.2016.7850017},
  keywords  = {Time series analysis;Forecasting;Market research;Indexes;Companies;Stock markets;Neural networks},
}

@InProceedings{Kumar2023,
  author    = {Kumar, Sanjiv and Aggarwal, Utkarsh and Gautam, Pratiksha and Tuteja, Aryan and Matta, Priya and Maurya, Sudhanshu},
  booktitle = {2023 3rd International Conference on Intelligent Technologies (CONIT)},
  title     = {LSTM Approach for Efficient Stock Market Prediction},
  year      = {2023},
  month     = {June},
  pages     = {1-5},
  abstract  = {Stock market investing has always been difficult for shareholders and prevents the use of standard models to make more accurate predictions of future values. Although many researchers and academicians have proposed methods to make stock price prediction more efficient. But after going through those proposals, we found a number of loopholes that can be tackled using a different approach. In this research work, machine learning and a study of finance have been combined to construct a model employing long-short term memory (LSTM) that forecasts the value of the SENSEX in the future. Finally, we have evaluated the performance of our proposed method. So this research work can be used by other researchers in the same domain. Our research will encourage practitioners to better identify the exciting sector for future views while also assisting beginners in comprehending the ML paradigm.},
  doi       = {10.1109/CONIT59222.2023.10205790},
  keywords  = {Finance;Machine learning;Predictive models;Proposals;Stock markets;Standards;LSTM;SENSEX;ML;Deep Learning;Data Analysis},
}

@InProceedings{Luo2011,
  author    = {Luo, TianYuan and Tian, Ling and Tang, XinHua and Dong, YingHong},
  booktitle = {2011 3rd International Conference on Electronics Computer Technology},
  title     = {Application of least squares support vector machine in futures price forecasting},
  year      = {2011},
  month     = {April},
  pages     = {173-176},
  volume    = {3},
  abstract  = {Futures price forecasting based on least squares support vector machine is presented in the paper. In order to improve the prediction performance of least squares support vector machine, the experimental data can be normalized and appropriate parameters are selected by genetic algorithm. Least squares support vector machine is used to create the prediction model for futures price, and BP neural network is used to compare with least squares support vector machine. The experimental data of futures price are given. The prediction error of futures price by least squares support vector machine and BP neural network respectively are obtained. The analysis results show that futures price forecasting based on least squares support vector machine has excellent prediction results of futures price.},
  doi       = {10.1109/ICECTECH.2011.5941825},
  keywords  = {Support vector machines;Artificial neural networks;Genetic algorithms;Forecasting;Optimization;Data models;Prediction algorithms;futures price;least squares support vector machine;forecasting;regression function},
}

@InProceedings{Katake2026,
  author    = {Katake, Shwetambari Pandurang and Chaudhary, Swati and J, Monisha and Sharma, Shreesha and Kurbonov, Khayrilla and Matrasulovna, Masharipova Xosiyat},
  booktitle = {2026 International Conference on NextGen Data Science and Analytics (ICNDSA)},
  title     = {Predicting Commodity Prices Using Hybrid Machine Learning Models},
  year      = {2026},
  month     = {April},
  pages     = {1-6},
  abstract  = {Predicting prices of commodities is a severe issue because the volatility is very high, nonlinear, and the macroeconomic and geopolitical factors come into play. The model is a combination of regression based learners, recurrent neural network and metaheuristic parameter tuning optimization, which allows to effectively capture linear and nonlinear patterns in time-series. Training and validation is done using historical commodity prices, macroeconomic variables and external variables like inflation, exchange rates and demands in the world market. Normalization and feature engineering improve the quality of data and strengthening of the model. The hybrid model is compared to the standalone models based on the performance measures like RMSE, MAE and R 2 score. The experimental evidence proves that the suggested method has high gains with respect to prediction accuracy, minimizes the forecasting error, and improves the generalization ability of various commodities. The results emphasize the usefulness of the hybrid learning in the management of intricate financial data and fluctuating market nature. The current study can be used to make better decisions in the area of trading, investment planning, and risk management and provide a scalable methodology in a real-life commodity forecasting.},
  doi       = {10.1109/ICNDSA68777.2026.11652236},
  groups    = {Suporte à Decisão Agrícola},
  keywords  = {Modeling;Machine learning;Pricing;Equations;Forecasting;Machining;Accuracy;Optimization;Timing;Deep learning;Commodity Price Prediction;Hybrid Machine Learning;Deep Learning;Time-Series Forecasting;Optimization Techniques;Financial Analytics},
}

@InProceedings{Ouyang2025,
  author    = {Ouyang, Mutian and Guo, Maobo and Li, Biqin and Chen, Baiyi and V, Maria Anu and Joshua Thomas, J.},
  booktitle = {2025 IEEE International Conference on Artificial Intelligence in Engineering and Technology (IICAIET)},
  title     = {Semantic Feature Selection via LLMs for Palm Oil Price Forecasting in Low-Resource Markets},
  year      = {2025},
  month     = {Aug},
  pages     = {7-12},
  abstract  = {Accurate commodity price forecasting is critical in low-resource markets where data scarcity limits the effectiveness of traditional machine learning pipelines. This study proposes a zero-shot semantic feature selection framework using GPT-4 for forecasting Malaysian crude palm oil (CPO) prices. Unlike correlation-based filters, our method leverages the pretrained knowledge of large language models (LLMs) to rank features based on their conceptual relevance via natural language prompts. We construct a structured dataset of exogenous variables covering commodity prices, macroeconomic indicators, and financial indices from 2020 to 2024. A dual-branch experiment compares traditional selection methods (Mutual Information, Lasso, RFE) with the proposed LLM-guided strategy, using XGBoost as the downstream prediction model. Experimental results show that LLM-selected features consistently outperform baselines across all metrics, achieving the lowest RMSE of 0.1477 and MAE of 0.1240. Visual analyses further confirm the model’s ability to track actual price movements with semantic features alone. This work demonstrates the viability of LLMs in structured data tasks, offering a scalable and interpretable solution for economic forecasting under data-scarce conditions.},
  doi       = {10.1109/IICAIET67254.2025.11265369},
  keywords  = {Measurement;Visualization;Oils;Large language models;Semantics;Natural languages;Predictive models;Feature extraction;Forecasting;Mutual information;Large Language Model;Feature Selection;Palm Oil Price Forecasting;GPT-4;Low-Resource Markets;Zero-Shot Learning;Semantic Modeling;XGBoost;Commodity Forecasting;Financial Time Series},
}

@InProceedings{A.2026,
  author    = {A., Gamage U. V. and K., Wimalarathna B. P. and U., Dharmappriya W. A. I. and J., Rathnayaka S. and Tissera, Wishalya and Rupasinghe, Shalini and De Silva, Hansi and Priyadarshana, W. H. D.},
  booktitle = {2026 6th International Conference on Emerging Smart Technologies and Applications (eSmarTA)},
  title     = {An Integrated Smart Framework for Post-Harvest Optimization and Market Intelligence},
  year      = {2026},
  month     = {Aug},
  pages     = {1-8},
  abstract  = {Post-harvest losses in Sri Lanka's fruit and vegetable supply chain remain a critical challenge, attributed to the absence of integrated quality assessment tools, real-time market intelligence, and accessible decision support systems tailored to local conditions. Existing approaches address these problems in isolation, leaving smallholder farmers without a unified platform for quality grading, price forecasting, post-harvest advisory, and cultivation planning. This paper presents CropShield, a novel four-component AI framework designed to address these gaps for Sri Lankan agricultural stakeholders. The first component employs YOLOv8 for fruit detection followed by MobileNetV2 fine-tuned on a papaya dataset for defect classification across six categories and maturity classification across three stages, with Grad-CAM explainability and a Random Forest recommendation engine integrated with Department of Agriculture knowledge. The second component delivers price forecasting across eleven crop varieties using a hybrid ensemble of ARIMAX, XGBoost, and LightGBM trained on HARTI market data from 2008 to 2025. The third component provides a bilingual post-harvest risk advisory assistant supporting Sinhala and English, integrating real-time weather data with an NLP-driven prediction engine, with SHAP-based explainability for transparent advisory outputs. The fourth component implements a Random Forest-based crop suitability and yield estimation model using district-level agronomic data with SHAP explainability for interpretable crop recommendations. The defect detection model achieved 95.65% accuracy and F1-score under clean conditions and 93.48% under robust augmentation, while the price forecasting model achieved R2=0.986 and MAPE=3.16%. CropShield delivers a scalable, explainable, and farmer-accessible platform for evidence-based agricultural decision-making across Sri Lanka},
  doi       = {10.1109/eSmarTA70636.2026.11652112},
  groups    = {Previsão + Otimização},
  keywords  = {Modeling;Pricing;Crops;Printing;Random forests;Forecasting;Machine learning;Accuracy;Training;Machining;Post-Harvest Loss;Non-destructive Quality Assessment;Agricultural Price Forecasting;Crop Suitability Prediction;Machine Learning;Post-Harvest Risk Analysis;Explainable AI;Bilingual Advisory System;CNN},
}

@Article{Huang2017,
  author   = {Huang, Xuefei and Hong, Seung Ho and Li, Yuting},
  journal  = {IEEE Transactions on Industrial Informatics},
  title    = {Hour-Ahead Price Based Energy Management Scheme for Industrial Facilities},
  year     = {2017},
  issn     = {1941-0050},
  month    = {Dec},
  number   = {6},
  pages    = {2886-2898},
  volume   = {13},
  abstract = {Price-based demand response (PBDR) offers a significant opportunity for electricity consumers to dynamically balance their energy demand in response to time-varying electricity prices, and therefore ease the burden on the grid during peak times. However, despite being the primary energy consumers, there is little research carried out on implementing PBDR in industrial facilities, especially on real-time price (RTP) based DR. In this study, we propose a DR scheme based on hour-ahead RTP for industrial facilities. The scheme implements an artificial neural network based price forecasting model to forecast unknown future prices to support global time horizon optimization. Based on the forecasting price, the energy cost minimization problem is formulated by mixed integer linear programming. This paper includes a practical case study of the whole process of steel powder manufacturing for performance analysis. The results show that the proposed scheme is capable of balancing the energy demand and reducing energy costs while satisfying production targets.},
  doi      = {10.1109/TII.2017.2711648},
  keywords = {Energy management;Mathematical model;Predictive models;Forecasting;Industrial plants;Real-time systems;Pricing;Artificial neural networks;Artificial neural network (ANN);demand response (DR);hour-ahead real-time price (HA-RTP);industrial facilities;price forecasting},
}

@InProceedings{S2026,
  author    = {S, Sewwandi I.B.E.R. and N, Gamage P.G.A. and P, Gunasingha W.S. and M, Rashmika D. and Kasthuriarachchi, Sanvitha and Shyamalee, Thisara},
  booktitle = {2026 8th International Congress on Human-Computer Interaction, Optimization and Robotic Applications (ICHORA)},
  title     = {Empowering Alphonso Mango Export with Global Market Insights},
  year      = {2026},
  month     = {May},
  pages     = {1-6},
  abstract  = {The Alphonso mangoes grown in Sri Lanka are interdependent concerning cultivation, grading, pricing and exportation because there is no single system that involves the whole value chain. This paper suggests a comprehensive smart agricultural system, which includes detecting mango leaf disease, grading export quality, price prediction, trading via digital auctions, recommending smart packaging, and tracing with QRs. A CNN trained on MobileNet classifies diseases in mango leaves in eight categories with 96.5% accuracy, which is backed up by the severity estimation and weather-sensitive scheduling of treatment. The combination of CNN-based ripeness detectors and computer vision size and shape analysis creates single export grading decisions with an accuracy of 74.7%. CatBoost and XGBoost models are time-series based feature engineering models of local and export market prices to determine the best harvesting windows. An augmented realitybased deep neural network that packages a recommender is accurate at 82.2% predicting damage risks, which is supplemented with guided packing instruction. Relative comparison to known benchmarks such as ResNet50, VGG16 and XGBoost proves that all modules are consistently improving. The suggested platform will create a complete AIdriven support framework of decisions that will encourage consistency, openness, and data-driven decision making across the entire Alphonso mango export supply chain.},
  doi       = {10.1109/ICHORA69329.2026.11537077},
  groups    = {Predição de Commodities},
  issn      = {2996-4393},
  keywords  = {Modeling;Packaging;Pricing;Diseases;Modules (abstract algebra);Forecasting;Signal detection;Machine learning;Printing;Timing;Mango diseases detection;Computer vision;price forecasting;export grading;packaging recommendation;AI agriculture},
}

@InProceedings{Lim2025,
  author    = {Lim, Kalyani Jeslyn and Lidjadja, Natalie Asdyo and Permai, Syarifah Diana and Alexander and Wihardini, Diah},
  booktitle = {2025 International Conference on Informatics, Multimedia, Cyber and Information System (ICIMCIS)},
  title     = {Comparative Analysis of Time Series Models to Forecast Global Wheat Price},
  year      = {2025},
  month     = {Dec},
  pages     = {1049-1054},
  abstract  = {This study compares the forecasting accuracy of four time series models, which are naive, double moving average (DMA), autoregressive integrated moving average (ARIMA), and neural network autoregressive (NNAR) on global wheat price data from January 2022 to May 2025. Unlike prior research, this work simultaneously evaluates both traditional and neural network methods on commodity price trends. Model performance was assessed using root mean square error (RMSE) and mean absolute percentage error (MAPE). The DMA model with a 3-day moving average period achieved the lowest error rates, demonstrating competitive accuracy over NNAR. Model implementation details include training over 100 epochs, learning rates tuned by grid search, and seed reproducibility to ensure result consistency. Findings suggest further enhancement by incorporating seasonality and exogenous variables in future forecasting models.},
  doi       = {10.1109/ICIMCIS68501.2025.11327278},
  issn      = {2837-5203},
  keywords  = {Weather;Training;Analytical models;Accuracy;Time series analysis;Artificial neural networks;Predictive models;Soil;Data models;Forecasting;wheat price;forecasting;time series analysis;neural network autoregressive},
}

@InProceedings{Rani2025,
  author    = {Rani, Indu and Verma, Chandan Kumar},
  booktitle = {2025 12th International Conference on Reliability, Infocom Technologies and Optimization (Trends and Future Directions) (ICRITO)},
  title     = {Residual-Augmented BiLSTM Framework for Robust Forecasting of Gold Price Dynamics},
  year      = {2025},
  month     = {Sep.},
  pages     = {1-6},
  abstract  = {As a barometer of economic confidence, gold's price plays a critical role in shaping both monetary frameworks and financial markets. Predicting the trajectory of gold and other precious metal prices gives investors and financial professionals the insight needed to time their commodity supply effectively. Therefore, for precisely capturing the complex dynamics of gold price fluctuations, we proposed a residual-augmented bidirectional LSTM architecture. A comprehensive set of technical indicators is integrated, and the resulting forecasts are evaluated against other leading deep learning (DL) approaches. Evaluation rigor is ensured through the use of multiple error metrics-Root Mean Square Error (RMSE), Mean Squared Error (MSE), Mean Absolute Error (MAE), Median Absolute Error (MedAE), and R-squared ($R^{2}$). Statistical significance tests then confirm that the observed differences in forecasting accuracy are meaningful. Several key avenues for future research in gold price forecasting are identified, providing researchers with direction for the enhancement of advanced predictive methodologies.},
  doi       = {10.1109/ICRITO66076.2025.11241386},
  issn      = {2769-2884},
  keywords  = {Deep learning;Gold;Fluctuations;Bidirectional long short term memory;Mean square error methods;Predictive models;Market research;Trajectory;Forecasting;Optimization;Deep learning models;Gold price;Forecasting},
}

@InProceedings{A2025a,
  author    = {A, Shanmugapriya and Padmavathy, C. and Singh, Sujit Kumar and Nitin and Qureshi, Mujtaba Ashraf and Roy, Bhaskar and Mukherjee, Subhayan},
  booktitle = {2025 International Conference on Engineering Innovations and Technologies (ICoEIT)},
  title     = {CryptoNet: Bitcoin's Price Trends Through Deep Learning},
  year      = {2025},
  month     = {July},
  pages     = {450-455},
  abstract  = {Bitcoin, the pioneering cryptocurrency, has experienced substantial growth and volatility since its inception. Understanding and predicting its price movement is of paramount interest to investors, traders, and researchers alike. The value of cryptocurrencies has increased, which has decreased international control and contributed to the decentralization of authority. Digital currencies can vary widely in price, which highlights the necessity of having solid planning in place to forecast the currency's value. In this project, we propose a deep learning-based approach to forecast Bitcoin prices. Our methodology involves collecting historical price data along with the features like trading volume, market sentiment, and technical indicators. We preprocess the data to handle missing values and normalize features to ensure model robustness. Subsequently, we employ deep learning algorithms to train predictive models. Furthermore, we explore ensemble methods to enhance prediction accuracy and resilience to market dynamics. Our findings suggest that deep learning techniques can provide valuable insights into Bitcoin price movements, aiding investors in making informed decisions. Through this project, we aim to provide a foundation for developing more advanced forecasting models in the future.},
  doi       = {10.1109/ICoEIT63558.2025.11211758},
  keywords  = {Deep learning;Adaptation models;Technological innovation;Accuracy;Uncertainty;Bitcoin;Predictive models;Prediction algorithms;Data models;Long short term memory;Bitcoin (BTC);LongShort-Term-Memory (LSTM);Deep Learning;Bitcoin;Change Point Detection (CPD);Pruned exact liner time (PELT);Recurrent-NeuralNetwork (RNN)},
}

@InProceedings{Bhaskaran2025,
  author    = {Bhaskaran, S. and N, Venkata Subramanian},
  booktitle = {2025 International Conference on Cognitive, Green and Ubiquitous Computing (IC-CGU)},
  title     = {A Hybrid Recommender System for Predicting Gold Prices Using Financial and Temporal Data},
  year      = {2025},
  month     = {Oct},
  pages     = {1-4},
  abstract  = {Predicting the cost of gold is essential in financial decision-making and investment planning. The traditional models are generated by the majority of econometric or time-series methods, but they do not address the specifics of investment behavior of users. In the study we develop a hybrid recommender system based on collaborative filtering, content-based analysis and temporal modeling to predict the price of gold and recommend investment activities. We make use of data on gold prices as well as pertinent data on the macroeconomy and preference data of simulated investors to make up a complete predictive model. Findings indicate that the combination of various techniques is more accurate than individual methods. The resulting model is full of customized information and offers better forecasting abilities. This research shows the possibility of the recommended systems not bound to e-commerce as in the finance and commodity sectors.},
  doi       = {10.1109/IC-CGU67042.2025.11338073},
  keywords  = {Gold;Collaborative filtering;Biological system modeling;Finance;Predictive models;Ubiquitous computing;Planning;Forecasting;Recommender systems;Investment;Hybrid Recommender System;Gold Price Forecasting;Collaborative Filtering;Time-Series Prediction;Financial Decision Support},
}

@InProceedings{Yusoff2023,
  author    = {Yusoff, Marina and Sharif, Muhammad Yusof and Sallehud-Din, Mohamad Taufik Mohd},
  booktitle = {2023 7th International Symposium on Innovative Approaches in Smart Technologies (ISAS)},
  title     = {Long Term Short Memory with Particle Swarm Optimization for Crude Oil Price Prediction},
  year      = {2023},
  month     = {Nov},
  pages     = {1-4},
  abstract  = {Prediction of crude oil prices is important in energy because of its significant impact on global markets and socioeconomic stability. Several machine learning methods have been employed to assist the industry. One of the popular neural network methods, Long Term Short Memory (LSTM), has demonstrated its ability to predict time series data, particularly in predicting crude oil prices. However, the prediction performance still requires more research and evaluation to improve accuracy. This paper introduces a novel methodology that embeds Particle Swarm Optimization (PSO) into LSTM networks to minimize prediction errors. This study independently examines and identifies the most efficient hyperparameters within a ring topology of PSO, utilizing historical data on crude oil prices. The empirical findings indicate that the LSTM-PSO approach exhibits superior predictive accuracy compared to conventional LSTM networks and statistical time series techniques. The results suggest that the LSTM-PSO model demonstrates enhanced proficiency in capturing crude oil price patterns.},
  doi       = {10.1109/ISAS60782.2023.10391535},
  keywords  = {Oils;Time series analysis;Neural networks;Stochastic processes;Optimization methods;Prediction algorithms;Stability analysis;Crude Oil;Long-Term Short Memory;Particle Swarm Optimization;Prediction;Time Series},
}

@InProceedings{Behera2023,
  author    = {Behera, Sudersan and Pavan Kumar, A V S and Nayak, Sarat Chandra},
  booktitle = {2023 OITS International Conference on Information Technology (OCIT)},
  title     = {Improved firefly based pi-sigma neural network for gold price prediction},
  year      = {2023},
  month     = {Dec},
  pages     = {202-207},
  abstract  = {Predicting financial time series is a formidable challenge, given the dynamic nonlinearity and data complexity inherent in such data. In response to this challenge, our study presents an innovative approach by combining the Improved Firefly Algorithm (IFFA) with the well-established higher-order Pi-Sigma Neural Network (IFFA-PSNN) for forecasting future Gold prices. Our model's performance is evaluated using the Mean Squared Error (MSE). When compared to various alternative models, including Firefly-based PSNN (FFA-PSNN), Genetic Algorithm-based PSNN (GA-PSNN), Differential Evolution-based PSNN (DE-PSNN), and Gradient Descent-based PSNN (GD-PSNN), the IFFA-PSNN model distinguishes itself with its superior predictive capabilities. This is achieved by effectively minimizing MSE and accommodating data uncertainty, particularly in the context of Gold closing prices.},
  doi       = {10.1109/OCIT59427.2023.10430837},
  keywords  = {Gold;Uncertainty;Time series analysis;Predictive models;Prediction algorithms;Forecasting;Genetic algorithms;improved firefly;pi-sigma neural network;gold prediction;time series forecasting},
}

@InProceedings{Wang2022,
  author    = {Wang, Zijie and Liu, Zhule and Li, Hongfu},
  booktitle = {2022 5th International Conference on Advanced Electronic Materials, Computers and Software Engineering (AEMCSE)},
  title     = {Price Forecasting and Quantitative Trading Strategy Based on Ensemble Forecaster},
  year      = {2022},
  month     = {April},
  pages     = {320-326},
  abstract  = {It remains difficult to make a quantitative trading strategy by predicting the former statistics, with the aim of balancing the risks and profits. In this article, we presented an innovative price forecasting and quantitative trading strategy based on ensemble forecaster. The strategy program was designed by the modified Sharpe ratio and PSO, which overcame the original Sharpe ratio’s conservation and the slow program’s convergence rate. And the model was effective and sensitive proved by the disturbance evaluation.},
  doi       = {10.1109/AEMCSE55572.2022.00072},
  keywords  = {Economics;Adaptation models;Computational modeling;Predictive models;Real-time systems;Dynamic programming;Forecasting;ensemble forecaster;quantitative trading strategy;Sharpe ratio;PSO;disturbance evaluation},
}

@Article{Pan2025,
  author   = {Pan, Da},
  journal  = {IEEE Access},
  title    = {A Price Risk Early Warning Model for Agricultural Products Based on the Integration of Deep Learning and Knowledge Graphs},
  year     = {2025},
  issn     = {2169-3536},
  pages    = {162623-162638},
  volume   = {13},
  abstract = {Agricultural price volatility poses significant challenges for food security, market regulation, and rural economic stability. To address these issues, this study proposes an integrated early warning model that combines the representational capabilities of deep learning with the interpretability of symbolic knowledge. The framework features two primary components: AgroFormer, a Transformer-based architecture specifically designed to capture hierarchical spatio-temporal dependencies across crops, regions, environmental factors, and time; and AgroScope, a strategic reasoning module that converts predictive insights into operational decisions through knowledge-aware constraints and risk-sensitive optimization. The model is evaluated on four benchmark datasets—Agmarknet, AGRIS, WorldCereal, and GAEZ—spanning structured tabular records, multilingual textual documents, and high-resolution remote sensing data. Experimental results show that the proposed approach achieves superior performance across all datasets, outperforming state-of-the-art baselines with an average improvement of 12.3% in prediction accuracy and a 12.1% reduction in RMSE. Ablation studies further validate the unique contributions of symbolic attribute alignment, differentiable scheduling graphs, and knowledge-aware constraints. Beyond technical contributions, the proposed system offers tangible value to agricultural practitioners. It enables proactive decision-making by delivering early warnings for price fluctuations, optimizing crop rotation schedules under policy and environmental constraints, and supporting adaptive planning in response to real-time market signals. The framework’s modular design facilitates deployment in diverse agro-ecological contexts, making it suitable for applications ranging from farm-level management to national food security planning. These results highlight the potential of combining deep learning with domain knowledge to create interpretable, scalable, and actionable tools for intelligent agricultural risk management.},
  doi      = {10.1109/ACCESS.2025.3609817},
  groups   = {Previsão + Otimização},
  keywords = {Deep learning;Data models;Knowledge graphs;Transformers;Predictive models;Cognition;Crops;Computational modeling;Accuracy;Semantics;Symbolic formalization;deep learning;strategic reasoning;agricultural modeling;knowledge graph integration},
}

@Article{Tataroglu2026,
  author   = {Tataroglu, Vasfi and Gunduz, Gurhan and Bulut, Hasan},
  journal  = {IEEE Access},
  title    = {Motif Discovery and Classification Using Multi-Feature Chainlets},
  year     = {2026},
  issn     = {2169-3536},
  pages    = {45338-45353},
  volume   = {14},
  abstract = {Bitcoin’s 24/7 trading generates recurring intraday price patterns, and public blockchains enable time-aligned analysis of transaction activity. We define bullish and bearish price motifs within a fixed 24-hour window and test whether the on-chain transaction-graph signals observed before a motif begins can distinguish these patterns. Transaction activity is summarized using chainlet representations on a fixed input–output grid, enriched with economic content through fee- and amount-weighted chainlets. To prevent label leakage, all features are extracted only from the left (pre-motif) window. We also introduce FOA, a ratio-based measure that combines transaction fees and transferred amounts (fee/amount) to capture the fee pressure relative to the moved value. Experiments on 10-minute blocks from 2017 to 2024 were conducted to evaluate scaling, dimensionality reduction (including principal component analysis), and 11 classical machine learning classifiers. Seasonal analyses show that motif frequencies cluster in specific periods. Overall, the pre-motif on-chain structure and economic signals are informative for motif discrimination, with the highest accuracy achieved by Fee + PCA + ExtraTrees.},
  doi      = {10.1109/ACCESS.2026.3674875},
  keywords = {Bitcoin;Blockchains;Forecasting;Accuracy;Windows;Feature extraction;Economics;Data analysis;Principal component analysis;Predictive models;Bitcoin;blockchain;chainlets;price motifs;transaction graph;pattern classification;feature extraction},
}

@InProceedings{Mao2025,
  author    = {Mao, Renjie and Zheng, Zuqing and Lai, Shuying and Tao, Yuechuan and Dong, Zhao Yang and Li, Tong and Huang, Zuliang and Qiu, Jing},
  booktitle = {2025 IEEE International Conference on Systems, Man, and Cybernetics (SMC)},
  title     = {Large Language Model Based Data Augmentation for Peak Electricity Price Forecasting and Battery Energy Storage Arbitrage},
  year      = {2025},
  month     = {Oct},
  pages     = {7762-7767},
  abstract  = {Battery Energy Storage Systems (BESS) play a vital role in enhancing grid flexibility, enabling renewable integration, and supporting peak shaving and frequency regulation. To fully realize their economic potential, BESS operators often participate in electricity market arbitrage—charging when prices are low and discharging during peak price periods. However, effective arbitrage strategies critically depend on accurate forecasting of electricity prices, particularly under extreme market conditions, which are often driven by sudden load surges, grid failures, or severe weather events. In this paper, we propose a novel framework that leverages a Large Language Model (LLM) for data augmentation to address the scarcity of extreme price scenarios in historical data. The LLM agent, guided by structured prompts that embed domain knowledge and physical constraints, generates realistic synthetic samples of rare peak-price events. These augmented datasets improve the robustness of a Bayesian electricity price forecasting model based on Monte Carlo dropout, which provides not only point estimates but also predictive confidence intervals. Finally, a scenario-based stochastic optimization model is developed to guide BESS arbitrage decisions using the probabilistic price forecasts. Simulation results show that the proposed framework significantly enhances the predictive accuracy and economic efficiency of storage arbitrage under uncertainty.},
  doi       = {10.1109/SMC58881.2025.11342789},
  keywords  = {Uncertainty;Accuracy;Electricity;Large language models;Simulation;Optimization models;Stochastic processes;Predictive models;Probabilistic logic;Forecasting;Battery Energy Storage Systems;electricity market arbitrage;electricity prices forecasting;Large Language Model},
}

@InProceedings{Gondkar2021,
  author    = {Gondkar, Atharva and Thukrul, Jeevan and Bang, Raghav and Rakshe, Siddhika and Sarode, Sambhaji},
  booktitle = {2021 2nd Global Conference for Advancement in Technology (GCAT)},
  title     = {Stock Market Prediction and Portfolio Optimization},
  year      = {2021},
  month     = {Oct},
  pages     = {1-10},
  abstract  = {The highly volatile nature of the stock market has made stock price prediction as challenging as weather forecasting. Consequently, as a hint of this dread, people don’t invest in the stock market. In this paper, we have discussed hybrid networks and a stacked LSTM network for stock price prediction. Additionally, it also focuses on portfolio optimization done using six different techniques, which focuses on creating best performing portfolios categorized on the basis of sectors. One hybrid neural network consists of 1D-Convolutional layers and LSTM layers, and the other is a combination of GRU and LSTM layers. The stock prices of SBI, Indian Bank, Bank of India are predicted using stacked LSTM and Hybrid Neural Networks and compared using the sliding window of time steps with variable width. The neural networks predict the following day’s closing price using a variable sliding window. The RMSE, MSE, and MAE are used to evaluate the efficiency of these neural networks. The hybrid network is proving to be more competent in various situations.},
  doi       = {10.1109/GCAT52182.2021.9587659},
  keywords  = {Measurement;Deep learning;Reactive power;Neural networks;Weather forecasting;Predictive models;Stock markets;Volatile;stacked LSTM;Hybrid neural networks;portfolio optimization;sliding window},
}

@InProceedings{Deswal2023,
  author    = {Deswal, Vikas and Kumar, Dharminder},
  booktitle = {2023 12th International Conference on System Modeling & Advancement in Research Trends (SMART)},
  title     = {Stock Price Prediction of AAPL Stock by Using Machine Learning Techniques: A Comparative Study},
  year      = {2023},
  month     = {Dec},
  pages     = {210-217},
  abstract  = {In today's world, everyone is looking for smart way of investing his/her hard earned money. There are several ways of investment, such as purchasing land, investing in real estate, fixed deposit in banks and investing in the stock market. In all other investment options except for the stock market, require a lot of initial funds. This is one of the reasons why many people are motivated to invest in the stock market. But stock market is very volatile, dynamic and uncertain. So its prediction is a very challenging and tough task in today's competitive and open environment. Earlier this prediction work was done by expert stock brokers and traders. This prediction by human being was possible because data was limited, simple, restricted to local area and powerful computing machines were not available. Now a day data is unlimited, complex and its generating speed is very fast that's why data prediction is done by machine learning algorithms. Selection of appropriate machine learning model is again a difficult task. This paper evaluates the performance of five different ML algorithms: linear regression, support vector machines (SVM), random forest, neural networks, and long short-term memory (LSTM) for predicting the stock price of Apple Inc. (AAPL). Accuracy of all five machine learning models is evaluated using values of performance metrics like root mean square error (RMSE), mean square error (MSE), mean absolute error (MAE), and mean absolute percentage error (MAPE). Goodness of fit of all five machine learning models is also checked by using values of coefficient of determination $(\mathbf{R}^{2})$. This paper predicts AAPL stock value by using five different algorithms and then graph is plotted between actual & predicted prices for all models. Plot between actual & predicted AAPL stock value, measurement metrics (RMSE, MSE, MAE, MAPE) value demonstrate that regression algorithms, especially linear regression, neural networks, and LSTM achieve good accuracy on the AAPL stock price data. Value of coefficient of determination $(\mathbf{R}^{2})$ proves that LSTM model is fit for stock price prediction of AAPL stock.},
  doi       = {10.1109/SMART59791.2023.10428451},
  issn      = {2767-7362},
  keywords  = {Support vector machines;Machine learning algorithms;Neural networks;Predictive models;Prediction algorithms;Stock markets;Task analysis;stock market prediction;machine learning;LSTM;RMSE;MAPE;adjusted Apple (AAPL)},
}

@InProceedings{Tian2023,
  author    = {Tian, Zhengjie and Zeng, Yizhen},
  booktitle = {2023 IEEE International Conference on Electrical, Automation and Computer Engineering (ICEACE)},
  title     = {Multi-Temporal Petroleum Price Estimation Model Based on VMD-SSA-LSTM and Its Application},
  year      = {2023},
  month     = {Dec},
  pages     = {897-902},
  abstract  = {As a critical global power source, petroleum holds a pivotal role in contemporary human society. Consequently, the precise forecasting of petroleum price trends becomes imperative for guiding actions within the petroleum market by both buyers and sellers. While the VMD model has gained popularity in recent years for petroleum price estimation, its utility has been constrained by the absence of standardized rules for parameter selection, limiting model generalization and compatibility. In this study, we introduce an improved signal-power (ISP) criterion to ascertain the optimal amount of modal decompositions. Moreover, we employ the noise-reduction capabilities of the VMD technique and the optimization prowess of the Sparrow Search Algorithm (SSA) algorithm to fine-tune the parameters of the Long Short-Term Memory (LSTM) neural network. The integration of these methodologies gives rise to the VMD-SSA-LSTM model. Utilizing daily opening prices, high prices, low prices, settlement prices, daily turnover, and position volume data for WTI petroleum spanning from November 9, 2020, to September 29, 2023, this paper predicts petroleum closing prices. We utilize evaluation metrics such as MAE, MAPE, and RMSE. Our results show that the individual LSTM and VMD-LSTM models are inferior to the VMD-SSA-LSTM model in all three evaluation criteria. These results demonstrate the feasibility of our model for oil price estimation and provide a novel perspective in the field.},
  doi       = {10.1109/ICEACE60673.2023.10442755},
  keywords  = {Oils;Heuristic algorithms;Neural networks;Estimation;Data models;Petroleum;Optimization;Variational mode decomposition;Sparrow Search Algorithm;Long Short-Term Memory;Improved signal-power},
}

@InProceedings{Pal2016,
  author    = {Pal, Shalini and Kumar, Rajesh},
  booktitle = {2016 IEEE 7th Power India International Conference (PIICON)},
  title     = {Price prediction techniques for residential demand response using support vector regression},
  year      = {2016},
  month     = {Nov},
  pages     = {1-6},
  abstract  = {The bidirectional flow of information among utilities and energy customers can be easily adapted to increase awareness for user's involvement in demand response programs. In demand response programs to improve the interaction between utility and customer, price communication plays an important role. If the future prices for next day can be sent to end consumer, so with the prior knowledge of price, the consumer can schedule their appliances in the same accordance to get less amount in the bill. Therefore, to get prior price information prediction technique comes in the scenario. To enhance price prediction capability, it needs a call from optimization techniques. In this paper, we have proposed the price prediction by support vector regression with genetic algorithm (SVRGA) approach. The simulation result has shown the efficiency of proposed approach and proposed technique is also compared with other existing techniques as artificial neural network (ANN) and linear prediction model (LPM).},
  doi       = {10.1109/POWERI.2016.8077427},
  keywords  = {Manganese;Demand Response;price prediction;linear prediction model;artificial neural network;support vector regression},
}

@InProceedings{Sharma2024,
  author    = {Sharma, Vikram and Rakhra, Manik and Sharma, Vikrant and Sarkar, Tiyas and Singh, Amanpreet and Jairath, Kapil},
  booktitle = {2024 International Conference on Electrical Electronics and Computing Technologies (ICEECT)},
  title     = {Hybrid Approaches for Stocks Price Prediction: A New Institutive Way of Neural Architecture Design},
  year      = {2024},
  month     = {Aug},
  pages     = {1-6},
  volume    = {1},
  abstract  = {Stock price prediction is a critical aspect of financial decision-making for both individual investors and institutions. Traditional methods such as ARIMA and deep learning techniques like ANNs, LSTM, and GRU have demonstrated effectiveness in forecasting stock prices but suffer from inherent limitations. In recent years, hybrid models have emerged as a promising approach to address these shortcomings. This research paper introduces and evaluates three novel hybrid models for stock price prediction. First model integrates GRU, LSTM, and attention mechanisms to leverage the strengths of each component. By employing attention mechanisms, the model can focus on relevant information, thereby enhancing prediction accuracy. The second model combines GRU and LSTM networks with attention mechanisms, incorporating additional architectural elements to further refine predictive capabilities. The third proposed model is a fusion of the first two, augmented with additional features and enhancements to achieve superior performance in stock price prediction tasks. Evaluation of these proposed models utilizes commonly used metrics to assess predictive accuracy and generalizability. The results demonstrate the effectiveness of the proposed hybrid approaches in improving stock price prediction performance. This research contributes to the advancement of stock price prediction methodologies by proposing innovative hybrid models, offering valuable tools for researchers and practitioners in the finance industry seeking enhanced forecasting accuracy and decision-making capabilities.},
  doi       = {10.1109/ICEECT61758.2024.10739249},
  keywords  = {Measurement;Industries;Deep learning;Attention mechanisms;Accuracy;Decision making;Finance;Predictive models;Forecasting;Long short term memory;ANN;LSTM;GRU;RNN;soft computing;Stock Price Prediction;Hybrid approaches;Self-Attention},
}

@InProceedings{HajiAbbasi2024,
  author    = {Haji Abbasi, Mohammad Mahdi and Rahmati, Zahed and Abbaszadeh, Mostafa},
  booktitle = {2024 10th International Conference on Signal Processing and Intelligent Systems (ICSPIS)},
  title     = {A Graph-Based Approach for Price Prediction and Portfolio Management},
  year      = {2024},
  month     = {Dec},
  pages     = {62-67},
  abstract  = {In quantitative trading, investors seek to maximize profits while minimizing risk. To forecast future prices and assess risks, it is crucial to employ price prediction models such as RNN, GRU, and even combinations of these with convolutional networks. However, the high computational cost of running these models on the entire stock market data has led some researchers to focus on specific market segments or random selections of stocks. Even when computational cost is not a concern, time remains a critical factor in financial markets. In this study, we aim to achieve optimal returns by selecting stocks and predictive models with the lowest time complexity. We construct a graph of the stock market to identify key nodes, train deep learning models on historical price data, and predict future prices. Based on these predictions, we then form a portfolio using the Markowitz model. The performance of this constructed portfolio is compared against the benchmark, S&P 500, and demonstrates superior results.},
  doi       = {10.1109/ICSPIS65223.2024.10931072},
  keywords  = {Computational modeling;Predictive models;Signal processing;Data models;Computational efficiency;Convolutional neural networks;Stock markets;Time complexity;Portfolios;Optimization;portfolio optimization;Graph centrality;CNN;RNN;GRU},
}

@InProceedings{Kashyap2024,
  author    = {Kashyap, Siddhant and Ramisetty, Srividya and Narayanaswamy, Rekha},
  booktitle = {2024 International Conference on Computing and Data Science (ICCDS)},
  title     = {A Novel Method of Bitcoin Price Prediction},
  year      = {2024},
  month     = {April},
  pages     = {1-4},
  abstract  = {The popularity and value of Bitcoin have attracted numerous traders and researchers, leading to countless studies on prediction of Bitcoin price. To improve accuracy, relevant features with strong correlation to Bitcoin prices are typically chosen from the dataset, and a random data subset is used for model training and model testing. Unfortunately, the random selection of data may lead to unfitting outcomes, thereby reducing the accuracy of the price predictions. To look into it, a methodology is proposed that involves identifying suitable data chunks for model training. Using this methodology, Simple Long Short Term Memory model is trained to predict future five days Bitcoin prices. The outcome showed that when LSTM model is trained with an appropriate data block, sustainable results were achieved. Overall, the study highlights importance of carefully selecting machine learning algorithms, training data, exceptionally for Bitcoin price prediction for future five days.},
  doi       = {10.1109/ICCDS60734.2024.10560443},
  keywords  = {Training;Accuracy;Training data;Bitcoin;Pricing;Predictive models;Prediction algorithms;Bitcoin;Epoch;Price Prediction;Machine Learning;LSTM},
}

@InProceedings{Radmand2023,
  author    = {Radmand, Elnaz and Pirgazi, Jamshid and Odeh, Mahmoud and Sorki, Ali Ghanbari},
  booktitle = {2023 2nd International Engineering Conference on Electrical, Energy, and Artificial Intelligence (EICEEAI)},
  title     = {Bitcoin Price Prediction Using Cuckoo Search Algorithm for Feature Selection with LSTM Model},
  year      = {2023},
  month     = {Dec},
  pages     = {1-6},
  abstract  = {Deep learning is now a top method for predicting the price of Bitcoin, providing an excellent and well thought out strategy. This technique makes use of a wealth of historical data from reliable sources covering the first ten years of Bitcoin. Technical data and complex patterns are deeply integrated into the dataset to enhance the model's comprehension of complex Bitcoin price patterns. These additions greatly deepen our understanding of the various factors affecting the price of Bitcoin. This method is based on a strategic procedure that involves the careful selection of certain high-performing characteristics. These traits go through a stringent screening process that uses advanced algorithms such as the Cuckoo algorithm. The chosen features are then smoothly incorporated into an encoder-decoder model of LSTM (Long Short-Term Memory), improving the model's ability to predict Bitcoin prices. In this case, it is critical to apply deep learning methods, especially the LSTM encoder-decoder model. Through the integration of technical indicators and sophisticated selection techniques with historical Bitcoin data, this approach leverages deep learning capabilities to identify intricate patterns in Bitcoin pricing movements. In the end, this gives the model the ability to forecast future changes in the price of Bitcoin with accuracy.},
  doi       = {10.1109/EICEEAI60672.2023.10590475},
  keywords  = {Deep learning;Bitcoin;Pricing;Predictive models;Prediction algorithms;Feature extraction;Data models},
}

@InProceedings{Wang2023a,
  author    = {Wang, Yiwei and Lan, Xingge and Li, Jiawei},
  booktitle = {2023 3rd International Signal Processing, Communications and Engineering Management Conference (ISPCEM)},
  title     = {Portfolio Optimization Based on a Two-Layer LSTM Prediction Model},
  year      = {2023},
  month     = {Nov},
  pages     = {467-471},
  abstract  = {Gold and Bitcoin, as common volatile assets, have become important financial hedges for people. However, the gold and bitcoin markets are full of unknowns, which increases the complexity for market traders to make investment decisions. Therefore, it is critical to accurately determine the changing trends in the financial markets and make the best portfolio trading strategy. we train the LSTM Model to achieve the prediction of future prices. Besides, we build a Portfolio Optimization Model to maximize the total returns. Based on our model, we provide investment trading strategies over 5 years. The results show that after portfolio optimization, the total assets amounted to 282600.8 USD. we designed three separate comparison experiments to verify the performance of our model. The results show that our model is able to achieve greater returns and better control risk.},
  doi       = {10.1109/ISPCEM60569.2023.00089},
  keywords  = {Training;Gold;Bitcoin;Predictive models;Market research;Feature extraction;Long short term memory;Financial hedges;Investment decision;LSTM Model;Portfolio Optimization Model},
}

@InProceedings{Balakrishnan2026,
  author    = {Balakrishnan, D. and Reddy, Pochana Satish Kumar and Reddy, Guddeti Lokeshwara and Kumar, Chennupati Prasanth and Reddy, Gummithi Vishnu Vardhan and Mariappan, Umasree},
  booktitle = {2026 International Conference on Intelligent and Innovative Technologies in Computing, Electrical and Electronics (IITCEE)},
  title     = {AI-Based Smart Crop Advisory and Support System for Farmers},
  year      = {2026},
  month     = {Jan},
  pages     = {1-6},
  abstract  = {Agriculture continues to be the backbone of rural livelihoods, yet many farmers still depend on traditional practices and intuition for crucial decisions. Uncertain weather, soil degradation, and poor access to timely information often result in low productivity and financial risk. AgriGenius is designed to support farmers by bringing multiple farm-management features into a single interactive platform. The system recommends appropriate crops, fertilizers, and pest control measures based on local environmental conditions and land data. It also offers weather updates, irrigation guidance, yield estimation, and market price forecasting. Every component of the platform works together to assist farmers in planning their activities more efficiently and sustainably. Through this integrated approach, AgriGenius helps promote informed decision-making, reduces resource wastage, and encourages modern, data-supported farming practices suitable for all types of cultivators.},
  doi       = {10.1109/IITCEE67948.2026.11394509},
  groups    = {Previsão + Otimização},
  keywords  = {Weather;Irrigation;Soil measurements;Pest control;Soil;Planning;Yield estimation;Forecasting;Fertilizers;Farming;Smart Farming;Precision Agriculture;Decision Support System;Crop Planning;Fertilizer Optimization;Pest Control;Weather Guidance;Irrigation Scheduling;Market Forecasting;Sustainable Farming;crop yield increase},
}

@InProceedings{Saraswathi2025,
  author    = {Saraswathi, R. Vijaya and Rahul, L. and Lokeswar, S. and Varma, R.Vathsav and Ajay, U.},
  booktitle = {2025 6th International Conference on Mobile Computing and Sustainable Informatics (ICMCSI)},
  title     = {Integrated IoT Based Smart Agriculture Monitoring System},
  year      = {2025},
  month     = {Jan},
  pages     = {246-251},
  abstract  = {The adoption of IoT technology in agriculture is revolutionizing traditional farming, making it a data-driven and resource-efficient field. Proposed paper introduces an IoTbased smart agriculture monitoring system designed to provide farmers with accurate real-time insights for improved crop and resource management. The system incorporates a network of sensors to monitor essential environmental variables like soil moisture and temperature. These signals are processed by a microcontroller and securely transmitted to a cloud platform for advanced analytics. A mobile-friendly application offers actionable insights, notifications, and remote access, facilitating informed decision-making. Built on a Wi-Fi-based infrastructure, the system ensures reliable communication even in areas with inconsistent internet connectivity. Field implementations reveal notable advancements in resource utilization, crop yields, and labor efficiency. Additionally, an embedded AI module forecasts crop prices with 92% accuracy, enabling farmers to optimize sale timings for increased profitability in competitive markets. This comprehensive solution highlights the transformative potential of IoT in fostering sustainable and profitable agricultural practices.},
  doi       = {10.1109/ICMCSI64620.2025.10883486},
  groups    = {Suporte à Decisão Agrícola},
  keywords  = {Temperature sensors;Temperature measurement;Smart agriculture;Weather forecasting;Real-time systems;Resource management;Predictive analytics;Monitoring;Intelligent sensors;Crop yield;Smart agriculture;Crop monitoring;Soil moisture Data-driven decision making;Resource optimization;Crop yield improvement;Modal price Farmer productivity;Sustainable farming},
}

@InProceedings{Marcos2016,
  author    = {de Marcos, Rodrigo A. and Reneses, Javier and Bello, Antonio},
  booktitle = {2016 International Conference on Probabilistic Methods Applied to Power Systems (PMAPS)},
  title     = {Long-term Spanish electricity market price forecasting with cointegration and VEC models},
  year      = {2016},
  month     = {Oct},
  pages     = {1-7},
  abstract  = {Commodity and electricity price models are motivated by the several unexpected evolutions that commodity prices have shown over the previous decades. Several models are based on the classic Black-Scholes model, which was one of the first to simulate the stochastic behaviour of commodity prices. However, as of today, these forecasting models show poor performance when tested in long-term horizons, especially when applied to electricity market prices. This work attempts to determine a way to provide a decent accuracy in long-term (one year or more) forecasts of the Spanish electricity market price using cointegration and vector error correction (VEC) models, alongside other variables, such as fuel spot prices and futures prices. These variables have been assessed in order to determine which factors contribute to this work's purpose.},
  doi       = {10.1109/PMAPS.2016.7764158},
  keywords  = {Decision support systems;Predictive models;Electricity supply industry;Error correction;Forecasting;Cointegration;Commodity Price Models;Electricity Markets;Error Correction Models;Long-Term Forecasting},
}

@InProceedings{Kaushalya2020,
  author    = {Kaushalya, T. V. H. and Wijewardana, B. Y. S. and Karunasena, Anuradha and Kavishika, M. G. G. and Gamage, S. T. A. and Weerasinghe, Lokesha},
  booktitle = {2020 2nd International Conference on Advancements in Computing (ICAC)},
  title     = {CEYLAGRO: Information Technological Approach for an Optimized and Centralized Agriculiture Platform},
  year      = {2020},
  month     = {Dec},
  pages     = {198-203},
  volume    = {1},
  abstract  = {Sri Lankan Agriculture sector can be considered as a crucial component as it contributes 18% of country GDP. As native farmers still cling to inapplicable traditional theorems and practices to track customer's vegetable consumption trends, they failed to assure a “good price” for their harvest. Also, the plants are prone to many diseases and pests' attacks which causes loss of the harvest. Unreliable problem identification, poor knowledge on application of fertilizers and pesticides have caused the farmers to lose their profits. As a solution to mitigate these problems, this study has built a computerized system with a vegetable price prediction system and a plant disease, pest identification system. Taking Potato as an example, the parameters of the time series model were analyzed through experiment and has built the price predictor using ARIMA model. Also, with advanced Image processing and CNN techniques Plant disease, pest identifier has built. Desirable results of the entire system have been achieved with more than 94%-97% rate of accuracy. The ultimate goal of this study is to achieve the optimal growth of the sector by navigating the users for a quality and effective decision making by reliable market trends and problem identification.},
  doi       = {10.1109/ICAC51239.2020.9357313},
  groups    = {Predição de Commodities},
  keywords  = {Analytical models;Computational modeling;Time series analysis;Predictive models;Market research;Diseases;Fertilizers;Agriculture;Price Prediction;Plant Disease Identification;ARIMA;CNN;Image Processing;Realtime Database;Time Series Model},
}

@InProceedings{Abivarshini2025,
  author    = {Abivarshini, R. and France, K.},
  booktitle = {2025 3rd International Conference on Inventive Computing and Informatics (ICICI)},
  title     = {Stock Market Price Prediction Using Deep Learning},
  year      = {2025},
  month     = {June},
  pages     = {243-247},
  abstract  = {The stock market's volatility which makes it challenging for human traders to make accurate price predictions has led to a notable increase in prediction models over the past few decades. This study uses deep learning (DL) and machine learning (ML) approaches to predict stock values in the Indian stock market. The primary goal is to help intraday and short-term traders make informed decisions by offering data-driven forecasts. This study included three powerful algorithms: Long Short-Term Memory (LSTM), XGBoost and Random Forest (RF). To improve prediction accuracy an ensemble learning technique lowers overfitting and boosts generalization RF. XGBoost which is renowned for its effectiveness and superior performance uses gradient-boosting techniques to maximize predictions. The goal of the study is to determine the most effective model for forecasting stock market trends by evaluating and contrasting the accuracy of these three algorithms. The study takes into account a number of variables in order to create a reliable prediction model such as past prices trade volume and market patterns. The results of this initiative will be especially helpful to novice investors allowing them to make less risky data-driven investment choices. By offering more accurate forecasts the findings may potentially help to enhance algorithmic trading techniques.},
  doi       = {10.1109/ICICI65870.2025.11069794},
  keywords  = {Deep learning;Radio frequency;Solid modeling;Accuracy;Supervised learning;Predictive models;Prediction algorithms;Stock markets;Long short term memory;Random forests;Stock Market Prediction;Deep Learning;Supervised Learning;LSTM;Random Forest;XGBoost;Intraday Trading;Short-Term Trading;Data Mining;Algorithm Comparison},
}

@InProceedings{Singh2023,
  author    = {Singh, Mrityunjay and Jakhar, Amit Kumar and Juneja, Aashima and Pandey, Shivam},
  booktitle = {2023 Third International Conference on Secure Cyber Computing and Communication (ICSCCC)},
  title     = {Machine Learning Based Framework for Cryptocurrency Price Prediction},
  year      = {2023},
  month     = {May},
  pages     = {31-36},
  abstract  = {Cryptocurrency, a digital currency, acts as a medium of exchange through the Internet. The main agenda behind cryptocurrency being so popular these days is the desire for reliable, long-term value without the involvement of any central authority like banks. The power lies in the hands of the currency holders which resolve the problems of the traditional currencies by adopting a decentralized system. Predicting the future price of different cryptocurrencies is a prominent area of interest for individuals or investors. In this work, we use a dataset collected from the coinmarketcap website for the duration of September 2014 to March 2022. The outcome of this work is compared to the existing algorithms for time series data analysis namely the Auto Regressive Moving Average Model (ARIMA), FbProphet, and several ensemble models on the basis of their accuracy in predicting the future price. We also create different ensemble frameworks for the prediction of the cryptocurrency price. To form the ensemble models, we initially select the three best-performing regression models on the dataset, namely Extra Trees, Random Forest, and Decision Trees Regressors. Our findings indicate that the ARIMA model performs better than the ensemble model with the lowest RMSE MAE and MSE.},
  doi       = {10.1109/ICSCCC58608.2023.10176572},
  keywords  = {Analytical models;Machine learning algorithms;Data analysis;Time series analysis;Predictive models;Prediction algorithms;Data models;Cryptocurrency;Cryptocurrency price prediction;ARIMA;FBProphet;Ensemble Framework;Bitcoin},
}

@InProceedings{Sudirman2025,
  author    = {Sudirman, Ivan Diryana and Rahmah, Rosyidah},
  booktitle = {2025 3rd International Conference on Disruptive Technologies (ICDT)},
  title     = {Dynamic Pricing Optimization for Coffee Shops Using a Machine Learning Approach with Random Forest Models},
  year      = {2025},
  month     = {March},
  pages     = {1282-1286},
  abstract  = {This study looks at how dynamic pricing can help coffee shops make more revenue using machine learning. It uses three months of sales data to find patterns and predict the effects of price changes. Simulations show that raising prices by 10% during afternoon peak hours brings the most revenue, while discounts and other adjustments also boost profits. A Random Forest model, with a strong predictive score (R2 = 0.984), captures the trends effectively. The results highlight how machine learning combined with point-of-sale systems can create smarter pricing strategies that match customer habits, driving both profits and satisfaction.},
  doi       = {10.1109/ICDT63985.2025.10986336},
  keywords  = {Profitability;Focusing;Pricing;Predictive models;Market research;Disruptive technologies;Random forests;Optimization;Testing;Meteorology;Dynamic pricing;Machine learning;Coffee shop revenue;Random Forest;Predictive modeling},
}

@InProceedings{AR2026,
  author    = {A R, Hamsaveni and Ramani, D. Roja and C M, Harshith and B, Chempavathy and G, Srividhya},
  booktitle = {2026 6th International Conference on Pervasive Computing and Social Networking (ICPCSN)},
  title     = {A Decentralized Blockchain Framework for Agricultural Data Tracking with Emphasis on Scalability and Farmer Adoption},
  year      = {2026},
  month     = {May},
  pages     = {1796-1801},
  abstract  = {Agriculture is important for economic systems because it provides essential products that are consumed to sustain human life. However, one challenge the agricultural sector faces is a complex distribution system that relies primarily on a third-party intermediary to sell its products. The authors propose a new innovative solution using machine learning and spacecraft-related technologies to facilitate direct sales and purchases between farmers and customers, without the use of a third-party intermediary. Here, we propose a framework for the development of a decentralized marketplace that enables the direct transfer of goods from farmers to customers, which supports more efficient markets and fairer prices for both farmers and customers. We discuss the relevant Linear Regression algorithms, market prediction models, and cutting-edge technologies such as blockchain ledger, cloud infrastructure, Internet of Things (IoT), edge computing, and 5G to support trust, traceability, and transparency associated with these transactions.},
  doi       = {10.1109/ICPCSN68523.2026.11543873},
  keywords  = {Internet of Things;Pricing;Modeling;Machine learning;Timing;Real-time systems;Crops;Edge computing;Technology;5G mobile communication;Linear Regression;Blockchain;Supply Chain Optimization;Decentralized Systems;IoT;5G;Edge Computing;Firebase Real-time Database},
}

@Article{Alfonso2021,
  author   = {Alfonso, Gerardo and Carnerero, A. Daniel and Ramirez, Daniel R. and Alamo, Teodoro},
  journal  = {IEEE Access},
  title    = {Stock Forecasting Using Local Data},
  year     = {2021},
  issn     = {2169-3536},
  pages    = {9334-9344},
  volume   = {9},
  abstract = {Stock price forecasting is a relevant and challenging problem that has attracted a lot of interest from engineers and scientists. In this paper we apply two techniques for stock price and price intervals forecasting. Both techniques, derived from previous works by the authors, are based on the use of local data extracted from a database. These data are those that correspond to similar market states to the current one. The first technique uses these local data to compute a price forecast by finding an optimal combination of past states that equals the current state. The price forecast is then obtained by combining the past actual prices associated to the past market states. The second technique can be used to forecast prices but its main use is to forecast price intervals that will contain the real future price with a guaranteed probability. This is accomplished by building a probability distribution for the forecasted price and then setting the intervals by a choice of desired percentiles. Thus, this technique can be used in financial risk management. Both techniques are purely data driven and do not need a theoretical description or model of the price trend being forecasted. The proposed techniques adapt very easily to market changes because they use only the subset of the database that it is closer to the current state. Furthermore, the database can be updated as new data is available. Finally, both approaches are highly parallelizable, thus making possible to manage large data sets. As a case study, the proposed approaches have been applied to the k-step forecasting of the Dow Jones Industrial Average index. The results have been validated in relation with some baseline approaches, such as martingale and neural network predictors and quantile regression for the interval forecasting.},
  doi      = {10.1109/ACCESS.2020.3047160},
  keywords = {Forecasting;Databases;Neural networks;Training;Prediction algorithms;Indexes;Security;Stock forecasting;probabilistic interval forecasting;direct weight optimization;data driven methods},
}

@InProceedings{Patil2026,
  author    = {Patil, Durvesh and Pajwani, Krish and Thoday, Vijayetha},
  booktitle = {2026 IEEE 18th International Conference on Computational Intelligence and Communication Networks (CICN)},
  title     = {AgriNirnay: Decision Support System for Farmers in Maharashtra},
  year      = {2026},
  month     = {June},
  pages     = {1235-1239},
  abstract  = {Farmers in the Nashik district of Maharashtra experience structural market uncertainty, and therefore sowing decisions 90-120 days to harvest, with retrospective price information-a phenomenon that encourages herd behaviour and numerical price crises. AgriNirnay is a complex Decision Support System (DSS) which has been developed to combine live commodity pricing, geospatial production, edaphic soil parameters, and government subsidy information into a single Streamlit-based service. Using data collected by Nashik Agmarknet on 22 years of Nashik soil types, coded explicitly to be the XGBoost regressor, the Mean Absolute Error of 112.81 Rs/quintal is obtained- a 87.8 percent and 41.4 percent improvement over ARIMA and LSTM baselines respectively. A confirmatory ablation study allows establishing an encoding of soil type that decreases the MAE by 22.7 points, which confirms the usefulness of agronomic variables in the econometric forecasting. The sow recommendations are presented in a traffic-light colour scheme (Sow / Stable / Avoid) so that they can be easily accessed by the users with low levels of digital literacy. Supabase postgres backend offers real-time information on the eligibility of schemes by the government, and an interactive choropleth heatmap supports supply dynamics in the region. AgriNirnay proves that the Indian onion market has long been destabilised by the presence of information asymmetry which can be seriously curtailed by relating agronomic science with that of econometric forecasting.},
  doi       = {10.1109/CICN70047.2026.11594153},
  groups    = {Suporte à Decisão Agrícola},
  issn      = {2472-7555},
  keywords  = {Pricing;Modeling;Printing;Soil;Production;Forecasting;Long short term memory;Encoding;Costing;Costs;decision support system;XGBoost;price forecasting;machine learning;real-time market data;agriculture},
}

@InProceedings{P2025,
  author    = {P, Vishal and R, Renesh Rohan and A, Jenifus Selvarani},
  booktitle = {2025 International Conference on Communication, Computer, and Information Technology (IC3IT)},
  title     = {Weather-Aware LSTM Networks for Cardamom Price Forecasting},
  year      = {2025},
  month     = {Oct},
  pages     = {1-5},
  abstract  = {Predicting agricultural commodity prices continues to be an important challenge due to market fluctuations and climate variability. This study proposes a long short-term memory (LSTM) network-based deep learning framework for predicting cardamom prices using historical auction data and climate variables (i.e., temperature, humidity, and rain) from the Visual Crossing API. Our approach extends traditional univariate forecasting models that condition only on past prices to a multivariate framework that integrates economic and environmental dependencies, resulting in more robust forecasts in volatile environments. To evaluate model performance (in terms of Root Mean Square Error (RMSE), Mean Absolute Error (MAE) and Mean Absolute Percentage Error (MAPE)), results generally improve over the baseline. To enhance interpretability, SHAP (SHapley Additive exPlanations) values were introduced to facilitate understanding of each variable's contribution to a forecast. In conclusion, the findings indicate that climate- aware forecasting frameworks may provide reliable and usable forecasts that lead to more informed decision-making for farmers, traders, cooperatives, and policy makers. This work contributes to growing interest in developing climate-integrated deep learning approaches to manage uncertainty associated with agricultural markets.},
  doi       = {10.1109/IC3IT66137.2025.11341488},
  keywords  = {Economics;Deep learning;Weather;Visualization;Temperature distribution;Uncertainty;Biological system modeling;Time series analysis;Forecasting;Long short term memory;LSTM;weather data;time series forecasting;agricultural economics;Visual Crossing API;climate-aware prediction},
}

@InProceedings{Verma2025,
  author    = {Verma, Lalit and Sharma, Chirag and Nagpal, Tanya},
  booktitle = {2025 International Conference on Innovations and Emerging Technologies In AI & Communication Systems (IETACS)},
  title     = {LSTM & Transfer Learning for Stock Market Bitcoin Price Prediction: An AI-Driven Channel Estimation and Prediction},
  year      = {2025},
  month     = {Nov},
  pages     = {777-782},
  abstract  = {Bitcoin, the most famous and priceless cryptocurrency in the modern financial products market, draws investors and opens new research avenues for scholars. Predicting Bitcoin values has been the subject of numerous studies employing a variety of machine learning prediction techniques. AI-driven channel estimation and prediction include important features extracted from a dataset that has a strong correlation with Bitcoin values to conduct the study. The model was then trained and tested using randomly selected data chunks. Unfitting outcomes caused by the random data selected for model training could reduce the price forecast accuracy. An effective training process for the prediction model is examined here. The suggested simple LSTM model, which predicts the cost of Bitcoin for the next five days, was then trained using this process. When the LSTM model is trained with a suitable data chunk, which has been determined, sustainable results for the prediction are obtained. Finally, the work culminates in future developments.},
  doi       = {10.1109/IETACS68750.2025.11385710},
  keywords  = {Training;Costs;Transfer learning;Channel estimation;Bitcoin;Predictive models;Feature extraction;Data models;Stock markets;Long short term memory;Bitcoin;Cryptocurrency;Machine Learning;Price Prediction;LSTM},
}

@InProceedings{Trawinski2021,
  author    = {Trawinski, Alex and Wimmer, Hayden and Tong, Weitian},
  booktitle = {2021 IEEE 12th Annual Information Technology, Electronics and Mobile Communication Conference (IEMCON)},
  title     = {Deep Learning on Cryptocurrency - Challenges Processing GPU and CPU Architectures},
  year      = {2021},
  month     = {Oct},
  pages     = {0371-0377},
  abstract  = {Deep learning has made vast advances over the recent decade due to hardware, software, and architecture improvements. Applying deep learning still has some challenges to overcome, especially when processing on GPU or in parallel. This work seeks to apply RNN and LSTM over a variety of architectures to demonstrate the challenges and techniques encountered when applying deep learning. We apply RNN and LSTM over GPU and CPU across PC, high performance computing cluster, and cloud and present our challenges and results.},
  doi       = {10.1109/IEMCON53756.2021.9623132},
  issn      = {2644-3163},
  keywords  = {Deep learning;High performance computing;Conferences;Graphics processing units;Computer architecture;Mobile communication;Software;GPU;Deep Learning;RNN;LSTM;Cryptocurrency;Bitcoin},
}

@Article{Abdullah2023,
  author   = {Abdullah and Sarpong-Streetor, Richard Manu Nana Yaw and Sokkalingam, Rajalingam and Othman, Mahmod and Azad, Abdus Samad and Syahrantau, Gunawan and Yusriwarti and Arifin, Zainal},
  journal  = {IEEE Access},
  title    = {Intelligent Hybrid ARIMA-NARNET Time Series Model to Forecast Coconut Price},
  year     = {2023},
  issn     = {2169-3536},
  pages    = {48568-48577},
  volume   = {11},
  abstract = {The global demand for coconut and coconut-based products has increased rapidly over the past decades. Coconut price continues to fluctuate; thus, it is not easy to make predictions. Good price modelling is important to accurately predict the future coconut price. Several studies have been conducted to predict the price of coconut using various models. One of the most important and widely used models in time series forecasting is the autoregressive integrated moving average (ARIMA). However, price fluctuations is considered a problem with uncertain behaviour. The existing ARIMA time series model is unsuitable for solving this problem, because of the nonlinear series. Artificial neural networks (ANN) have been an effective method in solving nonlinear data pattern problems in the last two decades. The non-linear autoregressive neural network (NARNET) gives good forecast, most especially when series are non-linear. Therefore ARIMA- NARNET is considered a universal approach to forecasting the coconut price. The aim of the study is to establish a linear and nonlinear model in time series to forecast coconut prices. The ability of a hybrid approach that combines ARIMA and NARNET(ANN) models is investigated. Based on the experimental study, the experimental results show that the proposed method ARIMA- NARNET, is better at forecasting the price of coconut, an agriculture commodity, than both the ARIMA model and NARNET models. The expected benefit of the proposed forecasting model is it can help farmers, exporters, and the government to maximize profits in the future.},
  doi      = {10.1109/ACCESS.2023.3275534},
  keywords = {Mathematical models;Predictive models;Autoregressive processes;Time series analysis;Forecasting;Artificial neural networks;Fluctuations;Arima-Narnet;intelligent hybrid;coconut price;forecasting;time series},
}

@InProceedings{Pratama2023,
  author    = {Pratama, Azkario Rizky and Putra, Bagus Rakadyanto Oktavianto},
  booktitle = {2023 15th International Conference on Information Technology and Electrical Engineering (ICITEE)},
  title     = {Investment Portfolio Optimization: Integrating Portfolio Allocation Methods with RNN LSTM},
  year      = {2023},
  month     = {Oct},
  pages     = {217-222},
  abstract  = {The investment industry is experiencing significant growth, driven by an increased interest from new investors. However, achieving success in investing heavily relies on effective decision-making skills, which can be particularly challenging for newcomers. To tackle this issue, the research proposes an investment decision support system designed to aid investors in optimizing their investment portfolios. The proposed approach integrates traditional mathematical methods with advanced Long-Short Term Memory (LSTM) machine learning techniques. The study demonstrates that the most effective combination involves employing LSTM alongside Post Modern Portfolio Theory (PMPT), resulting in the highest Mean Return of 0.002854, the highest Sortino Ratio of 0.192646, and the highest Ending Equity of 499.973204. Backtesting also reveals that the LSTM prediction, in combination with MPT and PMPT, has the potential to significantly increase portfolio values in just 1 year and 7 months, reaching 500% of the initial investment. Furthermore, incorporating LSTM predictions for future investment instrument prices enhances the performance of existing mathematical methods.},
  doi       = {10.1109/ICITEE59582.2023.10317711},
  issn      = {2766-0419},
  keywords  = {Decision support systems;Instruments;Machine learning;Predictive models;Transformers;Resource management;Information technology;investment decision support system;price prediction;portfolio allocation;time series analysis},
}

@InProceedings{Wu2025,
  author    = {Wu, Xuefei and Shang, Wei and Cao, Lei},
  booktitle = {2025 IEEE International Conference on Big Data (BigData)},
  title     = {Incorporating Market Risk Perception in Copper Commodity Price Forecasting},
  year      = {2025},
  month     = {Dec},
  pages     = {6939-6947},
  abstract  = {Aiming at the challenge of copper futures price fore casting, this study developed a hybrid model incorporating multi dimensional market sentiment and risk factors. A four dimension al sentiment index system covering supply, demand, financial env ironment, and policy trends is constructed based on text mining, alongside a dual track mechanism for identifying both explicit an d variant risks. Empirical results demonstrate that the proposed model achieves significantly higher predictive accuracy than benchmark models. Specifically, risk indicators are proved to be more reliable in capturing forward looking price signals during period s of market volatility, thereby providing a feasible instrument for quantifying market opinions for investment and production deci sions.},
  doi       = {10.1109/BigData66926.2025.11401748},
  issn      = {2573-2978},
  keywords  = {Text mining;Sentiment analysis;Accuracy;Instruments;Semantics;Production;Predictive models;Copper;Reliability;Forecasting;Copper Price;Risk Perception;Sentiment Analysis},
}

@InProceedings{Adiyattil2024,
  author    = {Adiyattil, Rini and Yadav, Sameer and Sowmya, S. and Santosh, Kathari and Vuyyuru, Veera Ankalu and Muthuperumal, S},
  booktitle = {2024 International Conference on Artificial Intelligence and Quantum Computation-Based Sensor Application (ICAIQSA)},
  title     = {Incorporating Investor Sentiment: A Stock Price Prediction Model with Sparrow Search Optimization and LSTM},
  year      = {2024},
  month     = {Dec},
  pages     = {1-6},
  abstract  = {This study shows a new way to predict stock prices by using both the feelings of investors and advanced computer techniques. This research aims to create a model that can predict how investors feel about the market, so we can make better predictions about how the market will change. This new way of doing things combines sentiment analysis with LSTM networks and Sparrow Search Optimization to tune the parameters, giving a complete view of how the market behaves. The plan includes gathering data from different places, getting it ready, and making a design for a special kind of computer system that includes feelings. Sparrow Search Optimization is used to make a model work better. The experiment showed that the new model is better at predicting stock prices than the old ways. The error in the predictions was reduced by 20%. This shows how important it is to analyze people's feelings when predicting finances. The research ends with advice for people who invest money, ideas for future research, and the overall impact of using sentiment analysis and machine learning in financial analysis.},
  doi       = {10.1109/ICAIQSA64000.2024.10882185},
  keywords  = {Sentiment analysis;Accuracy;Quantum computing;Computational modeling;Psychology;Machine learning;Predictive models;Long short term memory;Optimization;Testing;Stock price prediction;Investor sentiment analysis;Long Short-Term Memory (LSTM);Sparrow Search Optimization (SSO);Machine learning;financial forecasting},
}

@InProceedings{Ong2023,
  author    = {Ong, Jia You and Lim, Kian Ming and Lee, Chin Poo and Lim, Jit Yan},
  booktitle = {2023 IEEE 11th Conference on Systems, Process & Control (ICSPC)},
  title     = {Forex Daily Price Prediction Using Gated Recurrent Unit},
  year      = {2023},
  month     = {Dec},
  pages     = {72-77},
  abstract  = {The foreign exchange (Forex) market is globally recognized as one of the most prominent financial markets. In this paper, we focus on three major currency pairs: EUR/USD, GBP/USD, and USD/CHF, spanning from January 2007 to July 2022. We employ a range of techniques, including technical indicators, feature scaling, and Gated Recurrent Unit (GRU) network, to predict the closing price one day ahead of the current day. Our method demonstrates superior performance compared to other state-of-the-art approaches, achieving remarkably low Mean Absolute Errors (MAE) of 0.0046, 0.0063, and 0.0039 for the respective currency pairs: EUR/USD, GBP/USD, and USD/CHF.},
  doi       = {10.1109/ICSPC59664.2023.10420156},
  keywords  = {Time series analysis;Logic gates;Transformers;Data models;Robustness;Task analysis;Currencies;Forex price prediction;Recurrent neural networks;Gated Recurrent Unit},
}

@InProceedings{Zainal2016,
  author    = {Zainal, Nurul Asyikin and Mustaffa, Zuriani},
  booktitle = {2016 IEEE Student Conference on Research and Development (SCOReD)},
  title     = {Developing a gold price predictive analysis using Grey Wolf Optimizer},
  year      = {2016},
  month     = {Dec},
  pages     = {1-6},
  abstract  = {As the value of gold cannot be blindly rejected, forecasting the future prices of gold has long been an intriguing topic and is extensively studied by researchers from different fields including economics, statistics, and computer science. The motivation for these studies is naturally to predict the future prices so that gold can be bought and sold at profitable positions and reduce the risk of investment. However, there are still a lot of untackled questions and room for improvements in these forecasting techniques. This is because there are no optimal models for all forecasting problems. Different question needs a different answer; therefore, more experiments and modeling need to be done in order for researcher to enhance their findings. The target of this paper is to present a gold forecasting techniques using one of the optimization algorithm called Grey Wolf Optimizer (GWO).},
  doi       = {10.1109/SCORED.2016.7810031},
  keywords  = {Gold;Forecasting;Predictive models;Biological system modeling;Autoregressive processes;Artificial neural networks;Particle swarm optimization;Gold Price Forecasting;Swarm Intelligence;Grey Wolf Optimizer},
}

@InProceedings{Biswas2025,
  author    = {Biswas, Anushka and John Joshua, H and P, Kalpana and Vasanth, U. and Ramakrishna Gondkar, Raju and Jose, Teena},
  booktitle = {2025 International Conference on Electronics, Computing, Communication and Control Technology (ICECCC)},
  title     = {A Hybrid Genetic Algorithm and Large Language Model Approach for Agricultural Products Price Optimization},
  year      = {2025},
  month     = {May},
  pages     = {1-6},
  abstract  = {This paper introduces a hybrid approach, based on Genetic Algorithm (GA) and Large Language Models (LLMs), namely Mixtral 8x7B, to optimize pricing strategies for agricultural products. The method processes real-time market data, using Machine Learning (ML) techniques to generate competitive and profitable price recommendations. GAs allow for adaptive optimization, while LLMs capture complex trends in the market, making this approach more precise with respect to the pricing strategy. Case studies related to onions and tomatoes illustrate the efficiency of the optimization process. The outcome shows that the optimized prices achieve a fitness score of 0.915 (onions) and a competitive index of 0.89 (onions) compared to the market averages. Compared to traditional methods, the proposed hybrid model provides a better approach towards decision making through multi-objective optimization and real-time data analysis. This research contributes to improved profitability for farmers by adopting sustainable pricing strategies and agricultural market efficiency.},
  doi       = {10.1109/ICECCC65144.2025.11064235},
