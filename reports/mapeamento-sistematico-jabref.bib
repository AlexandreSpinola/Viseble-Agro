  publisher              = {Frontiers Media S.A.},
  source                 = {Scopus},
  type                   = {Article},
  url                    = {https://www.scopus.com/pages/publications/85128653970?origin=resultslist},
}

@ARTICLE{Zhao2023,
	author = {Zhao, Geya and Xue, Minggao and Cheng, Li},
	title = {A new hybrid model for multi-step WTI futures price forecasting based on self-attention mechanism and spatial–temporal graph neural network},
	year = {2023},
	journal = {Resources Policy},
	volume = {85},
	pages = {},
	doi = {10.1016/j.resourpol.2023.103956},
	url = {https://www.scopus.com/pages/publications/85166251107?origin=resultslist},
	affiliations = {School of Management, Huazhong University of Science and Technology, Hubei, Wuhan, 430074, China},
	abstract = {WTI futures prices are impacted by supply, demand and a variety of financial factors, including U.S. dollar exchange rates, interest rates, market sentiment and related market linkages. The frequent changes in these factors cause WTI futures prices to fluctuate dramatically and complicate the trading decisions of investors and the policy-making of governments; consequently, accurate forecasting of WTI futures prices has become a topic of intense interest in the field of energy research. To thoroughly investigate the impact of various factors on crude oil prices, this paper introduces the self-attention mechanism and the spatial–temporal graph neural network Graph WaveNet (GWNet) to predict crude oil prices. The self-attention mechanism is employed to learn time-varying interactions between variables to tackle a problem where the graph structure is unknown. The graph convolution and the dilated causal convolution in GWNet capture the spatial and temporal dependencies, respectively. The empirical findings demonstrate that the proposed Graph WaveNet with Self-Attention (GWNet-Attn) robustly and significantly outperforms all baseline models in various prediction horizons and that the dollar index (USDX), LIBOR, and VIX have surpassed supply and demand as the most influential predictors of WTI futures prices. © 2023 Elsevier Ltd},
	author_keywords = {Dilated causal convolution; Multi-step forecasting; Self-attention mechanism; Spatial–temporal graph neural network; WTI futures prices},
	keywords = {Commerce; Convolution; Costs; Crude oil; Electronic trading; Financial markets; Forecasting; Graph neural networks; Attention mechanisms; Causal convolutions; Dilated causal convolution; Graph neural networks; Multi-step forecasting; Self-attention mechanism; Spatial temporals; Spatial–temporal graph neural network; Temporal graphs; WTI future price; artificial neural network; commodity price; crude oil; forecasting method; oil supply; prediction; Investments},
	correspondence_address = {L. Cheng; School of Management, Huazhong University of Science and Technology, Wuhan, Hubei, 430074, China; email: licheng_hdb@hust.edu.cn},
	publisher = {Elsevier Ltd},
	issn = {03014207},
	language = {English},
