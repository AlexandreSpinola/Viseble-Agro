  abbrev_source_title    = {Int. Conf. Autom., Comput. Renew. Syst., ICACRS - Proc.},
  abstract               = {Agriculture in India faces persistent challenges including unpredictable climate, recurring pest infestations, volatile market prices, and limited access to timely advisory support. This paper presents an integrated AI-driven Smart Farming framework that unifies eight intelligent modules - crop advisory, pest and disease detection, market price forecasting, agricultural chatbot, loan eligibility prediction, irrigation and fertilizer optimization, livestock health monitoring, and yield and insurance estimation - into a single web-based ecosystem. Advanced machine learning models such as Random Forest, CNN, LSTM, and Gradient Boosting are employed, optimized via Grid Search and Cross-Validation. Experimental evaluation across datasets from Punjab, Maharashtra, and Tamil Nadu demonstrates enhanced performance with 94.6% accuracy in crop recommendation, 87.2% F1-score in pest detection, and a 12.3% reduction in yield prediction error compared to existing systems. These results validate the framework's effectiveness in supporting data-driven decision-making, improving resource management, and enhancing financial stability for farmers. © 2025 IEEE.},
  affiliations           = {Karunya Institute of Technology and Sciences, Division of Artificial Intelligence and Machine Learning, Tamil Nadu, Coimbatore, India},
  author_keywords        = {Artificial Intelligence; Crop Recommendation; Irrigation; Livestock Monitoring; Loan Prediction; Market Forecast; Pest Detection; Smart Farming; Yield Estimation},
