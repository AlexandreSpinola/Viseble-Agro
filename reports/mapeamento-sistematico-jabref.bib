@Conference{Manikandan2025,
  author              = {Manikandan, N.K. and Praneeth Reddy, T. Bhuvan and Shankar, K.Jaya and Bavesh Sai, C.Venkata},
  booktitle           = {2025 6th International Conference on Data Intelligence and Cognitive Informatics (ICDICI)},
